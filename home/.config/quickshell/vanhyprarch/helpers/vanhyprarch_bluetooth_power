#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only

set -fu

program_name=${0##*/}
preference_name=bluetooth-power.conf

fail()
{
    printf '%s: %s\n' "$program_name" "$*" >&2
    exit 1
}

prepare_paths()
{
    [ -n "${HOME:-}" ] || fail 'HOME is not set'
    case $HOME in
        /*) ;;
        *) fail 'HOME must be an absolute path' ;;
    esac

    config_home=${XDG_CONFIG_HOME:-$HOME/.config}
    case $config_home in
        /*) ;;
        *) fail 'XDG_CONFIG_HOME must be an absolute path' ;;
    esac

    preference_dir=$config_home/vanhyprarch
    preference_file=$preference_dir/$preference_name
    current_uid=$(id -u) || fail 'could not determine the current user ID'
    umask 077
}

load_preference()
{
    power=unset
    [ -e "$preference_file" ] || [ -L "$preference_file" ] || return 0
    [ -f "$preference_file" ] || fail "$preference_file is not a regular file"
    [ ! -L "$preference_file" ] || fail "$preference_file must not be a symbolic link"

    preference_owner=$(stat -c '%u' -- "$preference_file") ||
        fail "could not inspect $preference_file"
    [ "$preference_owner" = "$current_uid" ] ||
        fail "$preference_file is not owned by the current user"

    seen_version=false
    seen_power=false
    while IFS= read -r preference_line || [ -n "$preference_line" ]; do
        preference_key=${preference_line%%=*}
        preference_value=${preference_line#*=}
        [ "$preference_key" != "$preference_line" ] ||
            fail 'invalid Bluetooth power preference line'
        case $preference_key in
            version)
                [ "$seen_version" = false ] || fail 'duplicate version preference'
                seen_version=true
                [ "$preference_value" = 1 ] || fail 'unsupported preference version'
                ;;
            power)
                [ "$seen_power" = false ] || fail 'duplicate power preference'
                seen_power=true
                case $preference_value in
                    on|off) power=$preference_value ;;
                    *) fail 'invalid Bluetooth power preference' ;;
                esac
                ;;
            *) fail 'unknown Bluetooth power preference key' ;;
        esac
    done < "$preference_file"
    [ "$seen_version" = true ] || fail 'missing version preference'
    [ "$seen_power" = true ] || fail 'missing power preference'
}

ensure_preference_dir()
{
    [ ! -L "$preference_dir" ] ||
        fail "$preference_dir must not be a symbolic link"
    if [ ! -d "$preference_dir" ]; then
        mkdir -m 700 -- "$preference_dir" ||
            fail "could not create $preference_dir"
    fi
    preference_dir_owner=$(stat -c '%u' -- "$preference_dir") ||
        fail "could not inspect $preference_dir"
    [ "$preference_dir_owner" = "$current_uid" ] ||
        fail "$preference_dir is not owned by the current user"
    chmod 700 -- "$preference_dir" || fail "could not secure $preference_dir"
}

write_preference()
{
    next_power=$1
    ensure_preference_dir
    [ ! -L "$preference_file" ] ||
        fail "$preference_file must not be a symbolic link"
    [ ! -e "$preference_file" ] || [ -f "$preference_file" ] ||
        fail "$preference_file is not a regular file"
    if [ -e "$preference_file" ]; then
        preference_owner=$(stat -c '%u' -- "$preference_file") ||
            fail "could not inspect $preference_file"
        [ "$preference_owner" = "$current_uid" ] ||
            fail "$preference_file is not owned by the current user"
    fi

    temporary_file=$(mktemp "$preference_dir/.bluetooth-power.XXXXXX") ||
        fail 'could not create temporary preference file'
    trap 'rm -f -- "$temporary_file"' EXIT HUP INT TERM
    printf 'version=1\npower=%s\n' "$next_power" > "$temporary_file" ||
        fail 'could not write Bluetooth power preference'
    chmod 600 -- "$temporary_file" ||
        fail 'could not secure Bluetooth power preference'
    mv -f -- "$temporary_file" "$preference_file" ||
        fail 'could not replace Bluetooth power preference'
    trap - EXIT HUP INT TERM
    power=$next_power
}

print_status()
{
    printf 'version=1\npower=%s\n' "$power"
}

prepare_paths
case ${1-} in
    status)
        [ "$#" -eq 1 ] || fail 'usage: status'
        load_preference
        print_status
        ;;
    set)
        [ "$#" -eq 2 ] || fail 'usage: set <on|off>'
        case $2 in
            on|off) ;;
            *) fail 'power must be on or off' ;;
        esac
        write_preference "$2"
        print_status
        ;;
    *) fail 'usage: status | set <on|off>' ;;
esac
