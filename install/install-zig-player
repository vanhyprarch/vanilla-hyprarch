#!/bin/sh

set -eu

program_name=${0##*/}
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

fail()
{
    printf '%s: %s\n' "$program_name" "$*" >&2
    exit 1
}

[ -n "${HOME:-}" ] || fail 'HOME is not set'
case $HOME in /*) ;; *) fail 'HOME must be absolute' ;; esac

controller=$HOME/.local/bin/vanhyprarch-screensaver
if [ ! -x "$controller" ]; then
    controller=$script_dir/../bin/vanhyprarch-screensaver
fi
[ -x "$controller" ] || fail 'vanhyprarch-screensaver is unavailable'

printf '%s\n' 'install-zig-player is a compatibility entry point; delegating to the component manager.' >&2
exec "$controller" install
