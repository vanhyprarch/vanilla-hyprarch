#!/bin/sh

set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repository_backend=$script_dir/../../bin/vanhyprarch-dictation

if command -v vanhyprarch-dictation >/dev/null 2>&1; then
    backend=$(command -v vanhyprarch-dictation)
elif [ -x "$repository_backend" ]; then
    backend=$repository_backend
else
    printf '%s\n' 'uninstall: vanhyprarch-dictation manager is unavailable' >&2
    exit 1
fi

exec "$backend" uninstall
