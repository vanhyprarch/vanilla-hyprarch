#!/bin/sh

set -eu

program_name=${0##*/}
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
canonical_metadata=$script_dir/voxtype.conf
canonical_key=$script_dir/voxtype-ci-signing-key.asc
config_template=$script_dir/config.toml
service_template=$script_dir/vanhyprarch-voxtype.service
metadata_file=${VANHYPRARCH_VOXTYPE_METADATA:-$canonical_metadata}
signing_key=${VANHYPRARCH_VOXTYPE_SIGNING_KEY:-$canonical_key}
work_dir=
installation_complete=false
binary_changed=false
had_binary=false
config_created=false
model_downloaded=false

fail()
{
    printf '%s: %s\n' "$program_name" "$*" >&2
    exit 1
}

restore_binary()
{
    [ "$binary_changed" = true ] || return 0
    if [ "$had_binary" = true ]; then
        rollback_file=$target_binary.rollback.$$
        cp -p -- "$work_dir/original-voxtype" "$rollback_file" &&
            mv -f -- "$rollback_file" "$target_binary"
    else
        rm -f -- "$target_binary"
    fi
}

cleanup()
{
    cleanup_status=$?
    trap - 0 HUP INT TERM
    if [ "$installation_complete" != true ]; then
        restore_binary || :
        if [ "$config_created" = true ] &&
            [ -f "$config_path" ] && [ ! -L "$config_path" ] &&
            cmp -s "$config_template" "$config_path"; then
            rm -f -- "$config_path"
        fi
        if [ "$model_downloaded" = true ] &&
            [ -f "$model_path" ] && [ ! -L "$model_path" ]; then
            actual_model_sha=$(sha256sum "$model_path" | awk '{ print $1 }')
            if [ "$actual_model_sha" != "$VANHYPRARCH_VOXTYPE_MODEL_SHA256" ]; then
                rm -f -- "$model_path"
            fi
        fi
    fi
    if [ -n "$work_dir" ] && [ -d "$work_dir" ]; then
        rm -rf -- "$work_dir"
    fi
    exit "$cleanup_status"
}

install_atomically()
{
    source_file=$1
    destination_file=$2
    installed_mode=$3
    destination_dir=${destination_file%/*}
    temporary_file=$(mktemp "$destination_dir/.vanhyprarch-install.XXXXXX") ||
        fail "could not create a staging file for $destination_file"
    install -m "$installed_mode" -- "$source_file" "$temporary_file" ||
        fail "could not stage $destination_file"
    mv -f -- "$temporary_file" "$destination_file" ||
        fail "could not install $destination_file"
}

require_regular_file()
{
    [ -f "$1" ] && [ ! -L "$1" ] || fail "not a regular file: $1"
}

validate_existing_target()
{
    [ ! -e "$1" ] && [ ! -L "$1" ] && return 0
    require_regular_file "$1"
}

[ "$(id -u)" -ne 0 ] || fail 'do not install Voxtype as root'
require_regular_file "$metadata_file"
# shellcheck disable=SC1090
. "$metadata_file"

test_override=false
if [ "$metadata_file" != "$canonical_metadata" ] ||
    [ "$signing_key" != "$canonical_key" ]; then
    [ "${VANHYPRARCH_ALLOW_TEST_OVERRIDES:-}" = 1 ] ||
        fail 'alternate metadata or signing keys are allowed only for isolated tests'
    test_override=true
fi

if [ "$test_override" = false ]; then
    [ "$VANHYPRARCH_VOXTYPE_VERSION" = 1.0.1 ] || fail 'unexpected Voxtype version'
    [ "$VANHYPRARCH_VOXTYPE_ARCHITECTURE" = x86_64 ] || fail 'unexpected architecture'
    [ "$VANHYPRARCH_VOXTYPE_ASSET" = voxtype-1.0.1-linux-x86_64-avx2 ] ||
        fail 'unexpected Voxtype asset'
    [ "$VANHYPRARCH_VOXTYPE_SHA256" = cb3843a894ef47aca230b30bb1c45c2ef8e0d015adf2fa754d60e55123165fd0 ] ||
        fail 'unexpected Voxtype checksum'
    [ "$VANHYPRARCH_VOXTYPE_SIGNING_FINGERPRINT" = 9CCF7915B750CAE8B095ED1AA3FC9F33FD209279 ] ||
        fail 'unexpected signing fingerprint'
    [ "$VANHYPRARCH_VOXTYPE_RELEASE_URL" = https://github.com/peteonrails/voxtype/releases/tag/v1.0.1 ] ||
        fail 'unexpected Voxtype release URL'
    [ "$VANHYPRARCH_VOXTYPE_DOWNLOAD_URL" = https://github.com/peteonrails/voxtype/releases/download/v1.0.1/voxtype-1.0.1-linux-x86_64-avx2 ] ||
        fail 'unexpected Voxtype download URL'
    [ "$VANHYPRARCH_VOXTYPE_SIGNATURE_URL" = https://github.com/peteonrails/voxtype/releases/download/v1.0.1/voxtype-1.0.1-linux-x86_64-avx2.asc ] ||
        fail 'unexpected Voxtype signature URL'
    [ "$VANHYPRARCH_VOXTYPE_MODEL" = small.en ] || fail 'unexpected model'
    [ "$VANHYPRARCH_VOXTYPE_MODEL_FILENAME" = ggml-small.en.bin ] ||
        fail 'unexpected model filename'
    [ "$VANHYPRARCH_VOXTYPE_MODEL_SHA256" = c6138d6d58ecc8322097e0f987c32f1be8bb0a18532a3f88f734d1bbf9c41e5d ] ||
        fail 'unexpected model checksum'
    [ "$VANHYPRARCH_VOXTYPE_MODEL_SIZE" = 487614201 ] ||
        fail 'unexpected model size'
    [ "$VANHYPRARCH_VOXTYPE_MODEL_SOURCE_URL" = https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-small.en.bin ] ||
        fail 'unexpected upstream model source URL'
    [ "$VANHYPRARCH_VOXTYPE_MODEL_PROVENANCE_URL" = https://huggingface.co/ggerganov/whisper.cpp/blob/80da2d8bfee42b0e836fc3a9890373e5defc00a6/ggml-small.en.bin ] ||
        fail 'unexpected pinned model provenance URL'
fi

for metadata_sha in "$VANHYPRARCH_VOXTYPE_SHA256" "$VANHYPRARCH_VOXTYPE_MODEL_SHA256"; do
    case $metadata_sha in *[!0-9a-f]*|'') fail 'invalid checksum metadata' ;; esac
    [ "${#metadata_sha}" -eq 64 ] || fail 'invalid checksum length'
done
case $VANHYPRARCH_VOXTYPE_SIGNING_FINGERPRINT in
    *[!0-9A-F]*|'') fail 'invalid signing fingerprint metadata' ;;
esac
[ "${#VANHYPRARCH_VOXTYPE_SIGNING_FINGERPRINT}" -eq 40 ] ||
    fail 'invalid signing fingerprint length'
case $VANHYPRARCH_VOXTYPE_MODEL_SIZE in
    *[!0-9]*|'') fail 'invalid model size metadata' ;;
esac
case $VANHYPRARCH_VOXTYPE_DOWNLOAD_URL$VANHYPRARCH_VOXTYPE_SIGNATURE_URL in
    *latest*) fail 'floating latest URLs are forbidden' ;;
esac

target_architecture=${VANHYPRARCH_TARGET_ARCHITECTURE:-$(uname -m)}
[ "$target_architecture" = "$VANHYPRARCH_VOXTYPE_ARCHITECTURE" ] ||
    fail "unsupported architecture: $target_architecture"

if [ -n "${VANHYPRARCH_CPU_FLAGS:-}" ]; then
    [ "${VANHYPRARCH_ALLOW_TEST_OVERRIDES:-}" = 1 ] ||
        fail 'CPU flag overrides are allowed only for isolated tests'
    cpu_flags=" $VANHYPRARCH_CPU_FLAGS "
else
    [ -r /proc/cpuinfo ] || fail 'cannot inspect CPU capabilities'
    cpu_flags=" $(awk -F: '/^(flags|Features)[[:space:]]*:/ { print $2; exit }' /proc/cpuinfo) "
fi
for required_flag in avx2 fma bmi1 bmi2 f16c movbe; do
    case $cpu_flags in
        *" $required_flag "*) ;;
        *) fail "CPU does not provide required feature: $required_flag" ;;
    esac
done

[ -n "${HOME:-}" ] || fail 'HOME is not set'
case $HOME in /*) ;; *) fail 'HOME must be absolute' ;; esac
config_home=${XDG_CONFIG_HOME:-$HOME/.config}
data_home=${XDG_DATA_HOME:-$HOME/.local/share}
case $config_home in /*) ;; *) fail 'XDG_CONFIG_HOME must be absolute' ;; esac
case $data_home in /*) ;; *) fail 'XDG_DATA_HOME must be absolute' ;; esac

target_binary=$HOME/.local/bin/voxtype
config_path=$config_home/voxtype/config.toml
model_path=$data_home/voxtype/models/$VANHYPRARCH_VOXTYPE_MODEL_FILENAME
service_path=$config_home/systemd/user/vanhyprarch-voxtype.service
marker_path=$data_home/vanhyprarch/components/dictation

require_regular_file "$signing_key"
require_regular_file "$config_template"
require_regular_file "$service_template"
validate_existing_target "$target_binary"
validate_existing_target "$config_path"
validate_existing_target "$model_path"
validate_existing_target "$service_path"
validate_existing_target "$marker_path"
component_already_installed=false
if [ -e "$marker_path" ]; then
    printf 'vanhyprarch-dictation-v1\n' | cmp -s - "$marker_path" ||
        fail 'existing dictation component marker has unexpected content'
    component_already_installed=true
fi
if [ -e "$config_path" ] && [ "$component_already_installed" = false ]; then
    cmp -s "$config_template" "$config_path" ||
        fail 'existing Voxtype config needs review before first managed installation'
fi

curl_executable=${VANHYPRARCH_CURL_EXECUTABLE:-/usr/bin/curl}
gpg_executable=${VANHYPRARCH_GPG_EXECUTABLE:-/usr/bin/gpg}
wtype_executable=${VANHYPRARCH_WTYPE_EXECUTABLE:-/usr/bin/wtype}
if [ "${VANHYPRARCH_ALLOW_TEST_OVERRIDES:-}" != 1 ]; then
    [ "$curl_executable" = /usr/bin/curl ] || fail 'invalid curl executable override'
    [ "$gpg_executable" = /usr/bin/gpg ] || fail 'invalid gpg executable override'
    [ "$wtype_executable" = /usr/bin/wtype ] || fail 'invalid wtype executable override'
fi
[ -x "$curl_executable" ] || fail 'curl is required'
[ -x "$gpg_executable" ] || fail 'gnupg is an optional dictation dependency'
[ -x "$wtype_executable" ] || fail 'wtype is an optional dictation dependency'

temporary_base=${TMPDIR:-/tmp}
case $temporary_base in /*) ;; *) fail 'TMPDIR must be absolute' ;; esac
[ -d "$temporary_base" ] || fail "$temporary_base is not a directory"
umask 077
work_dir=$(mktemp -d "$temporary_base/vanhyprarch-dictation.XXXXXX") ||
    fail 'could not create private temporary directory'
trap cleanup 0 HUP INT TERM

staged_binary=$work_dir/$VANHYPRARCH_VOXTYPE_ASSET
staged_signature=$staged_binary.asc
if [ -n "${VANHYPRARCH_TEST_BINARY:-}" ] ||
    [ -n "${VANHYPRARCH_TEST_SIGNATURE:-}" ]; then
    [ "${VANHYPRARCH_ALLOW_TEST_OVERRIDES:-}" = 1 ] ||
        fail 'download overrides are allowed only for isolated tests'
    [ -n "${VANHYPRARCH_TEST_BINARY:-}" ] &&
        [ -n "${VANHYPRARCH_TEST_SIGNATURE:-}" ] ||
        fail 'both test download overrides are required'
    cp -- "$VANHYPRARCH_TEST_BINARY" "$staged_binary" || fail 'could not stage test binary'
    cp -- "$VANHYPRARCH_TEST_SIGNATURE" "$staged_signature" || fail 'could not stage test signature'
else
    "$curl_executable" --fail --location --proto '=https' --tlsv1.2 \
        --output "$staged_binary" "$VANHYPRARCH_VOXTYPE_DOWNLOAD_URL" ||
        fail 'could not download the pinned Voxtype binary'
    "$curl_executable" --fail --location --proto '=https' --tlsv1.2 \
        --output "$staged_signature" "$VANHYPRARCH_VOXTYPE_SIGNATURE_URL" ||
        fail 'could not download the pinned Voxtype signature'
fi

actual_binary_sha=$(sha256sum "$staged_binary" | awk '{ print $1 }')
[ "$actual_binary_sha" = "$VANHYPRARCH_VOXTYPE_SHA256" ] ||
    fail 'Voxtype binary checksum verification failed'

gpg_home=$work_dir/gnupg
mkdir -m 0700 -- "$gpg_home" || fail 'could not create the dedicated GPG home'
key_listing=$work_dir/key.listing
"$gpg_executable" --batch --homedir "$gpg_home" --with-colons \
    --import-options show-only --import "$signing_key" > "$key_listing" 2>/dev/null ||
    fail 'could not inspect the vendored signing key'
primary_key_count=$(awk -F: '$1 == "pub" { count++ } END { print count + 0 }' "$key_listing")
[ "$primary_key_count" -eq 1 ] || fail 'the signing key file must contain exactly one primary key'
key_fingerprint=$(awk -F: '$1 == "pub" { want = 1; next } want && $1 == "fpr" { print $10; exit }' "$key_listing")
[ "$key_fingerprint" = "$VANHYPRARCH_VOXTYPE_SIGNING_FINGERPRINT" ] ||
    fail 'vendored signing key fingerprint mismatch'
"$gpg_executable" --batch --homedir "$gpg_home" --import "$signing_key" >/dev/null 2>&1 ||
    fail 'could not import the vendored signing key'
verification_status=$work_dir/signature.status
"$gpg_executable" --batch --homedir "$gpg_home" --status-fd 1 \
    --verify "$staged_signature" "$staged_binary" > "$verification_status" 2>/dev/null ||
    fail 'Voxtype detached-signature verification failed'
awk -v expected="$VANHYPRARCH_VOXTYPE_SIGNING_FINGERPRINT" '
    $1 == "[GNUPG:]" && $2 == "VALIDSIG" && ($3 == expected || $NF == expected) { valid = 1 }
    END { exit valid ? 0 : 1 }
' "$verification_status" || fail 'signature was not made by the expected primary key'

chmod 0700 -- "$staged_binary" || fail 'could not make the verified binary executable'
version_output=$($staged_binary --version 2>&1) || fail 'verified Voxtype binary failed --version'
[ "$version_output" = "voxtype $VANHYPRARCH_VOXTYPE_VERSION" ] ||
    fail "unexpected Voxtype version output: $version_output"

mkdir -p -- "${target_binary%/*}" "${config_path%/*}" \
    "${model_path%/*}" "${service_path%/*}" "${marker_path%/*}" ||
    fail 'could not create dictation installation directories'
if [ -e "$target_binary" ]; then
    cp -p -- "$target_binary" "$work_dir/original-voxtype" ||
        fail 'could not preserve the existing Voxtype binary'
    had_binary=true
fi
install_atomically "$staged_binary" "$target_binary" 0755
binary_changed=true

if [ ! -e "$config_path" ]; then
    install_atomically "$config_template" "$config_path" 0600
    config_created=true
fi

if [ -e "$model_path" ]; then
    actual_model_sha=$(sha256sum "$model_path" | awk '{ print $1 }')
    [ "$actual_model_sha" = "$VANHYPRARCH_VOXTYPE_MODEL_SHA256" ] ||
        fail "existing $model_path does not match the pinned small.en model"
else
    "$target_binary" setup --download --model "$VANHYPRARCH_VOXTYPE_MODEL" \
        --quiet --no-post-install || fail 'Voxtype model setup failed'
    model_downloaded=true
fi

[ -f "$model_path" ] && [ ! -L "$model_path" ] || fail 'model download did not produce a regular file'
actual_model_size=$(wc -c < "$model_path" | tr -d '[:space:]')
actual_model_sha=$(sha256sum "$model_path" | awk '{ print $1 }')
if [ "$actual_model_size" != "$VANHYPRARCH_VOXTYPE_MODEL_SIZE" ] ||
    [ "$actual_model_sha" != "$VANHYPRARCH_VOXTYPE_MODEL_SHA256" ]; then
    if [ "$model_downloaded" = true ]; then
        rm -f -- "$model_path"
    fi
    fail 'small.en model integrity verification failed'
fi

install_atomically "$service_template" "$service_path" 0644
marker_file=$work_dir/dictation-marker
printf 'vanhyprarch-dictation-v1\n' > "$marker_file"
install_atomically "$marker_file" "$marker_path" 0644
installation_complete=true

printf 'installed optional Voxtype %s dictation component\n' "$VANHYPRARCH_VOXTYPE_VERSION"
printf 'binary: %s\nmodel: %s\nservice: %s\n' "$target_binary" "$model_path" "$service_path"
printf 'the service was not started or enabled; reload Hyprland before using F9\n'
