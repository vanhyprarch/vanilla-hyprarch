"""Manage the optional Vanilla HyprArch local-dictation component."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import pwd
import re
import shutil
import stat
import subprocess
import sys
import tempfile
import time
import tomllib
from pathlib import Path
from typing import Any, NoReturn, Sequence


SCHEMA_VERSION = 1
MANAGER_VERSION = 1
COMPONENT_MARKER = b"vanhyprarch-dictation-v1\n"
DEFAULT_MODEL = "small.en"
DEFAULT_LANGUAGE_MODE = "specific"
DEFAULT_LANGUAGES = ["en"]
DEFAULT_ACCELERATION = "cpu"
DEFAULT_MAX_DURATION = 120
ALLOWED_DURATIONS = (30, 60, 120, 300)
DEFAULT_HEALTH_TIMEOUT_SECONDS = 8.0
LANGUAGES = {
    "en": "English",
    "fr": "French",
    "de": "German",
    "it": "Italian",
    "es": "Spanish",
    "pt": "Portuguese",
    "nl": "Dutch",
    "pl": "Polish",
    "zh": "Chinese",
    "ja": "Japanese",
    "ko": "Korean",
    "ru": "Russian",
    "ar": "Arabic",
}
EXPECTED_PROVENANCE_REVISION = "5359861c739e955e79d9a303bcbc70fb988958b1"
EXPECTED_RELEASE = {
    "VANHYPRARCH_VOXTYPE_VERSION": "1.0.1",
    "VANHYPRARCH_VOXTYPE_ARCHITECTURE": "x86_64",
    "VANHYPRARCH_VOXTYPE_ASSET": "voxtype-1.0.1-linux-x86_64-avx2",
    "VANHYPRARCH_VOXTYPE_SHA256": "cb3843a894ef47aca230b30bb1c45c2ef8e0d015adf2fa754d60e55123165fd0",
    "VANHYPRARCH_VOXTYPE_SIGNING_FINGERPRINT": "9CCF7915B750CAE8B095ED1AA3FC9F33FD209279",
    "VANHYPRARCH_VOXTYPE_RELEASE_URL": "https://github.com/peteonrails/voxtype/releases/tag/v1.0.1",
    "VANHYPRARCH_VOXTYPE_DOWNLOAD_URL": "https://github.com/peteonrails/voxtype/releases/download/v1.0.1/voxtype-1.0.1-linux-x86_64-avx2",
    "VANHYPRARCH_VOXTYPE_SIGNATURE_URL": "https://github.com/peteonrails/voxtype/releases/download/v1.0.1/voxtype-1.0.1-linux-x86_64-avx2.asc",
}


class ManagerError(RuntimeError):
    pass


def fail(message: str) -> NoReturn:
    raise ManagerError(message)


def progress(message: str) -> None:
    print(message, flush=True)


def approximate_size(byte_count: int) -> str:
    mebibytes = byte_count / (1024 * 1024)
    if mebibytes >= 1024:
        return f"{mebibytes / 1024:.1f} GiB"
    return f"{round(mebibytes)} MiB"


def health_timeout_seconds() -> float:
    override = os.environ.get("VANHYPRARCH_HEALTH_TIMEOUT_SECONDS")
    if override is None:
        return DEFAULT_HEALTH_TIMEOUT_SECONDS
    if not test_overrides_allowed():
        fail("health-timeout overrides are allowed only for isolated tests")
    try:
        value = float(override)
    except ValueError:
        fail("invalid health-timeout test override")
    if value < 0.1 or value > DEFAULT_HEALTH_TIMEOUT_SECONDS:
        fail("health-timeout test override is outside the allowed range")
    return value


def test_overrides_allowed() -> bool:
    return os.environ.get("VANHYPRARCH_ALLOW_TEST_OVERRIDES") == "1"


def absolute_xdg(name: str, fallback: Path) -> Path:
    value = os.environ.get(name)
    path = Path(value) if value else fallback
    if not path.is_absolute():
        fail(f"{name} must be absolute")
    return path


def paths() -> dict[str, Path]:
    home_value = os.environ.get("HOME")
    if not home_value or not Path(home_value).is_absolute():
        fail("HOME must be set to an absolute path")
    home = Path(home_value)
    config_home = absolute_xdg("XDG_CONFIG_HOME", home / ".config")
    data_home = absolute_xdg("XDG_DATA_HOME", home / ".local/share")
    runtime_value = os.environ.get("XDG_RUNTIME_DIR")
    runtime_home = Path(runtime_value) if runtime_value else None
    if runtime_home is not None and not runtime_home.is_absolute():
        fail("XDG_RUNTIME_DIR must be absolute")
    return {
        "home": home,
        "config_home": config_home,
        "data_home": data_home,
        "binary": home / ".local/bin/voxtype",
        "config_dir": config_home / "voxtype",
        "config": config_home / "voxtype/config.toml",
        "service": config_home / "systemd/user/vanhyprarch-voxtype.service",
        "marker": data_home / "vanhyprarch/components/dictation",
        "data_dir": data_home / "voxtype",
        "models": data_home / "voxtype/models",
        "managed_data": data_home / "vanhyprarch/dictation",
        "runtime_home": runtime_home,
        "runtime_dir": runtime_home / "voxtype" if runtime_home is not None else None,
    }


def resource_dir() -> Path:
    override = os.environ.get("VANHYPRARCH_DICTATION_RESOURCE_DIR")
    if override:
        if not test_overrides_allowed():
            fail("resource overrides are allowed only for isolated tests")
        candidate = Path(override)
    else:
        candidate = paths()["managed_data"]
        if not (candidate / "models.toml").is_file():
            source_candidate = Path(__file__).resolve().parent.parent / "install/dictation"
            if (source_candidate / "models.toml").is_file():
                candidate = source_candidate
    if not candidate.is_absolute() or not candidate.is_dir():
        fail("dictation management resources are unavailable")
    return candidate


def read_metadata(resources: Path) -> dict[str, str]:
    override = os.environ.get("VANHYPRARCH_VOXTYPE_METADATA")
    path = Path(override) if override else resources / "voxtype.conf"
    if override and not test_overrides_allowed():
        fail("metadata overrides are allowed only for isolated tests")
    require_regular(path, "release metadata")
    result: dict[str, str] = {}
    for number, raw in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
        if not raw or raw.startswith("#"):
            continue
        if not re.fullmatch(r"[A-Z0-9_]+=[^\s]+", raw):
            fail(f"invalid release metadata at line {number}")
        key, value = raw.split("=", 1)
        if key in result:
            fail(f"duplicate release metadata key: {key}")
        result[key] = value
    for key in EXPECTED_RELEASE:
        if key not in result:
            fail(f"missing release metadata: {key}")
    if not test_overrides_allowed():
        for key, expected in EXPECTED_RELEASE.items():
            if result[key] != expected:
                fail(f"unexpected production release metadata: {key}")
    if "latest" in result["VANHYPRARCH_VOXTYPE_DOWNLOAD_URL"].lower():
        fail("floating release URLs are forbidden")
    return result


def load_models(resources: Path) -> tuple[list[dict[str, Any]], dict[str, dict[str, Any]]]:
    manifest_path = resources / "models.toml"
    require_regular(manifest_path, "model manifest")
    try:
        document = tomllib.loads(manifest_path.read_text(encoding="utf-8"))
    except (OSError, tomllib.TOMLDecodeError) as error:
        fail(f"invalid model manifest: {error}")
    if document.get("schema_version") != 1:
        fail("unsupported model manifest schema")
    provenance = document.get("provenance_revision")
    if not test_overrides_allowed() and provenance != EXPECTED_PROVENANCE_REVISION:
        fail("unexpected model provenance revision")
    models = document.get("models")
    if not isinstance(models, list) or not models:
        fail("model manifest is empty")
    required = {"id", "label", "family", "filename", "size", "sha256", "transport_url", "provenance_url"}
    by_id: dict[str, dict[str, Any]] = {}
    for model in models:
        if not isinstance(model, dict) or set(model) != required:
            fail("model manifest record has unexpected fields")
        model_id = model["id"]
        if not isinstance(model_id, str) or model_id in by_id:
            fail("model manifest contains an invalid or duplicate id")
        if not isinstance(model["label"], str) or not model["label"]:
            fail(f"invalid model label for {model_id}")
        if model["family"] not in ("english", "multilingual"):
            fail(f"invalid model family for {model_id}")
        filename = model["filename"]
        if not isinstance(filename, str) or not re.fullmatch(r"ggml-[A-Za-z0-9.-]+\.bin", filename):
            fail(f"invalid model filename for {model_id}")
        if not isinstance(model["size"], int) or model["size"] <= 0:
            fail(f"invalid model size for {model_id}")
        if not re.fullmatch(r"[0-9a-f]{64}", str(model["sha256"])):
            fail(f"invalid model digest for {model_id}")
        transport = model["transport_url"]
        if not isinstance(transport, str) or not transport.startswith("https://") or not transport.endswith("/" + filename):
            fail(f"invalid model transport for {model_id}")
        provenance_url = model["provenance_url"]
        if (not isinstance(provenance_url, str)
                or f"/{provenance}/" not in provenance_url
                or not provenance_url.endswith("/" + filename)):
            fail(f"unpinned model provenance for {model_id}")
        by_id[model_id] = model
    expected_ids = {"tiny", "tiny.en", "base", "base.en", "small", "small.en", "medium", "medium.en", "large-v3", "large-v3-turbo"}
    if not test_overrides_allowed() and set(by_id) != expected_ids:
        fail("production model inventory is not the reviewed ten-model set")
    return models, by_id


def require_regular(path: Path, label: str, owner: bool = False) -> None:
    try:
        info = path.lstat()
    except FileNotFoundError:
        fail(f"missing {label}: {path}")
    if not stat.S_ISREG(info.st_mode):
        fail(f"{label} is not a regular file: {path}")
    if owner and info.st_uid != os.getuid():
        fail(f"{label} is not owned by the current user: {path}")


def validate_optional_target(path: Path, label: str, owner: bool = True) -> None:
    if path.exists() or path.is_symlink():
        require_regular(path, label, owner=owner)


def path_present(path: Path) -> bool:
    return path.exists() or path.is_symlink()


def require_owned_directory(path: Path, label: str) -> None:
    try:
        info = path.lstat()
    except FileNotFoundError:
        fail(f"missing {label}: {path}")
    if not stat.S_ISDIR(info.st_mode):
        fail(f"{label} is not a directory: {path}")
    if info.st_uid != os.getuid():
        fail(f"{label} is not owned by the current user: {path}")
    if not os.access(path, os.R_OK | os.W_OK | os.X_OK):
        fail(f"{label} is not safely accessible by the current user: {path}")


def validate_voxtype_tree(root: Path, target: Path, label: str) -> None:
    if not shutil.rmtree.avoids_symlink_attacks:
        fail("safe recursive deletion is unavailable on this platform")
    if not root.is_absolute() or ".." in root.parts or root == root.parent:
        fail(f"unsafe {label} root: {root}")
    expected = root / "voxtype"
    if target != expected or target.parent != root or target.name != "voxtype":
        fail(f"unsafe {label} path: {target}")
    require_owned_directory(root, f"{label} XDG root")
    require_owned_directory(target, label)
    for directory, directories, files in os.walk(target, topdown=True, followlinks=False):
        for name in [*directories, *files]:
            entry = Path(directory) / name
            try:
                info = entry.lstat()
            except FileNotFoundError:
                fail(f"{label} changed during safety validation: {entry}")
            if stat.S_ISLNK(info.st_mode):
                fail(f"{label} contains a symlink: {entry}")
            if info.st_uid != os.getuid():
                fail(f"{label} contains a foreign-owned entry: {entry}")
            if not (stat.S_ISDIR(info.st_mode) or stat.S_ISREG(info.st_mode)):
                fail(f"{label} contains an unsupported entry: {entry}")


def remove_voxtype_tree(root: Path, target: Path, label: str) -> None:
    validate_voxtype_tree(root, target, label)
    shutil.rmtree(target)


def validate_stopped_runtime_tree(root: Path, target: Path) -> None:
    label = "Voxtype runtime directory"
    validate_voxtype_tree(root, target, label)
    if service_state() in ("active", "activating", "deactivating"):
        fail("could not safely remove Voxtype runtime state while the service is running")
    lock = target / "voxtype.lock"
    if not path_present(lock):
        return
    require_regular(lock, "Voxtype runtime lock", owner=True)
    try:
        runtime_pid = int(lock.read_text(encoding="utf-8").strip())
    except (OSError, ValueError):
        fail("Voxtype runtime lock contains an invalid PID")
    if runtime_pid <= 1:
        fail("Voxtype runtime lock contains an unsafe PID")
    try:
        os.kill(runtime_pid, 0)
    except ProcessLookupError:
        return
    except PermissionError:
        fail("Voxtype runtime lock identifies a live inaccessible process")
    fail("Voxtype runtime lock identifies a live process")


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def atomic_copy(source: Path, destination: Path, mode: int) -> None:
    destination.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary_name = tempfile.mkstemp(prefix=".vanhyprarch-install.", dir=destination.parent)
    temporary = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "wb") as output, source.open("rb") as input_stream:
            shutil.copyfileobj(input_stream, output)
            output.flush()
            os.fsync(output.fileno())
        os.chmod(temporary, mode)
        os.replace(temporary, destination)
    finally:
        temporary.unlink(missing_ok=True)


def atomic_bytes(data: bytes, destination: Path, mode: int) -> None:
    destination.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary_name = tempfile.mkstemp(prefix=".vanhyprarch-install.", dir=destination.parent)
    temporary = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "wb") as output:
            output.write(data)
            output.flush()
            os.fsync(output.fileno())
        os.chmod(temporary, mode)
        os.replace(temporary, destination)
    finally:
        temporary.unlink(missing_ok=True)


def executable(env_name: str, default: str) -> str:
    value = os.environ.get(env_name, default)
    if value != default and not test_overrides_allowed():
        fail(f"{env_name} overrides are allowed only for isolated tests")
    if not os.access(value, os.X_OK):
        fail(f"required executable is unavailable: {default}")
    return value


def run(argv: Sequence[str], *, check: bool = True, timeout: float | None = None,
        env: dict[str, str] | None = None) -> subprocess.CompletedProcess[str]:
    try:
        result = subprocess.run(list(argv), text=True, capture_output=True, check=False,
            timeout=timeout, env=env)
    except (OSError, subprocess.TimeoutExpired) as error:
        fail(f"could not run {argv[0]}: {error}")
    if check and result.returncode != 0:
        detail = result.stderr.strip() or result.stdout.strip() or f"status {result.returncode}"
        fail(f"{Path(argv[0]).name} failed: {detail}")
    return result


def cpu_features() -> None:
    architecture_override = os.environ.get("VANHYPRARCH_TARGET_ARCHITECTURE")
    if architecture_override is not None and not test_overrides_allowed():
        fail("architecture overrides are allowed only for isolated tests")
    architecture = architecture_override or os.uname().machine
    if architecture != "x86_64":
        fail(f"unsupported architecture: {architecture}")
    override = os.environ.get("VANHYPRARCH_CPU_FLAGS")
    if override is not None:
        if not test_overrides_allowed():
            fail("CPU feature overrides are allowed only for isolated tests")
        flags = set(override.split())
    else:
        try:
            cpuinfo = Path("/proc/cpuinfo").read_text(encoding="utf-8")
        except OSError as error:
            fail(f"cannot inspect CPU capabilities: {error}")
        match = re.search(r"^(?:flags|Features)\s*:\s*(.*)$", cpuinfo, re.MULTILINE)
        if not match:
            fail("cannot inspect CPU capabilities")
        flags = set(match.group(1).split())
    for feature in ("avx2", "fma", "bmi1", "bmi2", "f16c", "movbe"):
        if feature not in flags:
            fail(f"CPU does not provide required feature: {feature}")


def marker_state(marker: Path) -> str:
    if not marker.exists() and not marker.is_symlink():
        return "absent"
    try:
        require_regular(marker, "component marker", owner=True)
        return "valid" if marker.read_bytes() == COMPONENT_MARKER else "invalid"
    except ManagerError:
        return "invalid"


def dependency_state() -> list[str]:
    missing: list[str] = []
    checks = (("gnupg", "VANHYPRARCH_GPG_EXECUTABLE", "/usr/bin/gpg"), ("wtype", "VANHYPRARCH_WTYPE_EXECUTABLE", "/usr/bin/wtype"))
    for package, env_name, default in checks:
        candidate = os.environ.get(env_name, default) if test_overrides_allowed() else default
        if not os.access(candidate, os.X_OK):
            missing.append(package)
    return missing


def ensure_dependencies() -> None:
    missing = dependency_state()
    if not missing:
        return
    packages = " ".join(missing)
    print("Missing optional official dependencies: " + ", ".join(missing) + ".")
    if not sys.stdin.isatty():
        fail(f"install them first with: sudo pacman -S --needed {packages}")
    answer = input("Install them from the official Arch repositories now? [y/N] ").strip().lower()
    if answer not in ("y", "yes"):
        fail(f"install them first with: sudo pacman -S --needed {packages}")
    progress("Installing optional official dependencies: " + ", ".join(missing) + "...")
    run(["/usr/bin/sudo", "/usr/bin/pacman", "-S", "--needed", "--", *missing])
    if dependency_state():
        fail("optional dependency installation completed but required executables remain unavailable")


def model_path(model: dict[str, Any], path_map: dict[str, Path]) -> Path:
    return path_map["models"] / str(model["filename"])


def model_integrity(model: dict[str, Any], path_map: dict[str, Path]) -> str:
    target = model_path(model, path_map)
    if not target.exists() and not target.is_symlink():
        return "missing"
    try:
        require_regular(target, "model", owner=True)
        if target.stat().st_size != model["size"]:
            return "invalid"
        return "verified" if sha256_file(target) == model["sha256"] else "invalid"
    except (ManagerError, OSError):
        return "invalid"


def language_from_value(value: Any) -> tuple[str, list[str]]:
    if isinstance(value, str):
        if value == "auto":
            return "automatic", []
        if value in LANGUAGES:
            return "specific", [value]
        fail("Voxtype config contains an unsupported language")
    if isinstance(value, list) and all(isinstance(item, str) for item in value):
        validate_language("selected", value, "multilingual")
        return "selected", list(value)
    fail("Voxtype config contains an invalid language value")


def read_config(path: Path, models: dict[str, dict[str, Any]]) -> dict[str, Any]:
    require_regular(path, "Voxtype config", owner=True)
    try:
        document = tomllib.loads(path.read_text(encoding="utf-8"))
    except (OSError, tomllib.TOMLDecodeError) as error:
        fail(f"could not parse Voxtype config: {error}")
    whisper = document.get("whisper")
    audio = document.get("audio")
    if not isinstance(whisper, dict) or not isinstance(audio, dict):
        fail("Voxtype config is missing required whisper/audio tables")
    model_id = whisper.get("model")
    if model_id not in models:
        fail("Voxtype config selects a model outside the reviewed manifest")
    language_mode, languages = language_from_value(whisper.get("language"))
    validate_language(language_mode, languages, models[model_id]["family"])
    duration = audio.get("max_duration_secs")
    if duration not in ALLOWED_DURATIONS:
        fail("Voxtype config has an unsupported maximum recording duration")
    if whisper.get("translate") is not False:
        fail("Voxtype config must keep Whisper translation disabled")
    return {"model": model_id, "language_mode": language_mode, "languages": languages, "max_duration": duration}


def validate_language(mode: str, languages: Sequence[str], family: str) -> tuple[str, list[str]]:
    values = list(languages)
    if family == "english":
        if mode != "specific" or values != ["en"]:
            fail("English-only models require specific English language")
        return "specific", ["en"]
    if mode == "automatic":
        if values:
            fail("automatic language mode does not accept language arguments")
        return mode, []
    if mode == "specific":
        if len(values) != 1:
            fail("specific language mode requires exactly one language")
    elif mode == "selected":
        if len(values) not in (2, 3):
            fail("selected language mode requires two or three languages")
    else:
        fail("unsupported language mode")
    if any(value == "auto" for value in values):
        fail("auto is not a selectable language code")
    if any(value not in LANGUAGES for value in values):
        fail("unsupported language code")
    if len(set(values)) != len(values):
        fail("duplicate languages are not allowed")
    return mode, values


def service_state() -> str:
    systemctl = (os.environ.get("VANHYPRARCH_SYSTEMCTL_EXECUTABLE", "/usr/bin/systemctl")
        if test_overrides_allowed() else "/usr/bin/systemctl")
    if not os.access(systemctl, os.X_OK):
        return "unavailable"
    result = run([systemctl, "--user", "is-active", "vanhyprarch-voxtype.service"], check=False, timeout=3)
    value = result.stdout.strip()
    return value if value in ("active", "inactive", "failed", "activating", "deactivating") else "unknown"


def catalog_document(models: list[dict[str, Any]]) -> dict[str, Any]:
    return {
        "schema_version": SCHEMA_VERSION,
        "manager_version": MANAGER_VERSION,
        "component": "local-dictation",
        "defaults": {
            "model": DEFAULT_MODEL,
            "language_mode": DEFAULT_LANGUAGE_MODE,
            "languages": DEFAULT_LANGUAGES,
            "acceleration": DEFAULT_ACCELERATION,
            "max_duration": DEFAULT_MAX_DURATION,
        },
        "accelerations": [{"id": "cpu", "label": "CPU"}],
        "durations": [
            {"seconds": 30, "label": "30 seconds"},
            {"seconds": 60, "label": "1 minute"},
            {"seconds": 120, "label": "2 minutes"},
            {"seconds": 300, "label": "5 minutes"},
        ],
        "languages": [{"id": code, "label": label} for code, label in LANGUAGES.items()],
        "models": models,
        "future_capabilities": {"vulkan": "not-implemented"},
    }


def status_document(resources: Path, models: list[dict[str, Any]], by_id: dict[str, dict[str, Any]]) -> dict[str, Any]:
    path_map = paths()
    marker = marker_state(path_map["marker"])
    installed = marker == "valid"
    any_payload = any(path.exists() or path.is_symlink()
        for path in (path_map["binary"], path_map["service"], path_map["marker"],
            path_map["config_dir"], path_map["data_dir"]))
    state = "not-installed"
    errors: list[str] = []
    default_settings = {
        "model": DEFAULT_MODEL,
        "language_mode": DEFAULT_LANGUAGE_MODE,
        "languages": DEFAULT_LANGUAGES,
        "acceleration": DEFAULT_ACCELERATION,
        "max_duration": DEFAULT_MAX_DURATION,
    }
    settings: dict[str, Any] | None = default_settings if not any_payload else None
    binary_digest: str | None = None
    version: str | None = None
    integrity: str | None = model_integrity(by_id[DEFAULT_MODEL], path_map) if not any_payload else None
    if marker == "invalid":
        errors.append("component marker is invalid")
    if installed:
        try:
            require_regular(path_map["binary"], "Voxtype binary", owner=True)
            binary_digest = sha256_file(path_map["binary"])
            metadata = read_metadata(resources)
            if binary_digest != metadata["VANHYPRARCH_VOXTYPE_SHA256"]:
                fail("installed Voxtype binary is not the managed CPU artifact")
            version = metadata["VANHYPRARCH_VOXTYPE_VERSION"]
            require_regular(path_map["service"], "Voxtype service", owner=True)
            if path_map["service"].read_bytes() != (resources / "vanhyprarch-voxtype.service").read_bytes():
                fail("installed Voxtype service differs from the managed unit")
            parsed = read_config(path_map["config"], by_id)
            settings = {**parsed, "acceleration": DEFAULT_ACCELERATION}
            integrity = model_integrity(by_id[parsed["model"]], path_map)
            if integrity != "verified":
                fail("active model is not verified")
            state = "installed"
        except ManagerError as error:
            state = "error"
            errors.append(str(error))
    elif any_payload:
        state = "incomplete"
        if not errors:
            errors.append("managed payload exists without a valid component marker")

    defaults_equal = settings == default_settings if settings is not None else False
    return {
        "schema_version": SCHEMA_VERSION,
        "manager_version": MANAGER_VERSION,
        "component": "local-dictation",
        "state": state,
        "installed": installed,
        "errors": errors,
        "voxtype_version": version,
        "acceleration": settings["acceleration"] if settings is not None else None,
        "binary_sha256": binary_digest,
        "model": settings["model"] if settings is not None else None,
        "model_integrity": integrity,
        "language_mode": settings["language_mode"] if settings is not None else None,
        "languages": settings["languages"] if settings is not None else None,
        "max_duration": settings["max_duration"] if settings is not None else None,
        "service_state": service_state() if installed or any_payload else "absent",
        "missing_dependencies": dependency_state(),
        "marker": marker,
        "matches_defaults": defaults_equal,
    }


def download_and_verify_binary(resources: Path, metadata: dict[str, str], work: Path) -> Path:
    curl = executable("VANHYPRARCH_CURL_EXECUTABLE", "/usr/bin/curl")
    gpg = executable("VANHYPRARCH_GPG_EXECUTABLE", "/usr/bin/gpg")
    key_override = os.environ.get("VANHYPRARCH_VOXTYPE_SIGNING_KEY")
    key = Path(key_override) if key_override else resources / "voxtype-ci-signing-key.asc"
    if key_override and not test_overrides_allowed():
        fail("signing-key overrides are allowed only for isolated tests")
    require_regular(key, "signing key")
    staged = work / metadata["VANHYPRARCH_VOXTYPE_ASSET"]
    signature = work / (staged.name + ".asc")
    test_binary = os.environ.get("VANHYPRARCH_TEST_BINARY")
    test_signature = os.environ.get("VANHYPRARCH_TEST_SIGNATURE")
    if test_binary or test_signature:
        if not test_overrides_allowed() or not test_binary or not test_signature:
            fail("both test payload overrides are required")
        shutil.copyfile(test_binary, staged)
        shutil.copyfile(test_signature, signature)
    else:
        progress("Downloading verified Voxtype 1.0.1 CPU component...")
        run([curl, "--fail", "--location", "--proto", "=https", "--tlsv1.2", "--output", str(staged), metadata["VANHYPRARCH_VOXTYPE_DOWNLOAD_URL"]])
        run([curl, "--fail", "--location", "--proto", "=https", "--tlsv1.2", "--output", str(signature), metadata["VANHYPRARCH_VOXTYPE_SIGNATURE_URL"]])
    progress("Verifying Voxtype release integrity...")
    if sha256_file(staged) != metadata["VANHYPRARCH_VOXTYPE_SHA256"]:
        fail("Voxtype binary checksum verification failed")

    gpg_home = work / "gnupg"
    gpg_home.mkdir(mode=0o700)
    listing = run([gpg, "--batch", "--homedir", str(gpg_home), "--with-colons", "--import-options", "show-only", "--import", str(key)]).stdout
    primary_fingerprints: list[str] = []
    awaiting = False
    for line in listing.splitlines():
        fields = line.split(":")
        if fields[0] == "pub":
            awaiting = True
        elif awaiting and fields[0] == "fpr":
            primary_fingerprints.append(fields[9])
            awaiting = False
    if primary_fingerprints != [metadata["VANHYPRARCH_VOXTYPE_SIGNING_FINGERPRINT"]]:
        fail("vendored signing key fingerprint mismatch")
    run([gpg, "--batch", "--homedir", str(gpg_home), "--import", str(key)])
    verified = run([gpg, "--batch", "--homedir", str(gpg_home), "--status-fd", "1", "--verify", str(signature), str(staged)]).stdout
    expected = metadata["VANHYPRARCH_VOXTYPE_SIGNING_FINGERPRINT"]
    valid = False
    for line in verified.splitlines():
        fields = line.split()
        if len(fields) >= 3 and fields[0:2] == ["[GNUPG:]", "VALIDSIG"] and (fields[2] == expected or fields[-1] == expected):
            valid = True
    if not valid:
        fail("signature was not made by the expected primary key")
    os.chmod(staged, 0o700)
    version = run([str(staged), "--version"]).stdout.strip()
    if version != f"voxtype {metadata['VANHYPRARCH_VOXTYPE_VERSION']}":
        fail(f"unexpected Voxtype version output: {version}")
    return staged


def ensure_model(binary: Path, model: dict[str, Any], path_map: dict[str, Path]) -> bool:
    target = model_path(model, path_map)
    existed = target.exists() or target.is_symlink()
    if existed:
        integrity = model_integrity(model, path_map)
        if integrity != "verified":
            fail(f"pre-existing model is invalid; explicit repair is required: {target}")
        progress(f"Reusing verified model {model['label']}.")
        return False
    path_map["models"].mkdir(parents=True, exist_ok=True)
    progress(f"Downloading model {model['label']} (approximately {approximate_size(model['size'])})...")
    # Stable Voxtype 1.0.1's setup path always creates Config::default_path()
    # when it is absent, even when a global --config path is supplied. Isolate
    # that setup-only side effect while retaining the caller's XDG_DATA_HOME so
    # the model lands in the reviewed final data path.
    with tempfile.TemporaryDirectory(prefix="vanhyprarch-voxtype-config.") as isolated:
        setup_environment = os.environ.copy()
        setup_environment["XDG_CONFIG_HOME"] = isolated
        result = run([str(binary), "setup", "--download", "--model",
            str(model["id"]), "--quiet", "--no-post-install"], check=False,
            env=setup_environment)
    if result.returncode != 0:
        fail(f"Voxtype model download failed: {result.stderr.strip() or result.stdout.strip() or result.returncode}")
    progress("Verifying model integrity...")
    if model_integrity(model, path_map) != "verified":
        target.unlink(missing_ok=True)
        fail(f"downloaded model failed independent integrity verification: {model['id']}")
    return True


def command_install(resources: Path, by_id: dict[str, dict[str, Any]]) -> None:
    if os.geteuid() == 0:
        fail("do not install Voxtype as root")
    cpu_features()
    metadata = read_metadata(resources)
    path_map = paths()
    progress("Preparing Local Dictation installation...")
    ensure_dependencies()
    for key, label in (("binary", "Voxtype binary"), ("config", "Voxtype config"), ("service", "Voxtype service"), ("marker", "component marker")):
        validate_optional_target(path_map[key], label)
    marker = marker_state(path_map["marker"])
    if marker == "invalid":
        fail("existing component marker is invalid")
    config_template = resources / "config.toml"
    service_template = resources / "vanhyprarch-voxtype.service"
    require_regular(config_template, "config template")
    require_regular(service_template, "service template")
    config_existed = path_map["config"].exists()
    config_dir_existed = path_present(path_map["config_dir"])
    data_dir_existed = path_present(path_map["data_dir"])
    if config_dir_existed:
        validate_voxtype_tree(path_map["config_home"], path_map["config_dir"],
            "Voxtype configuration directory")
    if data_dir_existed:
        validate_voxtype_tree(path_map["data_home"], path_map["data_dir"],
            "Voxtype data directory")
    runtime_dir = path_map["runtime_dir"]
    runtime_dir_existed = (path_present(runtime_dir) if runtime_dir is not None else False)
    if config_existed and marker != "valid" and path_map["config"].read_bytes() != config_template.read_bytes():
        fail("existing Voxtype config needs review before first managed installation")

    if marker == "valid":
        managed_cpu_digest(path_map["binary"], resources)
        require_regular(path_map["service"], "Voxtype service", owner=True)
        if path_map["service"].read_bytes() != service_template.read_bytes():
            fail("installed Voxtype service differs from the managed unit")
        existing_settings = read_config(path_map["config"], by_id)
        install_model = by_id[existing_settings["model"]]
    else:
        install_model = by_id[DEFAULT_MODEL]

    old_binary = path_map["binary"].read_bytes() if path_map["binary"].exists() else None
    old_binary_mode = stat.S_IMODE(path_map["binary"].stat().st_mode) if old_binary is not None else 0o755
    old_service = path_map["service"].read_bytes() if path_map["service"].exists() else None
    old_service_mode = (stat.S_IMODE(path_map["service"].stat().st_mode)
        if old_service is not None else 0o644)
    old_marker = path_map["marker"].read_bytes() if marker == "valid" else None
    old_marker_mode = (stat.S_IMODE(path_map["marker"].stat().st_mode)
        if old_marker is not None else 0o644)
    config_created = False
    model_downloaded = False
    runtime_published = False
    was_active = service_state() == "active"
    with tempfile.TemporaryDirectory(prefix="vanhyprarch-dictation.") as temporary:
        work = Path(temporary)
        try:
            staged = download_and_verify_binary(resources, metadata, work)
            model_downloaded = ensure_model(staged, install_model, path_map)
            if was_active:
                systemctl_action("stop")
            atomic_copy(staged, path_map["binary"], 0o755)
            if not config_existed:
                if path_map["config"].exists() or path_map["config"].is_symlink():
                    fail("live Voxtype config changed during isolated model staging")
                atomic_copy(config_template, path_map["config"], 0o600)
                config_created = True
            progress("Installing Local Dictation integration...")
            atomic_copy(service_template, path_map["service"], 0o644)
            runtime_published = True
            systemctl = executable("VANHYPRARCH_SYSTEMCTL_EXECUTABLE", "/usr/bin/systemctl")
            run([systemctl, "--user", "daemon-reload"])
            progress("Starting Local Dictation service...")
            systemctl_action("start")
            progress("Validating Local Dictation...")
            expected_digest = metadata["VANHYPRARCH_VOXTYPE_SHA256"]
            if not daemon_healthy(path_map["binary"], install_model["id"], expected_digest,
                    timeout_seconds=health_timeout_seconds()):
                fail("Voxtype service did not become healthy after installation")
            atomic_bytes(COMPONENT_MARKER, path_map["marker"], 0o644)
        except Exception as error:
            rollback_error: str | None = None
            if runtime_published:
                stopped = systemctl_action("stop", check=False)
                if stopped.returncode != 0:
                    rollback_error = "could not stop the candidate service safely"
            try:
                if rollback_error is not None:
                    fail(rollback_error)
                new_data_tree = (not data_dir_existed
                    and path_present(path_map["data_dir"]))
                new_config_tree = (not config_dir_existed
                    and path_present(path_map["config_dir"]))
                new_runtime_tree = (runtime_dir is not None and not runtime_dir_existed
                    and path_present(runtime_dir))
                # Validate every new tree before removing any of them. This
                # prevents a malicious or raced symlink/special file in one
                # tree from causing a partial recursive cleanup of the others.
                if new_data_tree:
                    validate_voxtype_tree(path_map["data_home"], path_map["data_dir"],
                        "Voxtype data directory")
                if new_config_tree:
                    validate_voxtype_tree(path_map["config_home"], path_map["config_dir"],
                        "Voxtype configuration directory")
                if new_runtime_tree:
                    validate_stopped_runtime_tree(path_map["runtime_home"], runtime_dir)
                if old_marker is None:
                    path_map["marker"].unlink(missing_ok=True)
                else:
                    atomic_bytes(old_marker, path_map["marker"], old_marker_mode)
                if old_binary is None:
                    path_map["binary"].unlink(missing_ok=True)
                else:
                    atomic_bytes(old_binary, path_map["binary"], old_binary_mode)
                if old_service is None:
                    path_map["service"].unlink(missing_ok=True)
                else:
                    atomic_bytes(old_service, path_map["service"], old_service_mode)
                if (config_created and config_dir_existed and path_map["config"].exists()
                        and path_map["config"].read_bytes() == config_template.read_bytes()):
                    path_map["config"].unlink()
                if new_data_tree:
                    shutil.rmtree(path_map["data_dir"])
                elif model_downloaded:
                    model_path(install_model, path_map).unlink(missing_ok=True)
                if new_config_tree:
                    shutil.rmtree(path_map["config_dir"])
                if new_runtime_tree:
                    shutil.rmtree(runtime_dir)
                systemctl = executable("VANHYPRARCH_SYSTEMCTL_EXECUTABLE", "/usr/bin/systemctl")
                run([systemctl, "--user", "daemon-reload"])
                if was_active:
                    restored = systemctl_action("start", check=False)
                    if restored.returncode != 0 or service_state() != "active":
                        fail("could not restore the previous active service state")
            except (ManagerError, OSError) as restore_error:
                rollback_error = str(restore_error)
            if rollback_error is not None:
                fail(f"install failed ({error}); rollback also failed: {rollback_error}")
            raise
    progress("Installed Local Dictation successfully.")
    progress("Local Dictation service is running and healthy.")


def replace_constrained_language(path: Path, languages: Sequence[str]) -> None:
    content = path.read_text(encoding="utf-8")
    lines = content.splitlines(keepends=True)
    section = ""
    whisper_headers = 0
    language_lines: list[int] = []
    for index, line in enumerate(lines):
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        header = re.fullmatch(r"\[([^\]]+)\](?:\s*#.*)?", stripped)
        if header:
            section = header.group(1).strip()
            if section == "whisper":
                whisper_headers += 1
            continue
        if re.match(r"^\s*whisper\s*\.", line):
            fail("constrained language editing does not support dotted whisper keys")
        if section == "whisper" and re.match(r"^\s*language\s*=", line):
            language_lines.append(index)
    if whisper_headers != 1 or len(language_lines) != 1:
        fail("constrained language editing requires one conventional [whisper] table and language key")
    index = language_lines[0]
    newline = "\n" if lines[index].endswith("\n") else ""
    indentation = re.match(r"^\s*", lines[index]).group(0)
    encoded = ", ".join(json.dumps(value) for value in languages)
    lines[index] = f"{indentation}language = [{encoded}]{newline}"
    path.write_text("".join(lines), encoding="utf-8")


def voxtype_set(binary: Path, candidate: Path, key: str, value: str) -> None:
    run([str(binary), "--config", str(candidate), "config", "set", key, value])


def validate_candidate(binary: Path, candidate: Path, requested: dict[str, Any], models: dict[str, dict[str, Any]]) -> None:
    parsed = read_config(candidate, models)
    if parsed != requested:
        fail("candidate config did not resolve to the requested settings")
    schema = run([str(binary), "--config", str(candidate), "config", "schema", "--json"])
    try:
        document = json.loads(schema.stdout)
        entries = {entry["key"]: entry for entry in document["keys"]}
    except (KeyError, TypeError, json.JSONDecodeError) as error:
        fail(f"Voxtype returned invalid config validation data: {error}")
    expected = {
        "whisper.model": requested["model"],
        "audio.max_duration_secs": requested["max_duration"],
        "whisper.translate": False,
    }
    for key, value in expected.items():
        if key not in entries or entries[key].get("value") != value:
            fail(f"Voxtype did not read back requested value for {key}")
    language_value = entries.get("whisper.language", {}).get("value")
    wanted_language = "auto" if requested["language_mode"] == "automatic" else ",".join(requested["languages"])
    if language_value != wanted_language:
        fail("Voxtype did not read back the requested language")


def systemctl_action(action: str, check: bool = True) -> subprocess.CompletedProcess[str]:
    systemctl = executable("VANHYPRARCH_SYSTEMCTL_EXECUTABLE", "/usr/bin/systemctl")
    return run([systemctl, "--user", action, "vanhyprarch-voxtype.service"], check=check)


def managed_cpu_digest(binary: Path, resources: Path) -> str:
    require_regular(binary, "Voxtype binary", owner=True)
    expected = read_metadata(resources)["VANHYPRARCH_VOXTYPE_SHA256"]
    if sha256_file(binary) != expected:
        fail("installed Voxtype binary is not the managed CPU artifact")
    return expected


def valid_daemon_status(document: Any, expected_model: str) -> bool:
    if not isinstance(document, dict) or document.get("model") != expected_model:
        return False
    error = document.get("error")
    if error not in (None, False, ""):
        return False
    states: list[str] = []
    for key in ("alt", "class", "state"):
        value = document.get(key)
        if isinstance(value, str):
            states.append(value.lower())
        elif isinstance(value, list):
            states.extend(item.lower() for item in value if isinstance(item, str))
    if any(state in {"error", "failed", "stopped"} for state in states):
        return False
    return any(state in {"idle", "recording", "transcribing"} for state in states)


def daemon_healthy(binary: Path, expected_model: str, expected_digest: str,
        *, timeout_seconds: float = 8.0, retry_interval: float = 0.2) -> bool:
    try:
        require_regular(binary, "Voxtype binary", owner=True)
        if sha256_file(binary) != expected_digest:
            return False
    except (ManagerError, OSError):
        return False
    deadline = time.monotonic() + timeout_seconds
    while time.monotonic() < deadline:
        if service_state() == "active":
            status = run([str(binary), "status", "--format", "json", "--extended"], check=False, timeout=3)
            if status.returncode == 0:
                try:
                    document = json.loads(status.stdout)
                except json.JSONDecodeError:
                    document = None
                if valid_daemon_status(document, expected_model):
                    try:
                        return sha256_file(binary) == expected_digest
                    except OSError:
                        return False
        time.sleep(retry_interval)
    return False


def command_apply(args: argparse.Namespace, resources: Path, by_id: dict[str, dict[str, Any]]) -> None:
    if os.geteuid() == 0:
        fail("do not manage user dictation as root")
    if args.acceleration != "cpu":
        fail("only CPU acceleration is supported in this milestone")
    if args.model not in by_id:
        fail("unsupported model")
    if args.max_duration not in ALLOWED_DURATIONS:
        fail("unsupported maximum recording duration")
    model = by_id[args.model]
    mode, languages = validate_language(args.language_mode, args.language, model["family"])
    requested = {"model": args.model, "language_mode": mode, "languages": languages, "max_duration": args.max_duration}
    path_map = paths()
    if marker_state(path_map["marker"]) != "valid":
        fail("dictation component is not installed")
    progress("Preparing Local Dictation update...")
    expected_digest = managed_cpu_digest(path_map["binary"], resources)
    require_regular(path_map["config"], "Voxtype config", owner=True)
    ensure_model(path_map["binary"], model, path_map)
    current = read_config(path_map["config"], by_id)
    if current == requested:
        print("Dictation settings are already applied; service was not restarted.")
        return

    config_dir = path_map["config"].parent
    descriptor, candidate_name = tempfile.mkstemp(prefix=".vanhyprarch-config-candidate.", dir=config_dir)
    os.close(descriptor)
    candidate = Path(candidate_name)
    descriptor, rollback_name = tempfile.mkstemp(prefix=".vanhyprarch-config-rollback.", dir=config_dir)
    os.close(descriptor)
    rollback = Path(rollback_name)
    published = False
    was_active = service_state() == "active"
    try:
        progress("Preparing configuration...")
        shutil.copy2(path_map["config"], candidate)
        shutil.copy2(path_map["config"], rollback)
        voxtype_set(path_map["binary"], candidate, "whisper.model", args.model)
        voxtype_set(path_map["binary"], candidate, "audio.max_duration_secs", str(args.max_duration))
        voxtype_set(path_map["binary"], candidate, "whisper.translate", "false")
        if mode == "automatic":
            voxtype_set(path_map["binary"], candidate, "whisper.language", "auto")
        elif mode == "specific":
            voxtype_set(path_map["binary"], candidate, "whisper.language", languages[0])
        else:
            voxtype_set(path_map["binary"], candidate, "whisper.language", "en")
            replace_constrained_language(candidate, languages)
        os.chmod(candidate, stat.S_IMODE(path_map["config"].stat().st_mode))
        validate_candidate(path_map["binary"], candidate, requested, by_id)
        progress("Restarting Local Dictation service...")
        systemctl_action("stop")
        os.replace(candidate, path_map["config"])
        published = True
        systemctl_action("start")
        progress("Validating Local Dictation...")
        if not daemon_healthy(path_map["binary"], args.model, expected_digest,
                timeout_seconds=health_timeout_seconds()):
            fail("Voxtype service did not become healthy with the requested settings")
    except Exception as error:
        rollback_error: str | None = None
        if published:
            systemctl_action("stop", check=False)
            try:
                os.replace(rollback, path_map["config"])
                published = False
            except OSError as restore_error:
                rollback_error = f"could not restore the previous config: {restore_error}"
        if rollback_error is None and was_active and service_state() != "active":
            restored = systemctl_action("start", check=False)
            if restored.returncode != 0 or service_state() != "active":
                rollback_error = "could not restore the previous active service state"
        if rollback_error is not None:
            fail(f"apply failed ({error}); rollback also failed: {rollback_error}")
        raise
    finally:
        candidate.unlink(missing_ok=True)
        rollback.unlink(missing_ok=True)
    progress("Applied dictation settings successfully.")


def command_uninstall(resources: Path) -> None:
    if os.geteuid() == 0:
        fail("do not uninstall user dictation as root")
    path_map = paths()
    metadata = read_metadata(resources)
    service_template = resources / "vanhyprarch-voxtype.service"
    if marker_state(path_map["marker"]) != "valid":
        fail("component marker is not a valid managed installation")
    require_regular(path_map["binary"], "Voxtype binary", owner=True)
    if sha256_file(path_map["binary"]) != metadata["VANHYPRARCH_VOXTYPE_SHA256"]:
        fail("installed Voxtype binary is not the managed CPU artifact")
    require_regular(path_map["service"], "Voxtype service", owner=True)
    if path_map["service"].read_bytes() != service_template.read_bytes():
        fail("installed Voxtype service differs from the managed unit")
    validate_voxtype_tree(path_map["config_home"], path_map["config_dir"],
        "Voxtype configuration directory")
    validate_voxtype_tree(path_map["data_home"], path_map["data_dir"],
        "Voxtype data directory")
    progress("Preparing Local Dictation uninstall...")
    progress("Stopping Local Dictation service...")
    systemctl_action("stop")
    validate_voxtype_tree(path_map["config_home"], path_map["config_dir"],
        "Voxtype configuration directory")
    validate_voxtype_tree(path_map["data_home"], path_map["data_dir"],
        "Voxtype data directory")
    progress("Removing Local Dictation and all Voxtype data...")
    path_map["marker"].unlink(missing_ok=True)
    path_map["service"].unlink(missing_ok=True)
    path_map["binary"].unlink(missing_ok=True)
    remove_voxtype_tree(path_map["config_home"], path_map["config_dir"],
        "Voxtype configuration directory")
    remove_voxtype_tree(path_map["data_home"], path_map["data_dir"],
        "Voxtype data directory")
    systemctl = executable("VANHYPRARCH_SYSTEMCTL_EXECUTABLE", "/usr/bin/systemctl")
    reload_result = run([systemctl, "--user", "daemon-reload"], check=False)
    if reload_result.returncode != 0:
        print("warning: managed files were removed, but the user manager needs a daemon-reload",
            file=sys.stderr)
    remaining = [path for path in (path_map["binary"], path_map["service"],
        path_map["marker"], path_map["config_dir"], path_map["data_dir"])
        if path.exists() or path.is_symlink()]
    if remaining:
        fail("Local Dictation removal left component payload behind")
    status = status_document(resources, *load_models(resources))
    if status["state"] != "not-installed" or status["installed"] or status["marker"] != "absent":
        fail("Local Dictation payload removal did not produce a clean not-installed state")
    progress("Uninstalled Local Dictation and removed all Voxtype data successfully.")
    print("The Vanilla component manager remains available for reinstalling later.")


def command_remove_model(model_id: str, by_id: dict[str, dict[str, Any]]) -> None:
    if os.geteuid() == 0:
        fail("do not remove user models as root")
    if model_id not in by_id:
        fail("unsupported model")
    path_map = paths()
    if path_map["config"].exists():
        active = read_config(path_map["config"], by_id)["model"]
        if active == model_id:
            fail("refusing to remove the active model")
    target = model_path(by_id[model_id], path_map)
    if not target.exists() and not target.is_symlink():
        print(f"Model {model_id} is not downloaded.")
        return
    require_regular(target, "model", owner=True)
    progress(f"Removing model {by_id[model_id]['label']}...")
    target.unlink()
    progress(f"Removed model {by_id[model_id]['label']}.")


def parser() -> argparse.ArgumentParser:
    root = argparse.ArgumentParser(prog="vanhyprarch-dictation")
    commands = root.add_subparsers(dest="command", required=True)
    status = commands.add_parser("status")
    status.add_argument("--json", action="store_true", required=True)
    catalog = commands.add_parser("catalog")
    catalog.add_argument("--json", action="store_true", required=True)
    commands.add_parser("install")
    apply = commands.add_parser("apply")
    apply.add_argument("--model", required=True)
    apply.add_argument("--language-mode", required=True, choices=("specific", "automatic", "selected"))
    apply.add_argument("--language", action="append", default=[])
    apply.add_argument("--acceleration", required=True, choices=("cpu",))
    apply.add_argument("--max-duration", required=True, type=int)
    commands.add_parser("uninstall")
    remove = commands.add_parser("remove-model")
    remove.add_argument("model")
    return root


def main(argv: Sequence[str]) -> int:
    try:
        arguments = parser().parse_args(argv[1:])
        resources = resource_dir()
        models, by_id = load_models(resources)
        if arguments.command == "status":
            print(json.dumps(status_document(resources, models, by_id), sort_keys=True, separators=(",", ":")))
        elif arguments.command == "catalog":
            print(json.dumps(catalog_document(models), sort_keys=True, separators=(",", ":")))
        elif arguments.command == "install":
            command_install(resources, by_id)
        elif arguments.command == "apply":
            command_apply(arguments, resources, by_id)
        elif arguments.command == "uninstall":
            command_uninstall(resources)
        elif arguments.command == "remove-model":
            command_remove_model(arguments.model, by_id)
        return 0
    except (ManagerError, OSError) as error:
        print(f"vanhyprarch-dictation: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
