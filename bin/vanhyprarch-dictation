EXPECTED_SIGNING_FINGERPRINT = "9CCF7915B750CAE8B095ED1AA3FC9F33FD209279"
SUPPORTED_GPU_VENDORS = {
    "0x1002": {"vendor": "amd", "package": "vulkan-radeon",
        "icd_manifest": "radeon_icd.json", "icd_libraries": ("libvulkan_radeon",),
