#!/usr/bin/python
# SPDX-License-Identifier: GPL-2.0-only

"""Own hyprpolkitagent around Vanilla HyprArch's direct graphical session."""

from __future__ import annotations

import ctypes
import os
import re
import selectors
import stat
import subprocess
import sys
import time
from dataclasses import dataclass
from pathlib import Path
from typing import Callable, Mapping, Sequence


SYSTEMCTL = "/usr/bin/systemctl"
LOGGER = "/usr/bin/logger"
HYPRSHUTDOWN = "/usr/bin/hyprshutdown"
SERVICE = "hyprpolkitagent.service"
LOG_IDENTIFIER = "vanhyprarch-polkit-session"
READINESS_TIMEOUT_MS = 10_000
SIGNATURE_PATTERN = re.compile(r"^[A-Za-z0-9_.-]+$")
IN_ATTRIB = 0x00000004
IN_CREATE = 0x00000100
IN_DELETE = 0x00000200
IN_DELETE_SELF = 0x00000400
IN_MOVE_SELF = 0x00000800
IN_MOVED_TO = 0x00000080
INOTIFY_MASK = (
    IN_ATTRIB | IN_CREATE | IN_DELETE | IN_DELETE_SELF | IN_MOVE_SELF | IN_MOVED_TO
)


@dataclass(frozen=True)
class CommandResult:
    returncode: int
    detail: str = ""


@dataclass(frozen=True)
class SessionIdentity:
    runtime: Path
    signature: str
    wayland_display: str
    display: str
    instance: Path
    compositor_socket: Path
    wayland_socket: Path
    instance_device: int
    instance_inode: int


Runner = Callable[[Sequence[str]], CommandResult | int]
Logger = Callable[[str, str], None]
Waiter = Callable[[SessionIdentity], str]


class SessionUnavailable(RuntimeError):
    pass


def read_session_identity(
    environment: Mapping[str, str] | None = None,
) -> SessionIdentity:
    values = os.environ if environment is None else environment
    runtime_text = values.get("XDG_RUNTIME_DIR", "")
    signature = values.get("HYPRLAND_INSTANCE_SIGNATURE", "")
    wayland_display = values.get("WAYLAND_DISPLAY", "")
    display = values.get("DISPLAY", "")
    if not runtime_text or not Path(runtime_text).is_absolute():
        raise SessionUnavailable("XDG_RUNTIME_DIR is not absolute")
    if not SIGNATURE_PATTERN.fullmatch(signature):
        raise SessionUnavailable("Hyprland instance signature is invalid")
    if not wayland_display or "/" in wayland_display:
        raise SessionUnavailable("WAYLAND_DISPLAY is invalid")
    if not display:
        raise SessionUnavailable("DISPLAY is unavailable")

    runtime = Path(runtime_text)
    try:
        runtime_metadata = runtime.stat()
    except OSError as error:
        raise SessionUnavailable("XDG_RUNTIME_DIR is unavailable") from error
    uid = os.getuid()
    if not stat.S_ISDIR(runtime_metadata.st_mode) or runtime_metadata.st_uid != uid:
        raise SessionUnavailable("XDG_RUNTIME_DIR ownership is invalid")

    instance = runtime / "hypr" / signature
    try:
        instance_metadata = instance.stat()
    except OSError as error:
        raise SessionUnavailable("Hyprland instance directory is unavailable") from error
    if not stat.S_ISDIR(instance_metadata.st_mode) or instance_metadata.st_uid != uid:
        raise SessionUnavailable("Hyprland instance directory ownership is invalid")

    return SessionIdentity(
        runtime=runtime,
        signature=signature,
        wayland_display=wayland_display,
        display=display,
        instance=instance,
        compositor_socket=instance / ".socket.sock",
        wayland_socket=runtime / wayland_display,
        instance_device=instance_metadata.st_dev,
        instance_inode=instance_metadata.st_ino,
    )


def require_current_identity(identity: SessionIdentity) -> None:
    try:
        metadata = identity.instance.stat()
    except OSError as error:
        raise SessionUnavailable("Hyprland instance disappeared") from error
    if (
        not stat.S_ISDIR(metadata.st_mode)
        or metadata.st_uid != os.getuid()
        or metadata.st_dev != identity.instance_device
        or metadata.st_ino != identity.instance_inode
    ):
        raise SessionUnavailable("Hyprland instance identity became stale")


def socket_state(path: Path, uid: int, label: str) -> bool:
    try:
        metadata = path.stat()
    except FileNotFoundError:
        return False
    except OSError as error:
        raise SessionUnavailable(f"{label} could not be inspected") from error
    if not stat.S_ISSOCK(metadata.st_mode) or metadata.st_uid != uid:
        raise SessionUnavailable(f"{label} is invalid")
    return True


def session_sockets_ready(identity: SessionIdentity) -> bool:
    require_current_identity(identity)
    uid = os.getuid()
    compositor_ready = socket_state(
        identity.compositor_socket, uid, "Hyprland command socket"
    )
    wayland_ready = socket_state(identity.wayland_socket, uid, "Wayland display socket")
    return compositor_ready and wayland_ready


def wait_for_session_sockets(
    identity: SessionIdentity,
    timeout_ms: int = READINESS_TIMEOUT_MS,
) -> str:
    if session_sockets_ready(identity):
        return "already-ready"

    libc = ctypes.CDLL(None, use_errno=True)
    inotify_init1 = libc.inotify_init1
    inotify_init1.argtypes = (ctypes.c_int,)
    inotify_init1.restype = ctypes.c_int
    inotify_add_watch = libc.inotify_add_watch
    inotify_add_watch.argtypes = (ctypes.c_int, ctypes.c_char_p, ctypes.c_uint32)
    inotify_add_watch.restype = ctypes.c_int

    descriptor = inotify_init1(os.O_CLOEXEC | os.O_NONBLOCK)
    if descriptor < 0:
        raise SessionUnavailable(
            f"could not initialize compositor socket monitor: errno {ctypes.get_errno()}"
        )

    directories = (identity.runtime, identity.runtime / "hypr", identity.instance)
    try:
        for directory in directories:
            watch = inotify_add_watch(
                descriptor,
                os.fsencode(directory),
                INOTIFY_MASK,
            )
            if watch < 0:
                raise SessionUnavailable(
                    "could not monitor compositor socket paths: "
                    f"errno {ctypes.get_errno()}"
                )

        if session_sockets_ready(identity):
            return "became-ready"

        deadline = time.monotonic() + timeout_ms / 1_000
        with selectors.DefaultSelector() as selector:
            selector.register(descriptor, selectors.EVENT_READ)
            while True:
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    raise SessionUnavailable(
                        f"compositor sockets were not ready within {timeout_ms} ms"
                    )
                if not selector.select(remaining):
                    raise SessionUnavailable(
                        f"compositor sockets were not ready within {timeout_ms} ms"
                    )
                try:
                    os.read(descriptor, 64 * 1024)
                except BlockingIOError:
                    pass
                if session_sockets_ready(identity):
                    return "became-ready"
    finally:
        os.close(descriptor)


def require_session_environment(
    environment: Mapping[str, str] | None = None,
) -> tuple[Path, str, str, str]:
    identity = read_session_identity(environment)
    if not session_sockets_ready(identity):
        raise SessionUnavailable("compositor sockets are unavailable")
    return (
        identity.runtime,
        identity.signature,
        identity.wayland_display,
        identity.display,
    )


def run_systemctl(arguments: Sequence[str]) -> CommandResult:
    result = subprocess.run(
        [SYSTEMCTL, "--user", *arguments],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        check=False,
        shell=False,
    )
    detail = (result.stderr or result.stdout).strip()
    return CommandResult(result.returncode, detail)


def journal_log(level: str, message: str) -> None:
    result = subprocess.run(
        [
            LOGGER,
            "--tag",
            LOG_IDENTIFIER,
            "--priority",
            f"user.{level}",
            "--stderr",
            "--",
            message,
        ],
        stdin=subprocess.DEVNULL,
        check=False,
        shell=False,
    )
    if result.returncode != 0:
        print(f"{LOG_IDENTIFIER}: {message}", file=sys.stderr)


def emit(logger: Logger, level: str, message: str) -> None:
    try:
        logger(level, message)
    except Exception as error:
        print(f"{LOG_IDENTIFIER}: logging failed: {error}", file=sys.stderr)
        print(f"{LOG_IDENTIFIER}: {message}", file=sys.stderr)


def as_result(result: CommandResult | int) -> CommandResult:
    if isinstance(result, CommandResult):
        return result
    return CommandResult(result)


def run_stage(
    runner: Runner,
    logger: Logger,
    stage: str,
    arguments: Sequence[str],
) -> bool:
    result = as_result(runner(arguments))
    if result.returncode == 0:
        emit(logger, "info", f"session-start {stage} succeeded")
        return True
    detail = f": {result.detail}" if result.detail else ""
    emit(
        logger,
        "err",
        f"session-start failed at {stage} (exit {result.returncode}){detail}",
    )
    return False


def session_start(
    runner: Runner = run_systemctl,
    logger: Logger = journal_log,
    waiter: Waiter = wait_for_session_sockets,
) -> int:
    emit(logger, "info", "session-start invoked")
    try:
        identity = read_session_identity()
        emit(
            logger,
            "info",
            "session-start identity "
            f"signature={identity.signature} "
            f"wayland={identity.wayland_display} display={identity.display}",
        )
        readiness = waiter(identity)
        if not session_sockets_ready(identity):
            raise SessionUnavailable("compositor sockets changed after readiness")
    except SessionUnavailable as error:
        emit(logger, "err", f"session-start readiness failed: {error}")
        return 1
    emit(logger, "info", f"session-start readiness {readiness}")

    if not run_stage(
        runner,
        logger,
        "environment-import",
        (
            "import-environment",
            "HYPRLAND_INSTANCE_SIGNATURE",
            "WAYLAND_DISPLAY",
            "DISPLAY",
        ),
    ):
        return 1

    try:
        if not session_sockets_ready(identity):
            raise SessionUnavailable("compositor sockets changed after environment import")
    except SessionUnavailable as error:
        emit(logger, "err", f"session-start stale after environment import: {error}")
        return 1

    failed_state = as_result(runner(("is-failed", "--quiet", SERVICE)))
    if failed_state.returncode == 0:
        if not run_stage(
            runner,
            logger,
            "reset-failed",
            ("reset-failed", SERVICE),
        ):
            return 1
    elif failed_state.returncode == 1:
        emit(logger, "info", "session-start reset-failed not required")
    else:
        detail = f": {failed_state.detail}" if failed_state.detail else ""
        emit(
            logger,
            "err",
            "session-start failed at failure-state inspection "
            f"(exit {failed_state.returncode}){detail}",
        )
        return 1

    try:
        if not session_sockets_ready(identity):
            raise SessionUnavailable("compositor sockets changed before service restart")
    except SessionUnavailable as error:
        emit(logger, "err", f"session-start stale before service restart: {error}")
        return 1

    if not run_stage(
        runner,
        logger,
        "service-restart",
        ("restart", SERVICE),
    ):
        return 1
    if not run_stage(
        runner,
        logger,
        "service-verification",
        ("is-active", "--quiet", SERVICE),
    ):
        return 1
    emit(logger, "info", "session-start completed")
    return 0


def condition() -> int:
    try:
        require_session_environment()
    except SessionUnavailable as error:
        print(f"PolicyKit compositor condition not met: {error}", file=sys.stderr)
        return 1
    return 0


def logout(
    runner: Runner = run_systemctl,
    execer: Callable[[str, Sequence[str]], None] = os.execv,
) -> int:
    result = as_result(runner(("stop", SERVICE)))
    if result.returncode != 0:
        print("PolicyKit service stop failed; logout was not started", file=sys.stderr)
        return 1
    execer(HYPRSHUTDOWN, (HYPRSHUTDOWN,))
    return 0


def main() -> int:
    if len(sys.argv) != 2 or sys.argv[1] not in {
        "condition",
        "logout",
        "session-start",
    }:
        print(
            "usage: vanhyprarch-polkit-session "
            "{condition|logout|session-start}",
            file=sys.stderr,
        )
        return 2
    if sys.argv[1] == "condition":
        return condition()
    if sys.argv[1] == "logout":
        return logout()
    return session_start()


if __name__ == "__main__":
    raise SystemExit(main())
