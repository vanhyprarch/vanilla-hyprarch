    "preparing": {"applying", "committing", "reverting", "reverted", "instance-vanished"},
    "applying": {"temporary-active", "committing", "reverting", "instance-vanished"},
    "temporary-active": {"committing", "reverting", "instance-vanished"},
    "committing": {"committed", "reverting", "instance-vanished"},
    "reverting": {"reverted", "rollback-failed", "instance-vanished"},
    "rollback-failed": {"reverting", "instance-vanished"},
    "committed": set(),
    "reverted": set(),
    "instance-vanished": set(),
}


class MonitorError(RuntimeError):
    """An expected fail-closed monitor transaction error."""


class ValidationError(MonitorError):
    pass


class JournalError(MonitorError):
    pass


class ConcurrentTransaction(MonitorError):
    pass


class StaleTransaction(MonitorError):
    pass


class HyprlandUnavailable(MonitorError):
    pass


class InstanceReplaced(MonitorError):
    pass


class ApplyError(MonitorError):
    pass


class ReadbackError(MonitorError):
    pass


class RollbackError(MonitorError):
    pass


class PersistenceError(MonitorError):
    pass


class PersistenceDeferred(PersistenceError):
    pass


class ConfigReloadInvalidated(MonitorError):
    pass


class OverrideConflict(ValidationError):
    pass


class IdentityAmbiguous(ValidationError):
    pass


@dataclass(frozen=True)
class CommandResult:
    returncode: int
    stdout: str
    stderr: str


class Runner(Protocol):
    def __call__(self, argv: Sequence[str]) -> CommandResult: ...


class Clock(Protocol):
    def monotonic(self) -> float: ...

    def sleep(self, seconds: float) -> None: ...


class SystemClock:
    def monotonic(self) -> float:
        return time.monotonic()

    def sleep(self, seconds: float) -> None:
        time.sleep(seconds)


def run_bounded_command(argv: Sequence[str], timeout_seconds: float) -> CommandResult:
    try:
        completed = subprocess.run(
            list(argv),
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            check=False,
            shell=False,
            timeout=timeout_seconds,
        )
    except subprocess.TimeoutExpired:
        return CommandResult(
            COMMAND_TIMEOUT_RETURN_CODE,
            "",
            f"command timed out after {timeout_seconds:g} seconds",
        )
    except OSError as error:
        return CommandResult(127, "", str(error))
    return CommandResult(completed.returncode, completed.stdout, completed.stderr)


def run_command(argv: Sequence[str]) -> CommandResult:
    return run_bounded_command(argv, COMMAND_TIMEOUT_SECONDS)


def run_verify_command(argv: Sequence[str]) -> CommandResult:
    return run_bounded_command(argv, VERIFY_CONFIG_TIMEOUT_SECONDS)


def _decimal(value: object, label: str) -> Decimal:
    if isinstance(value, bool) or not isinstance(value, (str, int, float, Decimal)):
        raise ValidationError(f"{label} is not numeric")
    try:
        result = Decimal(str(value))
    except InvalidOperation as error:
        raise ValidationError(f"{label} is not numeric") from error
    if not result.is_finite():
        raise ValidationError(f"{label} is not finite")
    return result


def refresh_to_millihz(
    value: object, label: str = "refresh", *, allow_zero: bool = False
) -> int:
    refresh = _decimal(value, label)
    if refresh < 0 or (refresh == 0 and not allow_zero):
        qualifier = "non-negative" if allow_zero else "positive"
        raise ValidationError(f"{label} must be {qualifier}")
    return int((refresh * 1000).quantize(Decimal(1), rounding=ROUND_HALF_UP))


def scale_to_millionths(value: object, *, preflight: bool = False) -> int:
    scale = _decimal(value, "scale")
    if scale < MIN_SCALE or scale > MAX_SCALE:
        raise ValidationError(
            f"scale must be between {MIN_SCALE} and {MAX_SCALE}"
        )
    if preflight and scale * SCALE_DENOMINATOR != (
        scale * SCALE_DENOMINATOR
    ).to_integral_value():
        raise ValidationError("scale must be representable in 1/120 increments")
    return int((scale * 1_000_000).quantize(Decimal(1), rounding=ROUND_HALF_UP))


def _strict_object(value: object, keys: set[str], label: str) -> dict[str, object]:
    if not isinstance(value, dict):
        raise JournalError(f"{label} is not an object")
    actual = set(value)
    if actual != keys:
        missing = sorted(keys - actual)
        unknown = sorted(actual - keys)
        raise JournalError(f"{label} schema mismatch: missing={missing}, unknown={unknown}")
    return value


def _json_value(value: object, label: str) -> object:
    if value is None or isinstance(value, (bool, str, int, float)):
        return value
    if isinstance(value, list):
        return [_json_value(item, label) for item in value]
    if isinstance(value, dict) and all(isinstance(key, str) for key in value):
        return {key: _json_value(item, label) for key, item in value.items()}
    raise ValidationError(f"{label} contains a non-JSON value")


@dataclass(frozen=True)
class Mode:
    width: int
    height: int
    refresh_millihz: int

    @classmethod
    def parse_advertised(cls, value: object) -> "Mode":
        if not isinstance(value, str):
            raise ValidationError("advertised mode is not a string")
        match = MODE_RE.fullmatch(value)
        if match is None:
            raise ValidationError(f"malformed advertised mode: {value!r}")
        return cls(
            int(match.group("width")),
            int(match.group("height")),
            refresh_to_millihz(match.group("refresh"), "advertised refresh"),
        )

    def as_lua_string(self) -> str:
        refresh = Decimal(self.refresh_millihz) / 1000
        refresh_text = format(refresh.normalize(), "f")
        return f"{self.width}x{self.height}@{refresh_text}"


@dataclass(frozen=True)
class PhysicalIdentity:
    connector: str
    make: str
    model: str
    serial: str
    description: str

    def has_evidence(self) -> bool:
        return any((self.make, self.model, self.serial))


@dataclass(frozen=True)
class AutomaticHdrRuntime:
    value: int
    explicitly_set: bool


@dataclass(frozen=True)
class HdrCapability:
    state: str
    available: bool
    reason: str | None
    supports_bt2020: bool
    supports_pq: bool


@dataclass(frozen=True)
class HdrProfileIntent:
    mode: str
    base_present: bool
    base_value: str


def _normalize_edid_text(value: str) -> str:
    return " ".join(value.replace("\x00", "").strip().split()).casefold()


def _edid_descriptor_text(block: bytes, tag: int) -> str:
    values: list[str] = []
    for offset in range(54, 126, 18):
        descriptor = block[offset : offset + 18]
        if len(descriptor) == 18 and descriptor[:3] == b"\x00\x00\x00" and descriptor[3] == tag:
            values.append(descriptor[5:18].decode("ascii", errors="ignore").replace("\n", ""))
    return " ".join(value for value in values if value.strip())


def parse_hdr_edid(data: bytes, identity: PhysicalIdentity) -> HdrCapability:
    if len(data) < 128 or len(data) % 128 != 0 or data[:8] != b"\x00\xff\xff\xff\xff\xff\xff\x00":
        raise ValidationError("display EDID is malformed")
    blocks = [data[index : index + 128] for index in range(0, len(data), 128)]
    if blocks[0][126] + 1 != len(blocks) or any(sum(block) % 256 for block in blocks):
        raise ValidationError("display EDID block inventory or checksum is invalid")
    model = _normalize_edid_text(_edid_descriptor_text(blocks[0], 0xFC))
    serial = _normalize_edid_text(_edid_descriptor_text(blocks[0], 0xFF))
    if not model or model != _normalize_edid_text(identity.model):
        raise ValidationError("display EDID model does not match the bound monitor")
    bound_serial = _normalize_edid_text(identity.serial)
    if bound_serial and serial and serial != bound_serial:
        raise ValidationError("display EDID serial does not match the bound monitor")
    if not bound_serial or not serial:
        raise ValidationError("HDR capability could not be established.")
    supports_bt2020 = False
    supports_pq = False
    for block in blocks[1:]:
        if block[0] != 0x02:
            continue
        end = block[2] or 127
        offset = 4
        while offset < end:
            header = block[offset]
            length = header & 0x1F
            payload = block[offset + 1 : offset + 1 + length]
            if offset + 1 + length > end:
                raise ValidationError("display EDID data block is malformed")
            if header >> 5 == 0x07 and payload:
                if payload[0] == 0x05 and len(payload) >= 2:
                    supports_bt2020 = bool(payload[1] & 0xC0)
                elif payload[0] == 0x06 and len(payload) >= 2:
                    supports_pq = bool(payload[1] & 0x04)
            offset += length + 1
    return HdrCapability(
        "supported" if supports_bt2020 and supports_pq else "unsupported",
        supports_bt2020 and supports_pq,
        None if supports_bt2020 and supports_pq
        else "The display EDID does not advertise both BT.2020 and PQ HDR.",
        supports_bt2020,
        supports_pq,
    )


def read_connector_edid(
    state: "MonitorState", sysfs_root: Path = Path("/sys/class/drm")
) -> bytes:
    matches = sorted(sysfs_root.glob(f"card*-{state.connector}/edid"))
    if len(matches) != 1:
        raise ValidationError("display EDID association is missing or ambiguous")
    try:
        data = matches[0].read_bytes()
    except OSError as error:
        raise ValidationError(f"display EDID cannot be read: {error}") from error
    if not data:
        raise ValidationError("display EDID is empty")
    return data


@dataclass(frozen=True)
class MonitorState:
    connector: str
    monitor_id: int
    identity: PhysicalIdentity
    width: int
    height: int
    refresh_millihz: int
    x: int
    y: int
    scale_millionths: int
    transform: int
    disabled: bool
    dpms: bool
    mirror_of: str
    current_format: str
    vrr: object
    reserved: object
    color_state: dict[str, object]
    advertised_modes: tuple[Mode, ...]

    @property
    def mode(self) -> Mode:
        return Mode(self.width, self.height, self.refresh_millihz)

    @property
    def usable(self) -> bool:
        return not self.disabled and self.dpms and self.width > 0 and self.height > 0

    def protected_key(self) -> tuple[object, ...]:
        # `reserved` is derived from layer-shell exclusive zones, not monitor state.
        return (
            self.identity,
            self.x,
            self.y,
            self.transform,
            self.disabled,
            self.dpms,
            self.mirror_of,
            json.dumps(self.vrr, sort_keys=True, separators=(",", ":")),
            self.canonical_advertised_modes(),
        )

    @property
    def effective_bitdepth(self) -> int | None:
        for bitdepth, formats in BITDEPTH_FORMATS.items():
            if self.current_format in formats:
                return bitdepth
        return None

    def canonical_advertised_modes(self) -> tuple[Mode, ...]:
        return tuple(
            sorted(
                set(self.advertised_modes),
                key=lambda mode: (mode.width, mode.height, mode.refresh_millihz),
            )
        )


@dataclass(frozen=True)
class Topology:
    monitors: tuple[MonitorState, ...]

    def by_connector(self) -> dict[str, MonitorState]:
        result: dict[str, MonitorState] = {}
        for monitor in self.monitors:
            if monitor.connector in result:
                raise ValidationError(f"duplicate connector {monitor.connector!r}")
            result[monitor.connector] = monitor
        return result

    def target(self, connector: str) -> MonitorState:
        try:
            return self.by_connector()[connector]
        except KeyError as error:
            raise ValidationError(f"connector {connector!r} does not exist") from error

    def has_usable_output(self) -> bool:
        return any(monitor.usable for monitor in self.monitors)


HYPRLAND_COLOR_NUMBER_FIELDS = (
    "sdrBrightness",
    "sdrSaturation",
    "sdrMinLuminance",
    "sdrMaxLuminance",
)


def _required(
    payload: Mapping[str, object],
    key: str,
    expected: type | tuple[type, ...],
    label: str,
) -> object:
    if key not in payload:
        raise ValidationError(f"{label} omitted {key}")
    value = payload[key]
    if expected is int:
        if isinstance(value, bool) or not isinstance(value, int):
            raise ValidationError(f"{label}.{key} has the wrong type")
    elif not isinstance(value, expected):
        raise ValidationError(f"{label}.{key} has the wrong type")
    return value


def _required_number(payload: Mapping[str, object], key: str, label: str) -> object:
    value = _required(payload, key, (int, float), label)
    if isinstance(value, bool):
        raise ValidationError(f"{label}.{key} has the wrong type")
    _decimal(value, f"{label}.{key}")
    return value


def _color_state(raw: Mapping[str, object], label: str) -> dict[str, object]:
    result: dict[str, object] = {
        "colorManagementPreset": _required(
            raw, "colorManagementPreset", str, label
        )
    }
    for key in HYPRLAND_COLOR_NUMBER_FIELDS:
        result[key] = _required_number(raw, key, label)
    return result


def _reserved_state(raw: Mapping[str, object], label: str) -> list[int]:
    value = _required(raw, "reserved", list, label)
    if len(value) != 4 or any(
        isinstance(item, bool) or not isinstance(item, int) for item in value
    ):
        raise ValidationError(f"{label}.reserved must contain exactly four integers")
    return value


def parse_monitor_payload(payload: object) -> Topology:
    if not isinstance(payload, list):
        raise ValidationError("monitor response is not an array")
    monitors: list[MonitorState] = []
    for index, raw in enumerate(payload):
        label = f"monitor[{index}]"
        if not isinstance(raw, dict):
            raise ValidationError(f"{label} is not an object")
        connector = _required(raw, "name", str, label)
        if not connector or CONNECTOR_RE.fullmatch(connector) is None:
            raise ValidationError(f"{label}.name is not a safe connector")
        disabled = _required(raw, "disabled", bool, label)
        monitor_id = _required(raw, "id", int, label)
        make = _required(raw, "make", str, label)
        model = _required(raw, "model", str, label)
        serial_number = _required(raw, "serial", str, label)
        description = _required(raw, "description", str, label)
        width = _required(raw, "width", int, label)
        height = _required(raw, "height", int, label)
        refresh = refresh_to_millihz(
            _required_number(raw, "refreshRate", label),
            f"{label}.refreshRate",
            allow_zero=disabled,
        )
        x = _required(raw, "x", int, label)
        y = _required(raw, "y", int, label)
        scale = scale_to_millionths(_required_number(raw, "scale", label))
        transform = _required(raw, "transform", int, label)
        dpms = _required(raw, "dpmsStatus", bool, label)
        mirror_of = _required(raw, "mirrorOf", str, label)
        if mirror_of != "none" and not mirror_of.isdecimal():
            raise ValidationError(f"{label}.mirrorOf is neither 'none' nor a monitor id")
        current_format = _required(raw, "currentFormat", str, label)
        vrr = _required(raw, "vrr", bool, label)
        reserved = _reserved_state(raw, label)
        available = _required(raw, "availableModes", list, label)
        modes = tuple(Mode.parse_advertised(mode) for mode in available)
        color_state = _color_state(raw, label)
        identity = PhysicalIdentity(connector, make, model, serial_number, description)
        if not identity.has_evidence():
            raise ValidationError(f"{label} has no physical identity evidence")
        if not disabled and (width <= 0 or height <= 0 or not modes):
            raise ValidationError(f"{label} is active but unusable")
        monitors.append(
            MonitorState(
                connector,
                monitor_id,
                identity,
                width,
                height,
                refresh,
                x,
                y,
                scale,
                transform,
                disabled,
                dpms,
                mirror_of,
                current_format,
                vrr,
                reserved,
                color_state,
                modes,
            )
        )
    topology = Topology(tuple(monitors))
    topology.by_connector()
    return topology


@dataclass(frozen=True)
class Candidate:
    policy: str
    connector: str
    mode: Mode | None
    bitdepth: int | None
    scale_millionths: int | None
    hdr_mode: str | None = None
    automatic_hdr: int | None = None
    scale_automatic: bool = False

    @classmethod
    def safe(
        cls,
        connector: str,
        *,
        width: int | None = None,
        height: int | None = None,
        refresh: object | None = None,
        bitdepth: int | None = None,
        scale: object | None = None,
        hdr_mode: str | None = None,
        automatic_hdr: int | None = None,
    ) -> "Candidate":
        if not isinstance(connector, str) or CONNECTOR_RE.fullmatch(connector) is None:
            raise ValidationError("candidate connector is invalid")
        mode_values = (width, height, refresh)
        if any(value is not None for value in mode_values):
            if not all(value is not None for value in mode_values):
                raise ValidationError("candidate mode requires width, height, and refresh")
            if isinstance(width, bool) or not isinstance(width, int) or width <= 0:
                raise ValidationError("candidate width is invalid")
            if isinstance(height, bool) or not isinstance(height, int) or height <= 0:
                raise ValidationError("candidate height is invalid")
            mode = Mode(width, height, refresh_to_millihz(refresh))
        else:
            mode = None
        if bitdepth is not None and (type(bitdepth) is not int or bitdepth not in BITDEPTH_FORMATS):
            raise ValidationError("candidate bitdepth must be 8 or 10")
        scale_automatic = False
        if scale is not None:
            scale_automatic = scale == "auto"
            if mode is None or not scale_automatic:
                raise ValidationError(
                    "safe-confirmed Scale must be auto and accompany Mode"
                )
        if hdr_mode is not None and hdr_mode not in HDR_MODES:
            raise ValidationError("candidate HDR mode must be off or always-on")
        if automatic_hdr is not None and (
            type(automatic_hdr) is not int or automatic_hdr not in AUTO_HDR_VALUES
        ):
            raise ValidationError("candidate Automatic HDR value must be 0, 1, or 2")
        if mode is None and bitdepth is None and hdr_mode is None and automatic_hdr is None:
            raise ValidationError(
                "safe-confirmed candidate must own Mode, bitdepth, HDR, or Automatic HDR"
            )
        return cls(
            SAFE_CONFIRMED_POLICY,
            connector,
            mode,
            bitdepth,
            None,
            hdr_mode,
            automatic_hdr,
            scale_automatic,
        )

    @classmethod
    def scale(cls, connector: str, scale: object) -> "Candidate":
        if not isinstance(connector, str) or CONNECTOR_RE.fullmatch(connector) is None:
            raise ValidationError("candidate connector is invalid")
        return cls(
            IMMEDIATE_SCALE_POLICY,
            connector,
            None,
            None,
            scale_to_millionths(scale, preflight=True),
            None,
            None,
        )

    @classmethod
    def materialize(cls, connector: str) -> "Candidate":
        if not isinstance(connector, str) or CONNECTOR_RE.fullmatch(connector) is None:
            raise ValidationError("candidate connector is invalid")
        return cls(MATERIALIZE_POLICY, connector, None, None, None, None, None)

    @property
    def requires_confirmation(self) -> bool:
        return self.policy == SAFE_CONFIRMED_POLICY


def validate_candidate(candidate: Candidate, topology: Topology) -> MonitorState:
    target = topology.target(candidate.connector)
    if target.disabled or not target.usable:
        raise ValidationError("candidate target is inactive or unusable")
    if not target.identity.has_evidence():
        raise ValidationError("candidate target lacks physical identity")
    if candidate.mode is not None and candidate.mode not in set(target.advertised_modes):
        raise ValidationError("candidate mode is not in the advertised catalogue")
    if candidate.bitdepth is not None and target.effective_bitdepth is None:
        raise ValidationError("current effective bitdepth cannot be determined")
    if not topology.has_usable_output():
        raise ValidationError("topology has no usable output")
    return target


def inspection_payload(
    topology: Topology,
    machine_content: bytes,
    override_content: bytes,
    signature: str,
    automatic_hdr_runtime: AutomaticHdrRuntime | None = None,
    cm_enabled: bool = True,
    edid_reader: Callable[[MonitorState], bytes] | None = None,
    temporary_automatic_hdr_intent: AutomaticHdrRuntime | None = None,
) -> dict[str, object]:
    """Project the transaction domain into the small read-only UI contract."""
    runtime_policy = automatic_hdr_runtime or AutomaticHdrRuntime(1, False)
    try:
        if temporary_automatic_hdr_intent is None:
            automatic_intent = automatic_hdr_config_intent(
                machine_content, override_content, runtime_policy
            )
        else:
            original_intent = automatic_hdr_config_intent(
                machine_content, override_content, temporary_automatic_hdr_intent
            )
            automatic_intent = AutomaticHdrRuntime(
                runtime_policy.value, original_intent.explicitly_set
            )
        automatic_available = cm_enabled
        automatic_reason = None if cm_enabled else "Hyprland color management is disabled."
    except MonitorError as error:
        automatic_intent = runtime_policy
        automatic_available = False
        automatic_reason = str(error)
    outputs: list[dict[str, object]] = []
    for state in sorted(topology.monitors, key=lambda item: item.connector):
        editable = False
        unavailable_reason: str | None = None
        materializable = False
        materialization_reason: str | None = None
        profile_state = "unavailable"
        bitdepth_choices: list[int] = []
        hdr_projection: dict[str, object] = {
            "capability": "unknown",
            "available": False,
            "unavailable_reason": "Advanced display settings are unavailable.",
            "mode": "off",
            "base_cm": {"present": False, "value": "srgb"},
            "effective_live": "unknown",
        }
        profile: MachineProfile | None = None
        if not state.usable:
            profile_state = "inactive"
            unavailable_reason = "Output is inactive or unusable."
            materialization_reason = unavailable_reason
        else:
            try:
                reject_superseding_override(override_content, state.connector)
                profile = validate_explicit_profile_editability(
                    machine_content, state
                )
                editable = True
                profile_state = "explicit-editable"
            except MonitorError as explicit_error:
                if isinstance(explicit_error, OverrideConflict):
                    profile_state = "override-conflict"
                    unavailable_reason = str(explicit_error)
                    materialization_reason = str(explicit_error)
                else:
                    try:
                        _, profile = validate_materialization_eligibility(
                            topology,
                            state.connector,
                            machine_content,
                            override_content,
                            allow_serialless=True,
                        )
                        profile_state = "fallback-only"
                        materializable = True
                    except OverrideConflict as error:
                        profile_state = "override-conflict"
                        unavailable_reason = str(error)
                        materialization_reason = str(error)
                    except IdentityAmbiguous as error:
                        profile_state = "ambiguous-identity"
                        unavailable_reason = str(error)
                        materialization_reason = str(error)
                    except MonitorError as error:
                        profile_state = (
                            "explicit-unavailable"
                            if has_explicit_profile(machine_content, state.connector)
                            else "fallback-unavailable"
                        )
                        unavailable_reason = (
                            str(explicit_error)
                            if profile_state == "explicit-unavailable"
                            else str(error)
                        )
                        materialization_reason = str(error)

        if profile is not None:
            bitdepth_intent = profile_bitdepth_intent(profile)
            hdr_intent = profile_hdr_intent(profile)
            if (
                bitdepth_intent in BITDEPTH_FORMATS
                and state.effective_bitdepth is not None
            ):
                bitdepth_choices = sorted(BITDEPTH_FORMATS)
            hdr_reason: str | None = None
            capability = HdrCapability(
                "unknown", False, "HDR capability could not be established.", False, False
            )
            try:
                if not cm_enabled:
                    raise ValidationError("Hyprland color management is disabled.")
                _, icc_intent = profile_color_intent(profile)
                if icc_intent:
                    raise ValidationError("An ICC profile owns this output's color state.")
                if edid_reader is None:
                    raise ValidationError("HDR capability could not be established.")
                capability = evaluate_hdr_capability(
                    state, profile, edid_reader(state)
                )
                if not capability.available:
                    raise ValidationError(capability.reason or "HDR is unsupported.")
                if 10 not in bitdepth_choices:
                    raise ValidationError("A validated 10-bit path is unavailable.")
            except MonitorError as error:
                hdr_reason = str(error)
            hdr_projection = {
                "capability": capability.state,
                "available": hdr_reason is None,
                "unavailable_reason": hdr_reason,
                "mode": hdr_intent.mode,
                "base_cm": {
                    "present": hdr_intent.base_present,
                    "value": hdr_intent.base_value,
                },
                "effective_live": "unknown",
            }

        modes = [
            {
                "width": mode.width,
                "height": mode.height,
                "refresh_millihz": mode.refresh_millihz,
            }
            for mode in state.canonical_advertised_modes()
        ]
        label = state.identity.model.strip() or state.identity.description.strip()
        outputs.append(
            {
                "connector": state.connector,
                "label": label or state.connector,
                "identity": {
                    "make": state.identity.make,
                    "model": state.identity.model,
                    "serial": state.identity.serial,
                },
                "active": not state.disabled,
                "editable": editable,
                "profile_state": profile_state,
                "materializable": materializable,
                "materialization_reason": materialization_reason,
                "unavailable_reason": unavailable_reason,
                "current_mode": None
                if state.width <= 0 or state.height <= 0 or state.refresh_millihz <= 0
                else {
                    "width": state.width,
                    "height": state.height,
                    "refresh_millihz": state.refresh_millihz,
                },
                "available_modes": modes,
                "scale_millionths": state.scale_millionths,
                "scale_automatic": profile is not None
                    and profile_scale_is_automatic(machine_content, profile),
                "effective_bitdepth": state.effective_bitdepth,
                "bitdepth_choices": bitdepth_choices,
                "effective": {
                    "current_format": state.current_format,
                    "color_management_preset": state.color_state[
                        "colorManagementPreset"
                    ],
                },
                "hdr": hdr_projection,
            }
        )
    return {
        "version": INSPECT_VERSION,
        "instance_signature": signature,
        "automatic_hdr": {
            "value": automatic_intent.value,
            "label": AUTO_HDR_LABELS[automatic_intent.value],
            "explicit": automatic_intent.explicitly_set,
            "scope": "global",
            "available": automatic_available,
            "unavailable_reason": automatic_reason,
        },
        "outputs": outputs,
    }


@dataclass(frozen=True)
class InstanceIdentity:
    signature: str
    pid: int
    start_time_ticks: int
    executable_device: int
    executable_inode: int


class InstanceProvider(Protocol):
    def current(self, signature: str) -> InstanceIdentity: ...


def _process_start_time(pid: int) -> int:
    try:
        fields = Path(f"/proc/{pid}/stat").read_text(encoding="ascii").split()
        return int(fields[21])
    except (OSError, IndexError, ValueError) as error:
        raise HyprlandUnavailable("cannot read Hyprland process start time") from error


class ProcInstanceProvider:
    def __init__(self, runtime_dir: Path) -> None:
        self.runtime_dir = runtime_dir

    def current(self, signature: str) -> InstanceIdentity:
        if SIGNATURE_RE.fullmatch(signature) is None:
            raise HyprlandUnavailable("invalid Hyprland instance signature")
        lock_path = self.runtime_dir / "hypr" / signature / "hyprland.lock"
        try:
            if lock_path.is_symlink() or not lock_path.is_file():
                raise HyprlandUnavailable("Hyprland instance lock is not a regular file")
            first_line = lock_path.read_text(encoding="utf-8").splitlines()[0]
            pid = int(first_line)
            if pid <= 1:
                raise ValueError
        except (OSError, IndexError, ValueError) as error:
            if isinstance(error, HyprlandUnavailable):
                raise
            raise HyprlandUnavailable("cannot resolve Hyprland instance") from error
        return process_instance_identity(signature, pid)


def process_instance_identity(signature: str, pid: int) -> InstanceIdentity:
    try:
        executable = Path(f"/proc/{pid}/exe")
        executable_stat = executable.stat()
        if Path(os.readlink(executable)).name != "Hyprland":
            raise HyprlandUnavailable("instance process is not Hyprland")
        process_stat = Path(f"/proc/{pid}").stat()
        if process_stat.st_uid != os.getuid():
            raise HyprlandUnavailable("Hyprland instance has the wrong owner")
        start_time = _process_start_time(pid)
    except OSError as error:
        raise HyprlandUnavailable("bound Hyprland process does not exist") from error
    return InstanceIdentity(
        signature,
        pid,
        start_time,
        executable_stat.st_dev,
        executable_stat.st_ino,
    )


def require_same_instance(expected: InstanceIdentity, actual: InstanceIdentity) -> None:
    if expected != actual:
        raise InstanceReplaced("Hyprland instance disappeared or was replaced")


def lua_string(value: str) -> str:
    encoded = value.encode("utf-8")
    parts = ['"']
    for byte in encoded:
        if 0x20 <= byte <= 0x7E and byte not in (0x22, 0x5C):
            parts.append(chr(byte))
        else:
            parts.append(f"\\x{byte:02x}")
    parts.append('"')
    return "".join(parts)


def monitor_eval_source(candidate: Candidate, *, cm_value: str | None = None) -> str:
    fields = [f"output = {lua_string(candidate.connector)}"]
    if candidate.mode is not None:
        fields.append(f"mode = {lua_string(candidate.mode.as_lua_string())}")
    if candidate.bitdepth is not None:
        fields.append(f"bitdepth = {candidate.bitdepth}")
    if candidate.scale_millionths is not None:
        scale = Decimal(candidate.scale_millionths) / 1_000_000
        fields.append(f"scale = {format(scale.normalize(), 'f')}")
    elif candidate.scale_automatic:
        fields.append('scale = "auto"')
    if cm_value is not None:
        if cm_value not in NON_HDR_CM_PRESETS and cm_value != "hdr":
            raise ValidationError("runtime CM value is unsupported")
        fields.append(f"cm = {lua_string(cm_value)}")
    return "hl.monitor({ " + ", ".join(fields) + " })"


def monitor_eval_argv(
    signature: str, candidate: Candidate, *, cm_value: str | None = None
) -> list[str]:
    return [
        HYPRCTL,
        "--instance",
        signature,
        "eval",
        monitor_eval_source(candidate, cm_value=cm_value),
    ]


def automatic_hdr_eval_source(value: int) -> str:
    if type(value) is not int or value not in AUTO_HDR_VALUES:
        raise ValidationError("Automatic HDR value must be 0, 1, or 2")
    return f"hl.config({{ render = {{ cm_auto_hdr = {value} }} }})"


def automatic_hdr_eval_argv(signature: str, value: int) -> list[str]:
    return [HYPRCTL, "--instance", signature, "eval", automatic_hdr_eval_source(value)]


def getoption_argv(signature: str, option: str) -> list[str]:
    if option not in {"render:cm_auto_hdr", "render:cm_enabled"}:
        raise ValidationError("unsupported Hyprland option readback")
    return [HYPRCTL, "--instance", signature, "-j", "getoption", option]


def monitors_argv(signature: str) -> list[str]:
    return [HYPRCTL, "--instance", signature, "-j", "monitors", "all"]


def reload_argv(signature: str) -> list[str]:
    return [HYPRCTL, "--instance", signature, "reload"]


def configerrors_argv(signature: str) -> list[str]:
    return [HYPRCTL, "--instance", signature, "configerrors"]


class HyprlandClient:
    def __init__(
        self,
        signature: str,
        expected_instance: InstanceIdentity,
        instance_provider: InstanceProvider,
        runner: Runner = run_command,
        clock: Clock | None = None,
    ) -> None:
        self.signature = signature
        self.expected_instance = expected_instance
        self.instance_provider = instance_provider
        self.runner = runner
        self.clock = clock or SystemClock()

    def check_instance(self) -> None:
        try:
            actual = self.instance_provider.current(self.signature)
        except HyprlandUnavailable as error:
            try:
                process_identity = process_instance_identity(
                    self.expected_instance.signature, self.expected_instance.pid
                )
            except HyprlandUnavailable as process_error:
                raise InstanceReplaced("bound Hyprland instance disappeared") from process_error
            if process_identity != self.expected_instance:
                raise InstanceReplaced("bound Hyprland instance was replaced") from error
            raise
        require_same_instance(self.expected_instance, actual)

    def read_topology(self) -> Topology:
        self.check_instance()
        result = self.runner(monitors_argv(self.signature))
        if result.returncode != 0:
            raise HyprlandUnavailable(
                "monitor readback failed: "
                + (result.stderr.strip() or result.stdout.strip() or "no diagnostic")
            )
        try:
            payload = json.loads(result.stdout)
        except json.JSONDecodeError as error:
            raise ReadbackError("monitor readback is not valid JSON") from error
        topology = parse_monitor_payload(payload)
        self.check_instance()
        return topology

    def apply(self, candidate: Candidate, *, cm_value: str | None = None) -> None:
        self.check_instance()
        result = self.runner(
            monitor_eval_argv(self.signature, candidate, cm_value=cm_value)
        )
        if result.returncode != 0 or result.stdout.strip() != "ok":
            raise ApplyError(
                "Hyprland rejected monitor eval: "
                + (result.stderr.strip() or result.stdout.strip() or "no diagnostic")
            )
        self.check_instance()

    def _read_option(self, option: str) -> dict[str, object]:
        self.check_instance()
        result = self.runner(getoption_argv(self.signature, option))
        if result.returncode != 0:
            raise HyprlandUnavailable(
                f"{option} readback failed: "
                + (result.stderr.strip() or result.stdout.strip() or "no diagnostic")
            )
        try:
            payload = json.loads(result.stdout)
        except json.JSONDecodeError as error:
            raise ReadbackError(f"{option} readback is not valid JSON") from error
        if not isinstance(payload, dict) or payload.get("option") != option:
            raise ReadbackError(f"{option} readback has an invalid schema")
        if type(payload.get("set")) is not bool:
            raise ReadbackError(f"{option} readback omitted explicit-state metadata")
        self.check_instance()
        return payload

    def read_automatic_hdr(self) -> "AutomaticHdrRuntime":
        payload = self._read_option("render:cm_auto_hdr")
        value = payload.get("int")
        if type(value) is not int or value not in AUTO_HDR_VALUES:
            raise ReadbackError("render:cm_auto_hdr readback is outside 0/1/2")
        return AutomaticHdrRuntime(value, payload["set"])

    def read_cm_enabled(self) -> bool:
        payload = self._read_option("render:cm_enabled")
        if type(payload.get("bool")) is not bool:
            raise ReadbackError("render:cm_enabled readback is not boolean")
        return payload["bool"]

    def apply_automatic_hdr(self, value: int) -> None:
        self.check_instance()
        result = self.runner(automatic_hdr_eval_argv(self.signature, value))
        if result.returncode != 0 or result.stdout.strip() != "ok":
            raise ApplyError(
                "Hyprland rejected Automatic HDR eval: "
                + (result.stderr.strip() or result.stdout.strip() or "no diagnostic")
            )
        self.check_instance()

    def verify_automatic_hdr(self, value: int) -> None:
        if self.read_automatic_hdr().value != value:
            raise ReadbackError("Automatic HDR policy did not reach the requested value")

    def read_until(self, verifier: Callable[[Topology], None]) -> Topology:
        deadline = self.clock.monotonic() + APPLY_SETTLE_SECONDS
        last_error: MonitorError | None = None
        while True:
            try:
                topology = self.read_topology()
                verifier(topology)
                return topology
            except (ReadbackError, ValidationError) as error:
                last_error = error
            if self.clock.monotonic() >= deadline:
                raise ReadbackError(f"authoritative readback did not converge: {last_error}")
            self.clock.sleep(READBACK_INTERVAL_SECONDS)


def _same_refresh(left: int, right: int) -> bool:
    return abs(left - right) <= REFRESH_TOLERANCE_MILLIHZ


def _selected_refresh_matches(
    active_refresh: int, requested: Mode, advertised_modes: tuple[Mode, ...]
) -> bool:
    if not _same_refresh(active_refresh, requested.refresh_millihz):
        return False
    refreshes = {
        mode.refresh_millihz
        for mode in advertised_modes
        if mode.width == requested.width and mode.height == requested.height
    }
    if requested.refresh_millihz not in refreshes:
        return False
    distance = abs(active_refresh - requested.refresh_millihz)
    return all(
        refresh == requested.refresh_millihz
        or abs(active_refresh - refresh) > distance
        for refresh in refreshes
    )


def _verify_color_transition(
    before: MonitorState,
    after: MonitorState,
    candidate: Candidate,
    cm_intent: str,
    icc_intent: str,
) -> None:
    before_numbers = {key: before.color_state[key] for key in HYPRLAND_COLOR_NUMBER_FIELDS}
    after_numbers = {key: after.color_state[key] for key in HYPRLAND_COLOR_NUMBER_FIELDS}
    if before_numbers != after_numbers:
        raise ValidationError("effective color parameters changed unexpectedly")
    old_preset = before.color_state["colorManagementPreset"]
    new_preset = after.color_state["colorManagementPreset"]
    target_bitdepth = candidate.bitdepth or before.effective_bitdepth
    if candidate.bitdepth is None or candidate.bitdepth == before.effective_bitdepth:
        if before.current_format != after.current_format:
            raise ValidationError("effective DRM format changed unexpectedly")
    elif after.current_format not in BITDEPTH_FORMATS[candidate.bitdepth]:
        raise ValidationError("requested bitdepth is not effective")
    if candidate.hdr_mode == "always-on":
        if target_bitdepth != 10 or new_preset != "hdr":
            raise ValidationError("forced HDR did not reach 10-bit cm=hdr state")
        return
    if candidate.hdr_mode == "off":
        if cm_intent == "auto" and not icc_intent:
            allowed = {"srgb"} if target_bitdepth == 8 else {"srgb", "wide"}
            if new_preset not in allowed:
                raise ValidationError("restored automatic base CM is inconsistent")
        elif new_preset != cm_intent:
            raise ValidationError("exact base CM intent was not restored")
        return
    if candidate.bitdepth is None or candidate.bitdepth == before.effective_bitdepth:
        if old_preset != new_preset:
            raise ValidationError("effective DRM/color state changed unexpectedly")
    elif cm_intent == "auto" and not icc_intent:
        allowed = {"srgb"} if candidate.bitdepth == 8 else {"srgb", "wide"}
        if new_preset not in allowed:
            raise ValidationError("effective auto color preset is inconsistent with bitdepth")
    elif new_preset != old_preset:
        raise ValidationError("fixed effective color preset changed unexpectedly")


def verify_candidate_readback(
    snapshot: Topology,
    candidate: Candidate,
    readback: Topology,
    identity: PhysicalIdentity,
    cm_intent: str = "srgb",
    icc_intent: str = "",
    scale_compositor_owned: bool = False,
) -> None:
    before = snapshot.by_connector()
    after = readback.by_connector()
    if set(before) != set(after):
        raise ValidationError("monitor topology changed during apply")
    if not readback.has_usable_output():
        raise ValidationError("no usable output remains")
    for connector, old in before.items():
        new = after[connector]
        if old.identity != new.identity or old.protected_key() != new.protected_key():
            raise ValidationError(f"protected monitor state changed for {connector}")
        if connector != candidate.connector:
            if (
                old.width != new.width
                or old.height != new.height
                or not _same_refresh(old.refresh_millihz, new.refresh_millihz)
                or old.scale_millionths != new.scale_millionths
                or old.current_format != new.current_format
                or old.color_state != new.color_state
            ):
                raise ValidationError(f"unselected monitor state changed for {connector}")
    target = after[candidate.connector]
    if target.identity != identity:
        raise ValidationError("target connector physical identity changed")
    original = before[candidate.connector]
    if candidate.mode is not None:
        if target.width != candidate.mode.width or target.height != candidate.mode.height:
            raise ValidationError("requested resolution is not active")
        if not _selected_refresh_matches(
            target.refresh_millihz, candidate.mode, target.advertised_modes
        ):
            raise ValidationError("requested refresh is not active")
    elif (
        target.width != original.width
        or target.height != original.height
        or not _same_refresh(target.refresh_millihz, original.refresh_millihz)
    ):
        raise ValidationError("unowned mode changed during apply")
    if candidate.scale_millionths is not None:
        if abs(target.scale_millionths - candidate.scale_millionths) > int(
            SCALE_TOLERANCE * 1_000_000
        ):
            raise ValidationError("requested scale is not active")
    elif (
        not scale_compositor_owned
        and target.scale_millionths != original.scale_millionths
    ):
        raise ValidationError("unowned scale changed during apply")
    _verify_color_transition(original, target, candidate, cm_intent, icc_intent)


def verify_rollback_readback(snapshot: Topology, readback: Topology) -> None:
    before = snapshot.by_connector()
    after = readback.by_connector()
    if set(before) != set(after):
        raise ValidationError("monitor topology changed during rollback")
    if not readback.has_usable_output():
        raise ValidationError("rollback left no usable output")
    for connector, old in before.items():
        new = after[connector]
        if (
            old.identity != new.identity
            or old.protected_key() != new.protected_key()
            or old.current_format != new.current_format
            or old.color_state != new.color_state
        ):
            raise ValidationError(f"protected monitor state was not restored for {connector}")
        if (
            old.width != new.width
            or old.height != new.height
            or not _same_refresh(old.refresh_millihz, new.refresh_millihz)
            or old.scale_millionths != new.scale_millionths
        ):
            raise ValidationError(f"owned monitor state was not restored for {connector}")


@dataclass(frozen=True)
class FileSnapshot:
    path: str
    content_base64: str
    sha256: str
    mode: int
    uid: int
    gid: int
    device: int
    inode: int
    size: int
    mtime_ns: int

    @property
    def content(self) -> bytes:
        try:
            return base64.b64decode(self.content_base64, validate=True)
        except ValueError as error:
            raise JournalError("journal contains invalid file snapshot bytes") from error


def snapshot_file(path: Path, *, require_private: bool = True) -> FileSnapshot:
    try:
        if path.is_symlink():
            raise ValidationError(f"{path} must not be a symlink")
        descriptor = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
        try:
            metadata = os.fstat(descriptor)
            if not stat.S_ISREG(metadata.st_mode):
                raise ValidationError(f"{path} is not a regular file")
            if metadata.st_uid != os.getuid():
                raise ValidationError(f"{path} is not owned by the current user")
            if require_private and stat.S_IMODE(metadata.st_mode) & 0o077:
                raise ValidationError(f"{path} permissions are not private")
            content = b""
            while True:
                chunk = os.read(descriptor, 65536)
                if not chunk:
                    break
                content += chunk
        finally:
            os.close(descriptor)
    except OSError as error:
        raise ValidationError(f"cannot snapshot {path}: {error}") from error
    return FileSnapshot(
        str(path),
        base64.b64encode(content).decode("ascii"),
        hashlib.sha256(content).hexdigest(),
        stat.S_IMODE(metadata.st_mode),
        metadata.st_uid,
        metadata.st_gid,
        metadata.st_dev,
        metadata.st_ino,
        metadata.st_size,
        metadata.st_mtime_ns,
    )


def snapshot_matches(snapshot: FileSnapshot) -> bool:
    try:
        current = snapshot_file(Path(snapshot.path))
    except ValidationError:
        return False
    return (
        current.sha256 == snapshot.sha256
        and current.mode == snapshot.mode
        and current.uid == snapshot.uid
        and current.gid == snapshot.gid
        and current.device == snapshot.device
        and current.inode == snapshot.inode
        and current.size == snapshot.size
        and current.mtime_ns == snapshot.mtime_ns
    )


MONITOR_BLOCK_RE = re.compile(r"hl\.monitor\s*\(\s*\{(?P<body>.*?)\}\s*\)", re.DOTALL)
FIELD_RE_TEMPLATE = (
    r"(?m)^(?P<prefix>[ \t]*{name}[ \t]*=[ \t]*)"
    r"(?P<value>[^,\n]+)(?P<suffix>[ \t]*,?[ \t]*(?:--[^\n]*)?)$"
)
LUA_QUOTED_RE = re.compile(r'^"([^"\\]*)"$')
NUMBER_RE = re.compile(r"^[0-9]+(?:\.[0-9]+)?$")
IDENTIFIER_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")


@dataclass(frozen=True)
class MachineProfile:
    connector: str
    call_start: int
    call_end: int
    block_start: int
    block_end: int
    body: str
    mode_value: str | None
    scale_value: str | None
    bitdepth_value: str | None
    cm_value: str | None
    icc_value: str | None
    supports_hdr_value: str | None
    supports_wide_color_value: str | None
    forced_hdr_marker: str | None


SIMPLE_FALLBACK_LINE_RE = re.compile(
    r"^[ \t]*(?:"
    r"--.*|"
    r"[A-Za-z_][A-Za-z0-9_]*[ \t]*=[ \t]*"
    r"(?:\"[^\"\\]*\"|-?[0-9]+(?:\.[0-9]+)?|true|false|[A-Za-z_][A-Za-z0-9_]*)"
    r"[ \t]*,?[ \t]*(?:--.*)?"
    r")$"
)


def _field(body: str, name: str) -> tuple[str, re.Match[str]]:
    pattern = re.compile(FIELD_RE_TEMPLATE.format(name=re.escape(name)))
    matches = list(pattern.finditer(body))
    if len(matches) != 1:
        raise ValidationError(f"monitor profile has {len(matches)} {name!r} fields")
    return matches[0].group("value").strip(), matches[0]


def _optional_field(body: str, name: str) -> tuple[str | None, re.Match[str] | None]:
    pattern = re.compile(FIELD_RE_TEMPLATE.format(name=re.escape(name)))
    matches = list(pattern.finditer(body))
    if len(matches) > 1:
        raise ValidationError(f"monitor profile has {len(matches)} {name!r} fields")
    if not matches:
        return None, None
    return matches[0].group("value").strip(), matches[0]


def _parsed_monitor_profiles(content: bytes) -> list[MachineProfile]:
    try:
        text = content.decode("utf-8")
    except UnicodeDecodeError as error:
        raise ValidationError("machine configuration is not UTF-8") from error
    parsed: list[MachineProfile] = []
    for match in MONITOR_BLOCK_RE.finditer(text):
        body = match.group("body")
        output_value, _ = _field(body, "output")
        quoted = LUA_QUOTED_RE.fullmatch(output_value)
        if quoted is None:
            raise ValidationError("monitor output must be a simple quoted connector")
        connector = quoted.group(1)
        if connector and CONNECTOR_RE.fullmatch(connector) is None:
            raise ValidationError("machine profile has an unsafe connector")
        mode_value, _ = _optional_field(body, "mode")
        scale_value, _ = _optional_field(body, "scale")
        bitdepth_value, _ = _optional_field(body, "bitdepth")
        cm_value, _ = _optional_field(body, "cm")
        icc_value, _ = _optional_field(body, "icc")
        supports_hdr_value, _ = _optional_field(body, "supports_hdr")
        supports_wide_color_value, _ = _optional_field(body, "supports_wide_color")
        marker_lines = [
            line.strip()[3:].strip()
            for line in body.splitlines()
            if FORCED_HDR_MARKER_PREFIX in line
            and line.strip().startswith("-- ")
            and line.strip()[3:].strip().startswith(FORCED_HDR_MARKER_PREFIX)
        ]
        if body.count(FORCED_HDR_MARKER_PREFIX) != len(marker_lines):
            raise ValidationError("forced-HDR base marker syntax is malformed")
        if len(marker_lines) > 1:
            raise ValidationError("monitor profile has duplicate forced-HDR base markers")
        marker = None
        if marker_lines:
            marker = marker_lines[0][len(FORCED_HDR_MARKER_PREFIX) :].strip()
        parsed.append(
            MachineProfile(
                connector,
                match.start(),
                match.end(),
                match.start("body"),
                match.end("body"),
                body,
                mode_value,
                scale_value,
                bitdepth_value,
                cm_value,
                icc_value,
                supports_hdr_value,
                supports_wide_color_value,
                marker,
            )
        )
    return parsed


def parse_machine_profiles(content: bytes) -> tuple[list[MachineProfile], int]:
    parsed = _parsed_monitor_profiles(content)
    profiles: list[MachineProfile] = []
    seen: set[str] = set()
    catch_all_count = 0
    for profile in parsed:
        if profile.connector == "":
            catch_all_count += 1
            continue
        if profile.connector in seen:
            raise ValidationError(f"ambiguous machine profiles for {profile.connector}")
        seen.add(profile.connector)
        profiles.append(profile)
    if catch_all_count > 1:
        raise ValidationError("machine configuration has ambiguous catch-all profiles")
    return profiles, catch_all_count


def has_explicit_profile(content: bytes, connector: str) -> bool:
    return any(
        profile.connector == connector
        for profile in _parsed_monitor_profiles(content)
    )


def require_supported_fallback(content: bytes) -> MachineProfile:
    fallbacks = [
        profile for profile in _parsed_monitor_profiles(content)
        if profile.connector == ""
    ]
    if len(fallbacks) != 1:
        raise ValidationError("machine configuration requires exactly one fallback profile")
    fallback = fallbacks[0]
    for line in fallback.body.splitlines():
        if line.strip() and SIMPLE_FALLBACK_LINE_RE.fullmatch(line) is None:
            raise ValidationError("fallback profile uses unsupported or ambiguous Lua syntax")
    field_names = re.findall(
        r"(?m)^[ \t]*([A-Za-z_][A-Za-z0-9_]*)[ \t]*=", fallback.body
    )
    if len(field_names) != len(set(field_names)):
        raise ValidationError("fallback profile contains duplicate fields")
    return fallback


def require_explicit_profile(content: bytes, connector: str) -> MachineProfile:
    profiles, _ = parse_machine_profiles(content)
    if any(profile.connector.startswith("desc:") for profile in profiles):
        raise ValidationError("description-addressed machine profiles are ambiguous")
    matches = [profile for profile in profiles if profile.connector == connector]
    if len(matches) != 1:
        raise ValidationError(
            f"connector {connector!r} requires exactly one existing explicit machine profile"
        )
    return matches[0]


def profile_scale_is_automatic(content: bytes, profile: MachineProfile) -> bool:
    value = profile.scale_value
    if value == '"auto"':
        return True
    if value is not None and NUMBER_RE.fullmatch(value):
        return False
    if value is None or IDENTIFIER_RE.fullmatch(value) is None:
        raise ValidationError("explicit profile scale is not readable")
    text = content.decode("utf-8")
    references = re.findall(
        rf"(?m)^[ \t]*scale[ \t]*=[ \t]*{re.escape(value)}[ \t]*,?[ \t]*$",
        text,
    )
    assignment = re.compile(
        rf"(?m)^[ \t]*local[ \t]+{re.escape(value)}[ \t]*=[ \t]*"
        r'(?P<value>[0-9]+(?:\.[0-9]+)?|"auto")[ \t]*$'
    )
    matches = list(assignment.finditer(text))
    if len(references) != 1 or len(matches) != 1:
        raise ValidationError("profile scale variable is shared or ambiguous")
    return matches[0].group("value") == '"auto"'


def reject_superseding_override(content: bytes, connector: str) -> None:
    profiles, _ = parse_machine_profiles(content)
    if any(profile.connector.startswith("desc:") for profile in profiles):
        raise OverrideConflict("description-addressed override profiles are ambiguous")
    if any(profile.connector == connector for profile in profiles):
        raise OverrideConflict(
            f"user override supersedes the machine profile for {connector!r}"
        )


def _meaningful(value: str) -> bool:
    return bool(value.strip())


def validate_materialization_identity(
    topology: Topology,
    target: MonitorState,
    *,
    allow_serialless: bool,
) -> None:
    identity = target.identity
    if not (_meaningful(identity.make) and _meaningful(identity.model)):
        raise IdentityAmbiguous("output lacks meaningful make/model identity")
    if _meaningful(identity.serial):
        key = (identity.make.strip(), identity.model.strip(), identity.serial.strip())
        matches = [
            monitor for monitor in topology.monitors
            if (
                monitor.identity.make.strip(),
                monitor.identity.model.strip(),
                monitor.identity.serial.strip(),
            ) == key
        ]
    else:
        if not allow_serialless:
            raise IdentityAmbiguous("output has no serial identity")
        if not _meaningful(identity.description):
            raise IdentityAmbiguous(
                "serial-less output lacks a meaningful description identity"
            )
        key = (
            identity.make.strip(),
            identity.model.strip(),
            identity.description.strip(),
        )
        matches = [
            monitor for monitor in topology.monitors
            if not _meaningful(monitor.identity.serial)
            and (
                monitor.identity.make.strip(),
                monitor.identity.model.strip(),
                monitor.identity.description.strip(),
            ) == key
        ]
    if len(matches) != 1:
        raise IdentityAmbiguous("output physical identity is ambiguous")


def validate_materialization_eligibility(
    topology: Topology,
    connector: str,
    machine_content: bytes,
    override_content: bytes,
    *,
    allow_serialless: bool,
) -> tuple[MonitorState, MachineProfile]:
    target = topology.target(connector)
    if not target.usable:
        raise ValidationError("output is inactive or unusable")
    profiles, _ = parse_machine_profiles(machine_content)
    if any(profile.connector.startswith("desc:") for profile in profiles):
        raise ValidationError("description-addressed machine profiles are ambiguous")
    if any(profile.connector == connector for profile in profiles):
        raise ValidationError("advanced display settings are already enabled")
    reject_superseding_override(override_content, connector)
    fallback = require_supported_fallback(machine_content)
    validate_materialization_identity(
        topology, target, allow_serialless=allow_serialless
    )
    validate_explicit_profile_editability(
        clone_fallback_profile(machine_content, connector), target
    )
    return target, fallback


def clone_fallback_profile(content: bytes, connector: str) -> bytes:
    if CONNECTOR_RE.fullmatch(connector) is None:
        raise ValidationError("materialization connector is invalid")
    if has_explicit_profile(content, connector):
        raise ValidationError("advanced display settings are already enabled")
    fallback = require_supported_fallback(content)
    text = content.decode("utf-8")
    output_value, output_match = _field(fallback.body, "output")
    if output_value != '""':
        raise ValidationError("fallback output selector is not empty")
    relative_start = fallback.block_start - fallback.call_start + output_match.start("value")
    relative_end = fallback.block_start - fallback.call_start + output_match.end("value")
    original_call = text[fallback.call_start : fallback.call_end]
    cloned_call = (
        original_call[:relative_start]
        + lua_string(connector)
        + original_call[relative_end:]
    )
    return (
        text[: fallback.call_end]
        + "\n\n"
        + cloned_call
        + text[fallback.call_end :]
    ).encode("utf-8")


def profile_hdr_intent(profile: MachineProfile) -> HdrProfileIntent:
    cm_present = profile.cm_value is not None
    cm = "srgb"
    if cm_present:
        quoted = LUA_QUOTED_RE.fullmatch(profile.cm_value or "")
        if quoted is None:
            raise ValidationError("explicit profile cm intent is not a simple string")
        cm = quoted.group(1)
    marker = profile.forced_hdr_marker
    if marker is None:
        if cm in {"hdr", "hdredid"}:
            raise ValidationError(
                "external HDR monitor intent is not owned by Vanilla"
            )
        if cm not in NON_HDR_CM_PRESETS:
            raise ValidationError("explicit profile CM intent is unsupported")
        return HdrProfileIntent("off", cm_present, cm)
    if cm != "hdr":
        raise ValidationError("forced-HDR marker requires cm=hdr")
    cm_line = re.compile(
        r'(?m)^[ \t]*cm[ \t]*=[ \t]*"hdr"[ \t]*,?[ \t]*(?:--[^\n]*)?$'
    )
    marker_line = re.compile(
        rf'(?m)^(?P<indent>[ \t]*)-- {re.escape(FORCED_HDR_MARKER_PREFIX)}[ \t]*'
        rf'{re.escape(marker)}[ \t]*\r?\n(?P=indent)cm[ \t]*=[ \t]*"hdr"'
        rf'[ \t]*,?[ \t]*(?:--[^\n]*)?$'
    )
    if cm_line.search(profile.body) is None or marker_line.search(profile.body) is None:
        raise ValidationError("forced-HDR marker is not adjacent to its cm field")
    if marker == "absent":
        return HdrProfileIntent("always-on", False, "srgb")
    if marker.startswith("present:"):
        base = marker.split(":", 1)[1]
        if base in NON_HDR_CM_PRESETS:
            return HdrProfileIntent("always-on", True, base)
    raise ValidationError("forced-HDR base marker value is invalid")


def profile_color_intent(profile: MachineProfile) -> tuple[str, str]:
    hdr = profile_hdr_intent(profile)
    icc = ""
    if profile.icc_value is not None:
        quoted = LUA_QUOTED_RE.fullmatch(profile.icc_value)
        if quoted is None:
            raise ValidationError("explicit profile ICC intent is not a simple string")
        icc = quoted.group(1)
    return hdr.base_value, icc


def _capability_override(value: str | None, label: str) -> int:
    if value is None:
        return 0
    if value not in {"-1", "0", "1"}:
        raise ValidationError(f"{label} override is unsupported")
    return int(value)


def profile_capability_overrides(profile: MachineProfile) -> tuple[int, int]:
    return (
        _capability_override(profile.supports_hdr_value, "supports_hdr"),
        _capability_override(
            profile.supports_wide_color_value, "supports_wide_color"
        ),
    )


def evaluate_hdr_capability(
    state: MonitorState, profile: MachineProfile, edid: bytes
) -> HdrCapability:
    parsed = parse_hdr_edid(edid, state.identity)
    hdr_override, wide_override = profile_capability_overrides(profile)
    if wide_override == -1:
        return HdrCapability(
            "disabled", False, "Wide-color capability is explicitly disabled.",
            False, parsed.supports_pq,
        )
    wide = True if wide_override == 1 else parsed.supports_bt2020
    if hdr_override == -1:
        return HdrCapability(
            "disabled", False, "HDR capability is explicitly disabled.",
            wide, False,
        )
    hdr = True if hdr_override == 1 else parsed.supports_pq
    available = wide and hdr
    return HdrCapability(
        "supported" if available else "unsupported",
        available,
        None if available else "The display is missing required BT.2020 or PQ capability.",
        wide,
        hdr,
    )


def profile_bitdepth_intent(profile: MachineProfile) -> int:
    if profile.bitdepth_value is None:
        return 8
    if profile.bitdepth_value in {"8", "10"}:
        return int(profile.bitdepth_value)
    raise ValidationError("explicit profile bitdepth intent is unsupported")


def _insert_bitdepth(body: str, value: int) -> str:
    if value not in BITDEPTH_FORMATS:
        raise PersistenceError("bitdepth insertion value is invalid")
    _, anchor = _field(body, "scale")
    if "," not in anchor.group("suffix"):
        raise PersistenceError("profile scale field needs a trailing comma for insertion")
    indentation = re.match(r"[ \t]*", anchor.group("prefix")).group(0)
    newline = "\r\n" if "\r\n" in body else "\n"
    return (
        body[: anchor.end()]
        + newline
        + indentation
        + f"bitdepth = {value},"
        + body[anchor.end() :]
    )


def _rewrite_hdr_intent(body: str, hdr_mode: str) -> str:
    temporary = MachineProfile(
        "", 0, 0, 0, len(body), body, None, None, None,
        _optional_field(body, "cm")[0], _optional_field(body, "icc")[0],
        _optional_field(body, "supports_hdr")[0],
        _optional_field(body, "supports_wide_color")[0],
        None,
    )
    marker_matches = re.findall(
        rf"(?m)^[ \t]*-- {re.escape(FORCED_HDR_MARKER_PREFIX)}.*$", body
    )
    if FORCED_HDR_MARKER_PREFIX in body and len(marker_matches) != 1:
        raise PersistenceError("forced-HDR marker syntax is malformed")
    if marker_matches:
        marker_text = marker_matches[0].strip()[3:].strip()
        temporary = replace(
            temporary,
            forced_hdr_marker=marker_text[len(FORCED_HDR_MARKER_PREFIX) :].strip(),
        )
    try:
        current = profile_hdr_intent(temporary)
    except ValidationError as error:
        raise PersistenceError(str(error)) from error
    if hdr_mode == current.mode:
        return body
    newline = "\r\n" if "\r\n" in body else "\n"
    if hdr_mode == "always-on":
        cm_value, cm_match = _optional_field(body, "cm")
        marker = (
            f"present:{current.base_value}" if current.base_present else "absent"
        )
        if cm_match is not None:
            indentation = re.match(r"[ \t]*", cm_match.group("prefix")).group(0)
            line_start = body.rfind("\n", 0, cm_match.start()) + 1
            replacement = (
                f"{indentation}-- {FORCED_HDR_MARKER_PREFIX} {marker}{newline}"
                + body[line_start : cm_match.start("value")]
                + '"hdr"'
                + body[cm_match.end("value") : cm_match.end()]
            )
            return body[:line_start] + replacement + body[cm_match.end() :]
        _, anchor = _field(body, "scale")
        if "," not in anchor.group("suffix"):
            raise PersistenceError("profile scale field needs a trailing comma for HDR insertion")
        indentation = re.match(r"[ \t]*", anchor.group("prefix")).group(0)
        addition = (
            newline
            + indentation
            + f"-- {FORCED_HDR_MARKER_PREFIX} {marker}"
            + newline
            + indentation
            + 'cm = "hdr",'
        )
        return body[: anchor.end()] + addition + body[anchor.end() :]
    if hdr_mode != "off":
        raise PersistenceError("unsupported HDR persistence mode")
    # The strict parser already proved adjacency; remove or restore the pair as one unit.
    pair = re.compile(
        rf'(?m)^(?P<indent>[ \t]*)-- {re.escape(FORCED_HDR_MARKER_PREFIX)}[ \t]*'
        r'(?P<marker>absent|present:[A-Za-z0-9_-]+)[ \t]*\r?\n'
        r'(?P=indent)cm[ \t]*=[ \t]*"hdr"'
        r'(?P<suffix>[ \t]*,?[ \t]*(?:--[^\n]*)?)$'
    )
    match = pair.search(body)
    if match is None:
        raise PersistenceError("forced-HDR marker pair cannot be restored")
    if not current.base_present:
        start = match.start()
        end = match.end()
        if end < len(body) and body[end : end + 2] == "\r\n":
            end += 2
        elif end < len(body) and body[end] == "\n":
            end += 1
        return body[:start] + body[end:]
    replacement = (
        match.group("indent")
        + "cm = "
        + lua_string(current.base_value)
        + match.group("suffix")
    )
    return body[: match.start()] + replacement + body[match.end() :]


AUTO_HDR_BLOCK_RE = re.compile(
    re.escape(AUTO_HDR_BLOCK_MARKER)
    + r"\r?\nhl\.config\(\{\r?\n"
    + r"    render = \{\r?\n"
    + r"        cm_auto_hdr = (?P<value>[012]),\r?\n"
    + r"    \},\r?\n"
    + r"\}\)"
)


def automatic_hdr_config_intent(
    machine_content: bytes, override_content: bytes, runtime: AutomaticHdrRuntime
) -> AutomaticHdrRuntime:
    try:
        machine = machine_content.decode("utf-8")
        override = override_content.decode("utf-8")
    except UnicodeDecodeError as error:
        raise ValidationError("HDR policy configuration is not UTF-8") from error
    if "cm_auto_hdr" in override:
        raise OverrideConflict("user override owns render:cm_auto_hdr")
    matches = list(AUTO_HDR_BLOCK_RE.finditer(machine))
    covered = "".join(match.group(0) for match in matches)
    if machine.count("cm_auto_hdr") != covered.count("cm_auto_hdr"):
        raise ValidationError("external machine Automatic HDR policy is not Vanilla-owned")
    if len(matches) > 1:
        raise ValidationError("machine Automatic HDR policy is ambiguous")
    if not matches:
        # `hl.config()` necessarily marks the live value as set-by-user. That
        # flag therefore remains true after a targeted timeout rollback even
        # when the durable machine intent is still omission. Persistent
        # explicitness is owned by the strict machine block, while the runtime
        # value remains authoritative for the current policy.
        return AutomaticHdrRuntime(runtime.value, False)
    value = int(matches[0].group("value"))
    if runtime.value != value or not runtime.explicitly_set:
        raise ValidationError("persistent and effective Automatic HDR policy disagree")
    return AutomaticHdrRuntime(value, True)


def rewrite_automatic_hdr(content: bytes, value: int) -> bytes:
    if type(value) is not int or value not in AUTO_HDR_VALUES:
        raise PersistenceError("Automatic HDR persistence value is invalid")
    text = content.decode("utf-8")
    matches = list(AUTO_HDR_BLOCK_RE.finditer(text))
    covered = "".join(match.group(0) for match in matches)
    if text.count("cm_auto_hdr") != covered.count("cm_auto_hdr") or len(matches) > 1:
        raise PersistenceError("Automatic HDR machine ownership is ambiguous")
    if matches:
        match = matches[0]
        start, end = match.span("value")
        return (text[:start] + str(value) + text[end:]).encode("utf-8")
    separator = "" if not text or text.endswith("\n\n") else ("\n" if text.endswith("\n") else "\n\n")
    block = (
        AUTO_HDR_BLOCK_MARKER
        + "\nhl.config({\n"
        + "    render = {\n"
        + f"        cm_auto_hdr = {value},\n"
        + "    },\n"
        + "})\n"
    )
    return (text + separator + block).encode("utf-8")


def rewrite_existing_profile(content: bytes, candidate: Candidate) -> bytes:
    profile = require_explicit_profile(content, candidate.connector)
    text = content.decode("utf-8")
    body = profile.body
    replacements: list[tuple[int, int, str]] = []
    if candidate.mode is not None:
        mode_value, mode_match = _optional_field(body, "mode")
        if mode_match is None or mode_value is None or LUA_QUOTED_RE.fullmatch(mode_value) is None:
            raise PersistenceError("explicit profile mode is not a replaceable string")
        replacements.append(
            (mode_match.start("value"), mode_match.end("value"), lua_string(candidate.mode.as_lua_string()))
        )
    if candidate.bitdepth is not None:
        bitdepth_value, bitdepth_match = _optional_field(body, "bitdepth")
        if bitdepth_match is None:
            if bitdepth_value is not None:
                raise PersistenceError("explicit profile bitdepth is ambiguous")
        elif bitdepth_value not in {"8", "10"}:
            raise PersistenceError("explicit profile bitdepth is not replaceable")
        else:
            replacements.append(
                (bitdepth_match.start("value"), bitdepth_match.end("value"), str(candidate.bitdepth))
            )
    new_body = body
    for start, end, value in sorted(replacements, reverse=True):
        new_body = new_body[:start] + value + new_body[end:]
    if candidate.bitdepth is not None and bitdepth_match is None:
        new_body = _insert_bitdepth(new_body, candidate.bitdepth)
    if candidate.hdr_mode is not None:
        new_body = _rewrite_hdr_intent(new_body, candidate.hdr_mode)
    if candidate.scale_millionths is None and not candidate.scale_automatic:
        return (
            text[: profile.block_start]
            + new_body
            + text[profile.block_end :]
        ).encode("utf-8")
    scale_value, scale_match = _field(new_body, "scale")
    scale_text = '"auto"' if candidate.scale_automatic else format(
        (Decimal(candidate.scale_millionths) / 1_000_000).normalize(), "f"
    )
    if NUMBER_RE.fullmatch(scale_value) or scale_value == '"auto"':
        new_body = (
            new_body[: scale_match.start("value")]
            + scale_text
            + new_body[scale_match.end("value") :]
        )
    elif IDENTIFIER_RE.fullmatch(scale_value):
        scale_references = re.findall(
            rf"(?m)^[ \t]*scale[ \t]*=[ \t]*{re.escape(scale_value)}[ \t]*,?[ \t]*$",
            text,
        )
        if len(scale_references) != 1:
            raise PersistenceError("profile scale variable is shared or ambiguous")
        assignment = re.compile(
            rf"(?m)^(?P<prefix>[ \t]*local[ \t]+{re.escape(scale_value)}[ \t]*=[ \t]*)"
            r'(?P<value>[0-9]+(?:\.[0-9]+)?|"auto")(?P<suffix>[ \t]*)$'
        )
        matches = list(assignment.finditer(text))
        if len(matches) != 1:
            raise PersistenceError("profile scale variable is missing or ambiguous")
        variable_match = matches[0]
        assignment_precedes_profile = variable_match.start() < profile.block_start
        text = (
            text[: variable_match.start("value")]
            + scale_text
            + text[variable_match.end("value") :]
        )
        if assignment_precedes_profile:
            delta = len(scale_text) - len(variable_match.group("value"))
            profile = replace(
                profile,
                block_start=profile.block_start + delta,
                block_end=profile.block_end + delta,
            )
    else:
        raise PersistenceError("explicit profile scale is not replaceable")
    return (text[: profile.block_start] + new_body + text[profile.block_end :]).encode("utf-8")


def rewrite_machine_configuration(content: bytes, candidate: Candidate) -> bytes:
    if candidate.policy == MATERIALIZE_POLICY:
        return clone_fallback_profile(content, candidate.connector)
    rewritten = rewrite_existing_profile(content, candidate)
    if candidate.automatic_hdr is not None:
        rewritten = rewrite_automatic_hdr(rewritten, candidate.automatic_hdr)
    return rewritten


def validate_explicit_profile_editability(
    content: bytes, target: MonitorState
) -> MachineProfile:
    """Prove that every product-owned field can be specialized later."""
    profile = require_explicit_profile(content, target.connector)
    rewrite_existing_profile(
        content,
        Candidate.safe(
            target.connector,
            width=target.width,
            height=target.height,
            refresh=Decimal(target.refresh_millihz) / 1000,
        ),
    )
    rewrite_existing_profile(
        content,
        Candidate.scale(
            target.connector, Decimal(target.scale_millionths) / 1_000_000
        ),
    )
    bitdepth_intent = profile_bitdepth_intent(profile)
    rewrite_existing_profile(
        content, Candidate.safe(target.connector, bitdepth=bitdepth_intent)
    )
    profile_color_intent(profile)
    profile_capability_overrides(profile)
    return profile


def atomic_replace(
    path: Path,
    content: bytes,
    mode: int,
    *,
    uid: int | None = None,
    gid: int | None = None,
) -> None:
    directory = path.parent
    prefix = f".{path.name}.vanhyprarch-monitor."
    descriptor = -1
    temporary_path: Path | None = None
    try:
        descriptor, temporary_name = tempfile.mkstemp(prefix=prefix, dir=directory)
        temporary_path = Path(temporary_name)
        os.fchmod(descriptor, mode)
        if uid is not None or gid is not None:
            os.fchown(descriptor, -1 if uid is None else uid, -1 if gid is None else gid)
        offset = 0
        while offset < len(content):
            offset += os.write(descriptor, content[offset:])
        os.fsync(descriptor)
        os.close(descriptor)
        descriptor = -1
        os.replace(temporary_path, path)
        temporary_path = None
        directory_descriptor = os.open(directory, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory_descriptor)
        finally:
            os.close(directory_descriptor)
    except OSError as error:
        raise PersistenceError(f"atomic replacement failed for {path}: {error}") from error
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        if temporary_path is not None:
            try:
                temporary_path.unlink()
            except FileNotFoundError:
                pass


class ProspectiveVerifier(Protocol):
    def __call__(self, journal: "TransactionJournal", machine_content: bytes) -> None: ...


def _copy_regular_tree(source: Path, destination: Path) -> None:
    """Copy a managed config subtree without following special files or links."""
    if source.is_symlink() or not source.is_dir():
        raise PersistenceError(f"prospective configuration source is unsafe: {source}")
    destination.mkdir(parents=True, mode=0o700)
    for entry in source.iterdir():
        target = destination / entry.name
        if entry.is_symlink():
            raise PersistenceError(f"prospective configuration source is a symlink: {entry}")
        if entry.is_dir():
            _copy_regular_tree(entry, target)
        elif entry.is_file():
            target.write_bytes(entry.read_bytes())
            target.chmod(0o600)
        else:
            raise PersistenceError(f"prospective configuration source is not regular: {entry}")


class SandboxedHyprlandVerifier:
    """Verify the complete staged Lua import graph without live-session access."""

    def __init__(
        self,
        config_home: Path,
        runner: Runner = run_verify_command,
        *,
        hyprland: str = "/usr/bin/Hyprland",
        bubblewrap: str = "/usr/bin/bwrap",
    ) -> None:
        self.config_home = config_home
        self.runner = runner
        self.hyprland = hyprland
        self.bubblewrap = bubblewrap

    def _stage(self, root: Path, journal: "TransactionJournal", machine_content: bytes) -> Path:
        staged = root / "config"
        hypr = staged / "hypr"
        managed = hypr / "vanhyprarch"
        machine = staged / "vanhyprarch/machine"
        override = staged / "vanhyprarch/overrides"
        hypr.mkdir(parents=True, mode=0o700)
        machine.mkdir(parents=True, mode=0o700)
        override.mkdir(parents=True, mode=0o700)
        loader = self.config_home / "hypr/hyprland.lua"
        if loader.is_symlink() or not loader.is_file():
            raise PersistenceError("managed Hyprland entrypoint is missing or unsafe")
        (hypr / "hyprland.lua").write_bytes(loader.read_bytes())
        _copy_regular_tree(self.config_home / "hypr/vanhyprarch", managed)
        (machine / "hyprland.lua").write_bytes(machine_content)
        (override / "hyprland.lua").write_bytes(journal.override_file.content)
        for path in (
            hypr / "hyprland.lua",
            machine / "hyprland.lua",
            override / "hyprland.lua",
        ):
            path.chmod(0o600)
        return staged

    def __call__(self, journal: "TransactionJournal", machine_content: bytes) -> None:
        with tempfile.TemporaryDirectory(prefix="vanhyprarch-monitor-verify-") as temporary:
            staged = self._stage(Path(temporary), journal, machine_content)
            argv = [
                self.bubblewrap,
                "--unshare-all",
                "--die-with-parent",
                "--new-session",
                "--ro-bind", "/usr", "/usr",
                "--ro-bind", "/etc", "/etc",
                "--symlink", "usr/bin", "/bin",
                "--symlink", "usr/bin", "/sbin",
                "--symlink", "usr/lib", "/lib",
                "--symlink", "usr/lib", "/lib64",
                "--proc", "/proc",
                "--dev", "/dev",
                "--tmpfs", "/tmp",
                "--dir", "/run",
                "--dir", "/runtime",
                "--dir", "/home",
                "--dir", "/home/vanhyprarch-verify",
                "--ro-bind", os.fspath(staged), "/config",
                "--dir", "/data",
                "--clearenv",
                "--setenv", "HOME", "/home/vanhyprarch-verify",
                "--setenv", "XDG_CONFIG_HOME", "/config",
                "--setenv", "XDG_DATA_HOME", "/data",
                "--setenv", "XDG_RUNTIME_DIR", "/runtime",
                "--setenv", "PATH", "/usr/bin",
                "--setenv", "LANG", "C.UTF-8",
                "--",
                self.hyprland,
                "--verify-config",
                "--config", "/config/hypr/hyprland.lua",
            ]
            result = self.runner(argv)
        if result.returncode == COMMAND_TIMEOUT_RETURN_CODE:
            raise PersistenceError(
                f"prospective Hyprland verification timed out after {VERIFY_CONFIG_TIMEOUT_SECONDS:g} seconds"
            )
        if result.returncode != 0:
            diagnostic = result.stderr.strip() or result.stdout.strip() or "no diagnostic"
            raise PersistenceError(f"prospective Hyprland verification failed: {diagnostic}")


class ReloadWatch(Protocol):
    def wait(self, timeout: float) -> bool: ...
    def close(self) -> None: ...


class ReloadEventSource(Protocol):
    def arm(self, journal: "TransactionJournal") -> ReloadWatch: ...


class ReloadCoordinator(Protocol):
    def arm(self, journal: "TransactionJournal") -> ReloadWatch: ...
    def reconcile(
        self, journal: "TransactionJournal", client: HyprlandClient,
        watch: ReloadWatch,
    ) -> None: ...


class SocketReloadWatch:
    def __init__(self, path: Path) -> None:
        self.socket = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            self.socket.connect(os.fspath(path))
        except BaseException:
            self.socket.close()
            raise
        self.buffer = b""

    def wait(self, timeout: float) -> bool:
        deadline = time.monotonic() + timeout
        while True:
            while b"\n" in self.buffer:
                line, self.buffer = self.buffer.split(b"\n", 1)
                if line == b"configreloaded>>":
                    return True
            remaining = max(0.0, deadline - time.monotonic())
            self.socket.settimeout(remaining)
            try:
                chunk = self.socket.recv(65536)
            except (BlockingIOError, TimeoutError):
                return False
            if not chunk:
                raise PersistenceError("Hyprland event socket closed during reconciliation")
            self.buffer += chunk

    def close(self) -> None:
        self.socket.close()


class HyprlandReloadCoordinator:
    def __init__(self, runtime_root: Path, runner: Runner = run_command) -> None:
        self.runtime_root = runtime_root
        self.runner = runner

    def arm(self, journal: "TransactionJournal") -> ReloadWatch:
        path = self.runtime_root / "hypr" / journal.instance.signature / ".socket2.sock"
        try:
            return SocketReloadWatch(path)
        except OSError as error:
            raise PersistenceError(f"cannot arm Hyprland reload observation: {error}") from error

    def reconcile(
        self, journal: "TransactionJournal", client: HyprlandClient,
        watch: ReloadWatch,
    ) -> None:
        client.check_instance()
        observed = watch.wait(RELOAD_EVENT_WAIT_SECONDS)
        if not observed:
            result = self.runner(reload_argv(journal.instance.signature))
            if result.returncode != 0:
                diagnostic = result.stderr.strip() or result.stdout.strip() or "no diagnostic"
                raise PersistenceError(f"ordinary Hyprland reload failed: {diagnostic}")
            client.check_instance()
            if not watch.wait(RELOAD_EVENT_WAIT_SECONDS):
                raise PersistenceError("Hyprland configreloaded event was not observed")
        client.check_instance()
        result = self.runner(configerrors_argv(journal.instance.signature))
        if result.returncode != 0 or result.stdout.strip():
            diagnostic = result.stdout.strip() or result.stderr.strip() or "no diagnostic"
            raise PersistenceError(f"Hyprland reported configuration errors: {diagnostic}")
        client.check_instance()


class SocketReloadEventSource:
    def __init__(self, runtime_root: Path) -> None:
        self.runtime_root = runtime_root

    def arm(self, journal: "TransactionJournal") -> ReloadWatch:
        path = self.runtime_root / "hypr" / journal.instance.signature / ".socket2.sock"
        try:
            return SocketReloadWatch(path)
        except OSError as error:
            raise PersistenceError(f"cannot arm Hyprland reload observation: {error}") from error


class NullReloadWatch:
    def wait(self, timeout: float) -> bool:
        return False

    def close(self) -> None:
        pass


class NullReloadEventSource:
    def arm(self, journal: "TransactionJournal") -> ReloadWatch:
        return NullReloadWatch()


class DisabledReloadCoordinator:
    def arm(self, journal: "TransactionJournal") -> ReloadWatch:
        raise PersistenceDeferred("production monitor persistence reconciliation is disabled")

    def reconcile(
        self, journal: "TransactionJournal", client: HyprlandClient,
        watch: ReloadWatch,
    ) -> None:
        raise PersistenceDeferred("production monitor persistence reconciliation is disabled")


class Persister(Protocol):
    def prepare(self, journal: "TransactionJournal") -> tuple[bytes, str]: ...

    def persist(
        self, journal: "TransactionJournal", content: bytes,
        guard: Callable[[], None] | None = None,
    ) -> None: ...

    def recover_original(self, journal: "TransactionJournal") -> bool: ...

    def machine_state(self, journal: "TransactionJournal") -> str: ...


class DisabledProductionPersister:
    def prepare(self, journal: "TransactionJournal") -> tuple[bytes, str]:
        raise PersistenceDeferred("production monitor persistence awaits controlled live acceptance")

    def persist(
        self, journal: "TransactionJournal", content: bytes,
        guard: Callable[[], None] | None = None,
    ) -> None:
        raise PersistenceDeferred("production monitor persistence awaits controlled live acceptance")

    def recover_original(self, journal: "TransactionJournal") -> bool:
        return False

    def machine_state(self, journal: "TransactionJournal") -> str:
        return "original"


class MachineConfigPersister:
    """Byte-preserving, race-detecting machine-profile persistence primitive."""

    def __init__(self, verifier: ProspectiveVerifier) -> None:
        self.verifier = verifier

    def prepare(self, journal: "TransactionJournal") -> tuple[bytes, str]:
        if not snapshot_matches(journal.machine_file):
            raise PersistenceError("machine configuration changed during transaction")
        if not snapshot_matches(journal.override_file):
            raise PersistenceError("user override changed during transaction")
        content = rewrite_machine_configuration(
            journal.machine_file.content, journal.candidate
        )
        try:
            self.verifier(journal, content)
        except MonitorError:
            raise
        except Exception as error:
            raise PersistenceError(f"prospective configuration verification failed: {error}") from error
        return content, hashlib.sha256(content).hexdigest()

    def persist(
        self, journal: "TransactionJournal", content: bytes,
        guard: Callable[[], None] | None = None,
    ) -> None:
        if not snapshot_matches(journal.machine_file):
            raise PersistenceError("machine configuration changed before atomic write")
        if not snapshot_matches(journal.override_file):
            raise PersistenceError("user override changed before atomic write")
        if guard is not None:
            guard()
        atomic_replace(
            Path(journal.machine_file.path),
            content,
            journal.machine_file.mode,
            uid=journal.machine_file.uid,
            gid=journal.machine_file.gid,
        )
        current = snapshot_file(Path(journal.machine_file.path))
        expected = hashlib.sha256(content).hexdigest()
        if current.sha256 != expected or current.mode != journal.machine_file.mode:
            raise PersistenceError("persisted machine configuration verification failed")

    def machine_state(self, journal: "TransactionJournal") -> str:
        path = Path(journal.machine_file.path)
        current = snapshot_file(path)
        if current.sha256 == journal.machine_file.sha256:
            return "original"
        if (
            journal.planned_machine_sha256 is not None
            and current.sha256 == journal.planned_machine_sha256
        ):
            return "candidate"
        return "external"

    def recover_original(self, journal: "TransactionJournal") -> bool:
        state = self.machine_state(journal)
        if state == "original":
            return False
        if state == "external":
            raise PersistenceError("machine file has an unrelated external edit")
        path = Path(journal.machine_file.path)
        atomic_replace(
            path,
            journal.machine_file.content,
            journal.machine_file.mode,
            uid=journal.machine_file.uid,
            gid=journal.machine_file.gid,
        )
        if snapshot_file(path).sha256 != journal.machine_file.sha256:
            raise PersistenceError("original machine configuration restoration failed")
        return True


@dataclass(frozen=True)
class TransactionJournal:
    schema_version: int
    transaction_id: str
    state: str
    sequence: int
    created_monotonic: float
    updated_monotonic: float
    deadline_monotonic: float | None
    failure: str | None
    mutation_attempted: bool
    runtime_verified: bool
    persistence_verified: bool
    recovery_required: bool
    planned_machine_sha256: str | None
    persistence_phase: str
    instance: InstanceIdentity
    target_identity: PhysicalIdentity
    candidate: Candidate
    bitdepth_intent: int | None
    cm_intent: str
    icc_intent: str
    snapshot: Topology
    machine_file: FileSnapshot
    override_file: FileSnapshot
    cm_present: bool = True
    forced_hdr: bool = False
    automatic_hdr_intent: int | None = None
    automatic_hdr_explicit: bool | None = None


JOURNAL_KEYS = {
    "schema_version",
    "transaction_id",
    "state",
    "sequence",
    "created_monotonic",
    "updated_monotonic",
    "deadline_monotonic",
    "failure",
    "mutation_attempted",
    "runtime_verified",
    "persistence_verified",
    "recovery_required",
    "planned_machine_sha256",
    "persistence_phase",
    "instance",
    "target_identity",
    "candidate",
    "bitdepth_intent",
    "cm_intent",
    "icc_intent",
    "snapshot",
    "machine_file",
    "override_file",
    "cm_present",
    "forced_hdr",
    "automatic_hdr_intent",
    "automatic_hdr_explicit",
}


def _mode_from_dict(value: object, label: str) -> Mode:
    raw = _strict_object(value, {"width", "height", "refresh_millihz"}, label)
    if not all(type(raw[key]) is int for key in raw):
        raise JournalError(f"{label} has invalid numeric fields")
    return Mode(raw["width"], raw["height"], raw["refresh_millihz"])


def _identity_from_dict(value: object, label: str) -> PhysicalIdentity:
    keys = {"connector", "make", "model", "serial", "description"}
    raw = _strict_object(value, keys, label)
    if not all(isinstance(raw[key], str) for key in keys):
        raise JournalError(f"{label} has invalid fields")
    return PhysicalIdentity(**raw)


def _monitor_from_dict(value: object, label: str) -> MonitorState:
    keys = {
        "connector", "monitor_id", "identity", "width", "height",
        "refresh_millihz", "x", "y", "scale_millionths", "transform",
        "disabled", "dpms", "mirror_of", "current_format", "vrr",
        "reserved", "color_state", "advertised_modes",
    }
    raw = _strict_object(value, keys, label)
    integer_keys = {
        "monitor_id", "width", "height", "refresh_millihz", "x", "y",
        "scale_millionths", "transform",
    }
    if not all(type(raw[key]) is int for key in integer_keys):
        raise JournalError(f"{label} has invalid integer fields")
    if not all(isinstance(raw[key], str) for key in ("connector", "mirror_of", "current_format")):
        raise JournalError(f"{label} has invalid string fields")
    if not all(type(raw[key]) is bool for key in ("disabled", "dpms")):
        raise JournalError(f"{label} has invalid boolean fields")
    if not isinstance(raw["color_state"], dict) or not isinstance(raw["advertised_modes"], list):
        raise JournalError(f"{label} has invalid collection fields")
    return MonitorState(
        raw["connector"], raw["monitor_id"], _identity_from_dict(raw["identity"], f"{label}.identity"),
        raw["width"], raw["height"], raw["refresh_millihz"], raw["x"], raw["y"],
        raw["scale_millionths"], raw["transform"], raw["disabled"], raw["dpms"],
        raw["mirror_of"], raw["current_format"], _json_value(raw["vrr"], f"{label}.vrr"),
        _json_value(raw["reserved"], f"{label}.reserved"),
        _json_value(raw["color_state"], f"{label}.color_state"),
        tuple(_mode_from_dict(mode, f"{label}.advertised_modes") for mode in raw["advertised_modes"]),
    )


def _file_from_dict(value: object, label: str) -> FileSnapshot:
    keys = {
        "path", "content_base64", "sha256", "mode", "uid", "gid",
        "device", "inode", "size", "mtime_ns",
    }
    raw = _strict_object(value, keys, label)
    if not all(isinstance(raw[key], str) for key in ("path", "content_base64", "sha256")):
        raise JournalError(f"{label} has invalid string fields")
    if not all(type(raw[key]) is int for key in keys - {"path", "content_base64", "sha256"}):
        raise JournalError(f"{label} has invalid integer fields")
    result = FileSnapshot(**raw)
    if hashlib.sha256(result.content).hexdigest() != result.sha256:
        raise JournalError(f"{label} content hash is invalid")
    return result


def journal_to_dict(journal: TransactionJournal) -> dict[str, object]:
    return asdict(journal)


def journal_from_dict(value: object) -> TransactionJournal:
    raw = _strict_object(value, JOURNAL_KEYS, "journal")
    if raw["schema_version"] != SCHEMA_VERSION:
        raise JournalError("unknown journal schema version")
    if raw["state"] not in KNOWN_STATES:
        raise JournalError("unknown journal state")
    for key in ("transaction_id", "state", "persistence_phase"):
        if not isinstance(raw[key], str):
            raise JournalError(f"journal.{key} has the wrong type")
    if raw["persistence_phase"] not in PERSISTENCE_PHASES:
        raise JournalError("unknown journal persistence phase")
    try:
        if str(uuid.UUID(raw["transaction_id"])) != raw["transaction_id"]:
            raise ValueError
    except ValueError as error:
        raise JournalError("journal.transaction_id is not a canonical UUID") from error
    for key in ("sequence",):
        if type(raw[key]) is not int:
            raise JournalError(f"journal.{key} has the wrong type")
    for key in ("created_monotonic", "updated_monotonic"):
        if isinstance(raw[key], bool) or not isinstance(raw[key], (int, float)):
            raise JournalError(f"journal.{key} has the wrong type")
    if raw["deadline_monotonic"] is not None and not isinstance(raw["deadline_monotonic"], (int, float)):
        raise JournalError("journal.deadline_monotonic has the wrong type")
    if raw["failure"] is not None and not isinstance(raw["failure"], str):
        raise JournalError("journal.failure has the wrong type")
    if raw["planned_machine_sha256"] is not None and not isinstance(raw["planned_machine_sha256"], str):
        raise JournalError("journal.planned_machine_sha256 has the wrong type")
    for key in ("mutation_attempted", "runtime_verified", "persistence_verified", "recovery_required"):
        if type(raw[key]) is not bool:
            raise JournalError(f"journal.{key} has the wrong type")
    instance_raw = _strict_object(
        raw["instance"],
        {"signature", "pid", "start_time_ticks", "executable_device", "executable_inode"},
        "journal.instance",
    )
    if not isinstance(instance_raw["signature"], str) or not all(
        type(instance_raw[key]) is int
        for key in ("pid", "start_time_ticks", "executable_device", "executable_inode")
    ):
        raise JournalError("journal.instance has invalid fields")
    if SIGNATURE_RE.fullmatch(instance_raw["signature"]) is None or instance_raw["pid"] <= 1:
        raise JournalError("journal.instance identity is invalid")
    candidate_raw = _strict_object(
        raw["candidate"],
        {
            "policy", "connector", "mode", "bitdepth", "scale_millionths",
            "hdr_mode", "automatic_hdr", "scale_automatic",
        },
        "journal.candidate",
    )
    if not all(isinstance(candidate_raw[key], str) for key in ("policy", "connector")):
        raise JournalError("journal.candidate has invalid fields")
    if candidate_raw["mode"] is not None and not isinstance(candidate_raw["mode"], dict):
        raise JournalError("journal.candidate.mode has the wrong type")
    if candidate_raw["bitdepth"] is not None and type(candidate_raw["bitdepth"]) is not int:
        raise JournalError("journal.candidate.bitdepth has the wrong type")
    if candidate_raw["scale_millionths"] is not None and type(candidate_raw["scale_millionths"]) is not int:
        raise JournalError("journal.candidate.scale_millionths has the wrong type")
    if type(candidate_raw["scale_automatic"]) is not bool:
        raise JournalError("journal.candidate.scale_automatic has the wrong type")
    if candidate_raw["hdr_mode"] is not None and candidate_raw["hdr_mode"] not in HDR_MODES:
        raise JournalError("journal.candidate HDR mode is invalid")
    if candidate_raw["automatic_hdr"] is not None and (
        type(candidate_raw["automatic_hdr"]) is not int
        or candidate_raw["automatic_hdr"] not in AUTO_HDR_VALUES
    ):
        raise JournalError("journal.candidate Automatic HDR value is invalid")
    if raw["bitdepth_intent"] is not None and (
        type(raw["bitdepth_intent"]) is not int
        or raw["bitdepth_intent"] not in BITDEPTH_FORMATS
    ):
        raise JournalError("journal bitdepth intent is invalid")
    if not isinstance(raw["cm_intent"], str) or not isinstance(raw["icc_intent"], str):
        raise JournalError("journal monitor intent has invalid fields")
    if type(raw["cm_present"]) is not bool or type(raw["forced_hdr"]) is not bool:
        raise JournalError("journal HDR base intent has invalid fields")
    if raw["automatic_hdr_intent"] is not None and (
        type(raw["automatic_hdr_intent"]) is not int
        or raw["automatic_hdr_intent"] not in AUTO_HDR_VALUES
    ):
        raise JournalError("journal Automatic HDR intent is invalid")
    if raw["automatic_hdr_explicit"] is not None and type(raw["automatic_hdr_explicit"]) is not bool:
        raise JournalError("journal Automatic HDR explicit state is invalid")
    snapshot_raw = _strict_object(raw["snapshot"], {"monitors"}, "journal.snapshot")
    if not isinstance(snapshot_raw["monitors"], list):
        raise JournalError("journal.snapshot.monitors is not an array")
    journal = TransactionJournal(
        raw["schema_version"], raw["transaction_id"], raw["state"], raw["sequence"],
        float(raw["created_monotonic"]), float(raw["updated_monotonic"]),
        None if raw["deadline_monotonic"] is None else float(raw["deadline_monotonic"]),
        raw["failure"], raw["mutation_attempted"], raw["runtime_verified"],
        raw["persistence_verified"], raw["recovery_required"], raw["planned_machine_sha256"],
        raw["persistence_phase"],
        InstanceIdentity(**instance_raw),
        _identity_from_dict(raw["target_identity"], "journal.target_identity"),
        Candidate(
            candidate_raw["policy"],
            candidate_raw["connector"],
            None if candidate_raw["mode"] is None else _mode_from_dict(candidate_raw["mode"], "journal.candidate.mode"),
            candidate_raw["bitdepth"],
            candidate_raw["scale_millionths"],
            candidate_raw["hdr_mode"],
            candidate_raw["automatic_hdr"],
            candidate_raw["scale_automatic"],
        ),
        raw["bitdepth_intent"],
        raw["cm_intent"],
        raw["icc_intent"],
        Topology(tuple(_monitor_from_dict(item, "journal.snapshot.monitor") for item in snapshot_raw["monitors"])),
        _file_from_dict(raw["machine_file"], "journal.machine_file"),
        _file_from_dict(raw["override_file"], "journal.override_file"),
        raw["cm_present"],
        raw["forced_hdr"],
        raw["automatic_hdr_intent"],
        raw["automatic_hdr_explicit"],
    )
    if journal.sequence < 0 or journal.created_monotonic < 0 or journal.updated_monotonic < 0:
        raise JournalError("journal counters or timestamps are invalid")
    if journal.candidate.connector != journal.target_identity.connector:
        raise JournalError("journal candidate and target identity disagree")
    if CONNECTOR_RE.fullmatch(journal.candidate.connector) is None:
        raise JournalError("journal candidate connector is invalid")
    if journal.candidate.policy == SAFE_CONFIRMED_POLICY:
        if (
            journal.candidate.mode is None
            and journal.candidate.bitdepth is None
            and journal.candidate.scale_millionths is None
            and not journal.candidate.scale_automatic
            and journal.candidate.hdr_mode is None
            and journal.candidate.automatic_hdr is None
        ):
            raise JournalError("safe-confirmed journal candidate is invalid")
        if journal.candidate.scale_millionths is not None:
            raise JournalError("safe-confirmed journal Scale is invalid")
        if journal.candidate.scale_automatic and journal.candidate.mode is None:
            raise JournalError("safe-confirmed automatic Scale lacks Mode")
        if journal.candidate.bitdepth is not None and journal.candidate.bitdepth not in BITDEPTH_FORMATS:
            raise JournalError("journal candidate bitdepth is invalid")
        if journal.candidate.bitdepth is not None and journal.bitdepth_intent is None:
            raise JournalError("bitdepth candidate lacks previous requested intent")
        if journal.candidate.automatic_hdr is not None and (
            journal.automatic_hdr_intent is None
            or journal.automatic_hdr_explicit is None
        ):
            raise JournalError("Automatic HDR candidate lacks previous intent")
    elif journal.candidate.policy == IMMEDIATE_SCALE_POLICY:
        if (
            journal.candidate.mode is not None
            or journal.candidate.bitdepth is not None
            or journal.candidate.scale_millionths is None
            or journal.candidate.scale_automatic
            or journal.candidate.hdr_mode is not None
            or journal.candidate.automatic_hdr is not None
        ):
            raise JournalError("immediate-scale journal candidate is invalid")
        try:
            scale_to_millionths(
                Decimal(journal.candidate.scale_millionths) / 1_000_000,
                preflight=True,
            )
        except ValidationError as error:
            raise JournalError("journal candidate scale is invalid") from error
    elif journal.candidate.policy == MATERIALIZE_POLICY:
        if (
            journal.candidate.mode is not None
            or journal.candidate.bitdepth is not None
            or journal.candidate.scale_millionths is not None
            or journal.candidate.scale_automatic
            or journal.candidate.hdr_mode is not None
            or journal.candidate.automatic_hdr is not None
        ):
            raise JournalError("materialization journal candidate is invalid")
        if journal.mutation_attempted or journal.deadline_monotonic is not None:
            raise JournalError("materialization journal contains a runtime mutation")
    else:
        raise JournalError("journal candidate policy is invalid")
    if journal.candidate.mode is not None and (
        journal.candidate.mode.width <= 0
        or journal.candidate.mode.height <= 0
        or journal.candidate.mode.refresh_millihz <= 0
    ):
        raise JournalError("journal candidate mode is invalid")
    try:
        snapshot_target = journal.snapshot.target(journal.candidate.connector)
    except ValidationError as error:
        raise JournalError("journal snapshot does not contain its target") from error
    if snapshot_target.identity != journal.target_identity:
        raise JournalError("journal target identity does not match its snapshot")
    final_hdr_mode = journal.candidate.hdr_mode or (
        "always-on" if journal.forced_hdr else "off"
    )
    final_bitdepth = (
        journal.candidate.bitdepth
        if journal.candidate.bitdepth is not None
        else snapshot_target.effective_bitdepth
    )
    if final_hdr_mode == "always-on" and final_bitdepth != 10:
        raise JournalError("forced-HDR journal candidate does not preserve 10-bit")
    try:
        if journal.candidate.policy == MATERIALIZE_POLICY:
            _, profile = validate_materialization_eligibility(
                journal.snapshot,
                journal.candidate.connector,
                journal.machine_file.content,
                journal.override_file.content,
                allow_serialless=True,
            )
        else:
            profile = require_explicit_profile(
                journal.machine_file.content, journal.candidate.connector
            )
        if profile_bitdepth_intent(profile) != journal.bitdepth_intent:
            raise JournalError("journal bitdepth intent does not match its machine snapshot")
        hdr_intent = profile_hdr_intent(profile)
        if profile_color_intent(profile) != (journal.cm_intent, journal.icc_intent):
            raise JournalError("journal monitor intent does not match its machine snapshot")
        if (
            hdr_intent.base_present != journal.cm_present
            or (hdr_intent.mode == "always-on") != journal.forced_hdr
        ):
            raise JournalError("journal forced-HDR intent does not match its machine snapshot")
        if journal.candidate.automatic_hdr is not None:
            previous_automatic = automatic_hdr_config_intent(
                journal.machine_file.content,
                journal.override_file.content,
                AutomaticHdrRuntime(
                    journal.automatic_hdr_intent,
                    journal.automatic_hdr_explicit,
                ),
            )
            if (
                previous_automatic.value != journal.automatic_hdr_intent
                or previous_automatic.explicitly_set
                    != journal.automatic_hdr_explicit
            ):
                raise JournalError("journal Automatic HDR intent is inconsistent")
    except ValidationError as error:
        raise JournalError("journal machine profile is invalid") from error
    if not Path(journal.machine_file.path).is_absolute() or not Path(journal.override_file.path).is_absolute():
        raise JournalError("journal configuration paths must be absolute")
    if journal.machine_file.mode & 0o077 or journal.override_file.mode & 0o077:
        raise JournalError("journal configuration metadata is not private")
    if not journal.snapshot.monitors:
        raise JournalError("journal snapshot has no monitors")
    try:
        journal.snapshot.by_connector()
    except ValidationError as error:
        raise JournalError("journal snapshot connector inventory is invalid") from error
    if not journal.target_identity.has_evidence():
        raise JournalError("journal target has no physical identity evidence")
    if journal.machine_file.uid != os.getuid() or journal.override_file.uid != os.getuid():
        raise JournalError("journal configuration ownership is invalid")
    if any(
        re.fullmatch(r"[0-9a-f]{64}", file_snapshot.sha256) is None
        for file_snapshot in (journal.machine_file, journal.override_file)
    ):
        raise JournalError("journal configuration hash is invalid")
    if journal.deadline_monotonic is not None and journal.state != "temporary-active":
        raise JournalError("journal deadline exists outside temporary-active")
    if journal.state == "temporary-active" and (
        journal.deadline_monotonic is None
        or not journal.candidate.requires_confirmation
        or not journal.runtime_verified
        or not journal.mutation_attempted
        or not journal.recovery_required
    ):
        raise JournalError("temporary-active journal invariants are invalid")
    if journal.candidate.policy == MATERIALIZE_POLICY and journal.state in {
        "applying", "temporary-active"
    }:
        raise JournalError("materialization journal entered a runtime apply state")
    if journal.state == "committed" and (
        not journal.runtime_verified
        or not journal.persistence_verified
        or journal.recovery_required
        or journal.persistence_phase != "candidate-verified"
    ):
        raise JournalError("committed journal invariants are invalid")
    if journal.state == "reverted" and (
        not journal.runtime_verified
        or journal.recovery_required
        or journal.persistence_phase not in {
            "original", "original-restored", "original-reloaded"
        }
    ):
        raise JournalError("reverted journal invariants are invalid")
    if journal.state == "instance-vanished" and (
        journal.recovery_required
        or journal.persistence_phase not in {
            "original", "original-restored", "original-reloaded"
        }
    ):
        raise JournalError("instance-vanished journal invariants are invalid")
    if journal.state in {
        "preparing", "applying", "committing", "reverting", "rollback-failed"
    } and not journal.recovery_required:
        raise JournalError(f"{journal.state} journal is not recovery-armed")
    if journal.planned_machine_sha256 is None and journal.persistence_phase != "original":
        raise JournalError("journal persistence phase has no planned candidate")
    if journal.planned_machine_sha256 is not None and re.fullmatch(
        r"[0-9a-f]{64}", journal.planned_machine_sha256
    ) is None:
        raise JournalError("journal planned machine hash is invalid")
    if journal.persistence_verified and journal.persistence_phase != "candidate-verified":
        raise JournalError("journal persistence verification phase is invalid")
    if journal.state == "committing" and (
        journal.planned_machine_sha256 is None
        or journal.persistence_phase
        not in {
            "candidate-planned",
            "candidate-installed",
            "candidate-reloaded",
            "candidate-verified",
        }
    ):
        raise JournalError("committing journal persistence phase is invalid")
    if journal.state in {"preparing", "applying", "temporary-active"} and (
        journal.planned_machine_sha256 is not None
        or journal.persistence_phase != "original"
    ):
        raise JournalError("pre-commit journal persistence phase is invalid")
    return journal


class RuntimeStore:
    def __init__(self, runtime_root: Path) -> None:
        self.directory = runtime_root / "vanhyprarch" / RUNTIME_COMPONENT
        self.journal_path = self.directory / "transaction.json"
        self.lock_path = self.directory / "transaction.lock"
        self.socket_path = self.directory / "control.sock"
        self._lock_descriptor: int | None = None

    @staticmethod
    def _require_private_directory(path: Path) -> None:
        try:
            metadata = path.lstat()
        except OSError as error:
            raise JournalError(f"cannot inspect runtime directory {path}: {error}") from error
        if not stat.S_ISDIR(metadata.st_mode) or metadata.st_uid != os.getuid():
            raise JournalError(f"unsafe runtime directory {path}")
        if stat.S_IMODE(metadata.st_mode) & 0o077:
            raise JournalError(f"runtime directory {path} is not private")

    def prepare(self) -> None:
        runtime_root = self.directory.parents[1]
        self._require_private_directory(runtime_root)
        self.directory.parent.mkdir(mode=0o700, exist_ok=True)
        self.directory.mkdir(mode=0o700, exist_ok=True)
        self._require_private_directory(self.directory.parent)
        self._require_private_directory(self.directory)

    def _validate_existing(self) -> bool:
        runtime_root = self.directory.parents[1]
        try:
            runtime_root.lstat()
            self.directory.parent.lstat()
            self.directory.lstat()
        except FileNotFoundError:
            return False
        self._require_private_directory(runtime_root)
        self._require_private_directory(self.directory.parent)
        self._require_private_directory(self.directory)
        return True

    def acquire(self) -> None:
        self.prepare()
        if self._lock_descriptor is not None:
            return
        flags = os.O_RDWR | os.O_CREAT | os.O_CLOEXEC | os.O_NOFOLLOW
        try:
            descriptor = os.open(self.lock_path, flags, 0o600)
            os.fchmod(descriptor, 0o600)
            fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except (OSError, BlockingIOError) as error:
            try:
                os.close(descriptor)
            except (UnboundLocalError, OSError):
                pass
            raise ConcurrentTransaction("another monitor transaction owns the lock") from error
        self._lock_descriptor = descriptor

    def release(self) -> None:
        if self._lock_descriptor is not None:
            os.close(self._lock_descriptor)
            self._lock_descriptor = None

    def has_active_owner(self) -> bool:
        """Check the existing authority lock without creating or acquiring it."""
        try:
            descriptor = os.open(
                self.lock_path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW
            )
        except OSError:
            return False
        try:
            metadata = os.fstat(descriptor)
            if (
                not stat.S_ISREG(metadata.st_mode)
                or metadata.st_uid != os.getuid()
                or stat.S_IMODE(metadata.st_mode) != 0o600
            ):
                return False
            try:
                fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                return True
            return False
        except OSError:
            return False
        finally:
            os.close(descriptor)

    def write(self, journal: TransactionJournal) -> None:
        if self._lock_descriptor is None:
            raise JournalError("journal write requires the transaction lock")
        data = (
            json.dumps(journal_to_dict(journal), sort_keys=True, separators=(",", ":"))
            + "\n"
        ).encode("utf-8")
        atomic_replace(self.journal_path, data, 0o600)
        metadata = self.journal_path.stat()
        if stat.S_IMODE(metadata.st_mode) != 0o600 or metadata.st_uid != os.getuid():
            raise JournalError("journal permissions or ownership are unsafe")

    def read(self) -> TransactionJournal | None:
        if not self._validate_existing():
            return None
        try:
            if self.journal_path.is_symlink():
                raise JournalError("journal must not be a symlink")
            metadata = self.journal_path.stat()
            if not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != os.getuid():
                raise JournalError("journal is not a current-user regular file")
            if stat.S_IMODE(metadata.st_mode) != 0o600:
                raise JournalError("journal permissions are not 0600")
            payload = json.loads(self.journal_path.read_text(encoding="utf-8"))
        except FileNotFoundError:
            return None
        except (OSError, json.JSONDecodeError) as error:
            raise JournalError(f"cannot read transaction journal: {error}") from error
        return journal_from_dict(payload)


@dataclass(frozen=True)
class ConfigPaths:
    machine: Path
    override: Path


def default_config_paths(environment: Mapping[str, str] = os.environ) -> ConfigPaths:
    home = environment.get("HOME", "")
    if not home or not Path(home).is_absolute():
        raise ValidationError("HOME must be an absolute path")
    config_home_text = environment.get("XDG_CONFIG_HOME", str(Path(home) / ".config"))
    config_home = Path(config_home_text)
    if not config_home.is_absolute():
        raise ValidationError("XDG_CONFIG_HOME must be an absolute path")
    return ConfigPaths(
        config_home / "vanhyprarch/machine/hyprland.lua",
        config_home / "vanhyprarch/overrides/hyprland.lua",
    )


class TransactionAuthority:
    def __init__(
        self,
        store: RuntimeStore,
        instance_provider: InstanceProvider,
        config_paths: ConfigPaths,
        runner: Runner = run_command,
        clock: Clock | None = None,
        persister: Persister | None = None,
        reload_coordinator: ReloadCoordinator | None = None,
        reload_event_source: ReloadEventSource | None = None,
        confirmation_seconds: float = DEFAULT_CONFIRM_SECONDS,
        bound_signature: str | None = None,
        edid_reader: Callable[[MonitorState], bytes] = read_connector_edid,
    ) -> None:
        self.store = store
        self.instance_provider = instance_provider
        self.config_paths = config_paths
        self.runner = runner
        self.clock = clock or SystemClock()
        self.persister = persister or DisabledProductionPersister()
        self.reload_coordinator = reload_coordinator or DisabledReloadCoordinator()
        self.reload_event_source = reload_event_source or NullReloadEventSource()
        self.transaction_watch: ReloadWatch | None = None
        self.confirmation_seconds = confirmation_seconds
        self.bound_signature = bound_signature
        self.edid_reader = edid_reader

    def _client(self, journal: TransactionJournal) -> HyprlandClient:
        return HyprlandClient(
            journal.instance.signature,
            journal.instance,
            self.instance_provider,
            self.runner,
            self.clock,
        )

    def _write(self, journal: TransactionJournal) -> TransactionJournal:
        self.store.write(journal)
        return journal

    def _transition(self, journal: TransactionJournal, state: str, **changes: object) -> TransactionJournal:
        if state not in LEGAL_TRANSITIONS[journal.state]:
            raise JournalError(f"illegal transaction transition {journal.state} -> {state}")
        return self._write(
            replace(
                journal,
                state=state,
                sequence=journal.sequence + 1,
                updated_monotonic=self.clock.monotonic(),
                **changes,
            )
        )

    def _checkpoint(self, journal: TransactionJournal, **changes: object) -> TransactionJournal:
        """Durably publish a milestone without changing the top-level state."""
        return self._write(
            replace(
                journal,
                sequence=journal.sequence + 1,
                updated_monotonic=self.clock.monotonic(),
                **changes,
            )
        )

    def _close_transaction_watch(self) -> None:
        if self.transaction_watch is not None:
            self.transaction_watch.close()
            self.transaction_watch = None

    def _require_no_unexpected_reload(self, journal: TransactionJournal) -> None:
        eligible = journal.state in {"applying", "temporary-active"} or (
            journal.state == "committing"
            and journal.persistence_phase == "candidate-planned"
        ) or (
            journal.candidate.policy == MATERIALIZE_POLICY
            and journal.state == "preparing"
        )
        if eligible and self.transaction_watch is not None and self.transaction_watch.wait(0.0):
            raise ConfigReloadInvalidated(
                "unexpected Hyprland config reload invalidated the monitor transaction"
            )

    @staticmethod
    def _verify_candidate(journal: TransactionJournal, readback: Topology) -> None:
        if journal.candidate.policy == MATERIALIZE_POLICY:
            verify_rollback_readback(journal.snapshot, readback)
            return
        verify_candidate_readback(
            journal.snapshot,
            journal.candidate,
            readback,
            journal.target_identity,
            journal.cm_intent,
            journal.icc_intent,
            scale_compositor_owned=(
                TransactionAuthority._scale_is_compositor_owned(journal)
            ),
        )

    @staticmethod
    def _scale_is_compositor_owned(journal: TransactionJournal) -> bool:
        candidate = journal.candidate
        if candidate.scale_millionths is not None:
            return False
        if candidate.scale_automatic:
            return True
        profile = require_explicit_profile(
            journal.machine_file.content, candidate.connector
        )
        return profile_scale_is_automatic(journal.machine_file.content, profile)

    @staticmethod
    def _candidate_has_monitor_mutation(candidate: Candidate) -> bool:
        return any(
            value is not None
            for value in (
                candidate.mode,
                candidate.bitdepth,
                candidate.scale_millionths,
                candidate.hdr_mode,
                True if candidate.scale_automatic else None,
            )
        )

    @staticmethod
    def _candidate_cm_value(journal: TransactionJournal) -> str | None:
        if journal.candidate.hdr_mode == "always-on":
            return "hdr"
        if journal.candidate.hdr_mode == "off":
            return journal.cm_intent
        return None

    @staticmethod
    def _verify_global(journal: TransactionJournal, client: HyprlandClient) -> None:
        if journal.candidate.automatic_hdr is not None:
            client.verify_automatic_hdr(journal.candidate.automatic_hdr)

    @staticmethod
    def _rollback_candidate(journal: TransactionJournal) -> Candidate:
        original = journal.snapshot.target(journal.candidate.connector)
        if journal.candidate.policy == IMMEDIATE_SCALE_POLICY:
            return Candidate.scale(original.connector, Decimal(original.scale_millionths) / 1_000_000)
        bitdepth = None
        if journal.candidate.bitdepth is not None:
            bitdepth = journal.bitdepth_intent
            if bitdepth is None:
                raise RollbackError("snapshot requested bitdepth cannot be restored")
        previous_scale_automatic = False
        rollback_scale = None
        if journal.candidate.scale_automatic:
            profile = require_explicit_profile(
                journal.machine_file.content, journal.candidate.connector
            )
            previous_scale_automatic = profile_scale_is_automatic(
                journal.machine_file.content, profile
            )
            if not previous_scale_automatic:
                rollback_scale = original.scale_millionths
        return Candidate(
            SAFE_CONFIRMED_POLICY,
            original.connector,
            original.mode if journal.candidate.mode is not None else None,
            bitdepth,
            rollback_scale,
            (
                ("always-on" if journal.forced_hdr else "off")
                if journal.candidate.hdr_mode is not None else None
            ),
            journal.automatic_hdr_intent
            if journal.candidate.automatic_hdr is not None else None,
            previous_scale_automatic,
        )

    def begin(self, candidate: Candidate, signature: str) -> TransactionJournal:
        if self.bound_signature is not None and signature != self.bound_signature:
            raise ValidationError("requested Hyprland instance is not the service-bound instance")
        previous = self.store.read()
        if previous is not None and previous.state not in TERMINAL_SAFE_STATES:
            raise StaleTransaction("non-terminal monitor transaction requires recovery")
        instance = self.instance_provider.current(signature)
        client = HyprlandClient(signature, instance, self.instance_provider, self.runner, self.clock)
        topology = client.read_topology()
        target = validate_candidate(candidate, topology)
        machine = snapshot_file(self.config_paths.machine)
        override = snapshot_file(self.config_paths.override)
        if not has_explicit_profile(machine.content, candidate.connector):
            materialized = self.materialize(candidate.connector, signature)
            if materialized is None or materialized.state != "committed":
                reason = None if materialized is None else materialized.failure
                raise PersistenceError(
                    reason or "connector profile materialization did not commit"
                )
            instance = self.instance_provider.current(signature)
            client = HyprlandClient(
                signature, instance, self.instance_provider, self.runner, self.clock
            )
            topology = client.read_topology()
            target = validate_candidate(candidate, topology)
            machine = snapshot_file(self.config_paths.machine)
            override = snapshot_file(self.config_paths.override)
        profile = require_explicit_profile(machine.content, candidate.connector)
        reject_superseding_override(override.content, candidate.connector)
        rewrite_existing_profile(machine.content, candidate)
        bitdepth_intent = profile_bitdepth_intent(profile)
        cm_intent, icc_intent = profile_color_intent(profile)
        hdr_intent = profile_hdr_intent(profile)
        automatic_hdr_intent: int | None = None
        automatic_hdr_explicit: bool | None = None
        if candidate.hdr_mode is not None:
            if icc_intent:
                raise ValidationError("An ICC profile owns this output's color state.")
            if not client.read_cm_enabled():
                raise ValidationError("Hyprland color management is disabled.")
            capability = evaluate_hdr_capability(
                target, profile, self.edid_reader(target)
            )
            if not capability.available:
                raise ValidationError(capability.reason or "HDR is unavailable.")
            if candidate.hdr_mode == hdr_intent.mode:
                raise ValidationError("candidate HDR mode is already active")
        final_hdr_mode = candidate.hdr_mode or hdr_intent.mode
        final_bitdepth = candidate.bitdepth or target.effective_bitdepth
        if final_hdr_mode == "always-on" and final_bitdepth != 10:
            raise ValidationError(
                "Always On HDR requires selecting 10-bit Color Depth in the same Apply."
            )
        if candidate.automatic_hdr is not None:
            runtime_automatic = client.read_automatic_hdr()
            persistent_automatic = automatic_hdr_config_intent(
                machine.content, override.content, runtime_automatic
            )
            if candidate.automatic_hdr == persistent_automatic.value:
                raise ValidationError("candidate Automatic HDR policy is already active")
            automatic_hdr_intent = persistent_automatic.value
            automatic_hdr_explicit = persistent_automatic.explicitly_set
        rewrite_machine_configuration(machine.content, candidate)
        now = self.clock.monotonic()
        journal = self._write(
            TransactionJournal(
                SCHEMA_VERSION,
                str(uuid.uuid4()),
                "preparing",
                0,
                now,
                now,
                None,
                None,
                False,
                False,
                False,
                True,
                None,
                "original",
                instance,
                target.identity,
                candidate,
                bitdepth_intent,
                cm_intent,
                icc_intent,
                topology,
                machine,
                override,
                hdr_intent.base_present,
                hdr_intent.mode == "always-on",
                automatic_hdr_intent,
                automatic_hdr_explicit,
            )
        )
        try:
            self.transaction_watch = self.reload_event_source.arm(journal)
        except MonitorError as error:
            journal = replace(journal, failure=f"reload observation failed: {error}")
            self.store.write(journal)
            return self.rollback(journal.transaction_id, reason=journal.failure)
        journal = self._transition(journal, "applying", mutation_attempted=True)
        try:
            if self._candidate_has_monitor_mutation(candidate):
                client.apply(candidate, cm_value=self._candidate_cm_value(journal))
            if candidate.automatic_hdr is not None:
                client.apply_automatic_hdr(candidate.automatic_hdr)
            self._require_no_unexpected_reload(journal)
            client.read_until(lambda readback: self._verify_candidate(journal, readback))
            self._verify_global(journal, client)
            self._require_no_unexpected_reload(journal)
        except InstanceReplaced as error:
            self._close_transaction_watch()
            return self._transition(
                journal, "instance-vanished", failure=str(error), recovery_required=False
            )
        except MonitorError as error:
            journal = replace(journal, failure=f"apply/readback failed: {error}")
            self.store.write(journal)
            return self.rollback(journal.transaction_id, reason=journal.failure)
        if candidate.requires_confirmation:
            return self._transition(
                journal,
                "temporary-active",
                runtime_verified=True,
                deadline_monotonic=self.clock.monotonic() + self.confirmation_seconds,
                failure=None,
            )
        journal = self._checkpoint(journal, runtime_verified=True, failure=None)
        return self._commit(journal)

    def materialize(
        self, connector: str, signature: str
    ) -> TransactionJournal | None:
        if self.bound_signature is not None and signature != self.bound_signature:
            raise ValidationError("requested Hyprland instance is not the service-bound instance")
        previous = self.store.read()
        if previous is not None and previous.state not in TERMINAL_SAFE_STATES:
            raise StaleTransaction("non-terminal monitor transaction requires recovery")
        instance = self.instance_provider.current(signature)
        client = HyprlandClient(
            signature, instance, self.instance_provider, self.runner, self.clock
        )
        topology = client.read_topology()
        candidate = Candidate.materialize(connector)
        target = validate_candidate(candidate, topology)
        machine = snapshot_file(self.config_paths.machine)
        override = snapshot_file(self.config_paths.override)
        if has_explicit_profile(machine.content, connector):
            reject_superseding_override(override.content, connector)
            validate_explicit_profile_editability(machine.content, target)
            return None
        _, fallback = validate_materialization_eligibility(
            topology,
            connector,
            machine.content,
            override.content,
            allow_serialless=True,
        )
        bitdepth_intent = profile_bitdepth_intent(fallback)
        cm_intent, icc_intent = profile_color_intent(fallback)
        hdr_intent = profile_hdr_intent(fallback)
        now = self.clock.monotonic()
        journal = self._write(
            TransactionJournal(
                SCHEMA_VERSION,
                str(uuid.uuid4()),
                "preparing",
                0,
                now,
                now,
                None,
                None,
                False,
                False,
                False,
                True,
                None,
                "original",
                instance,
                target.identity,
                candidate,
                bitdepth_intent,
                cm_intent,
                icc_intent,
                topology,
                machine,
                override,
                hdr_intent.base_present,
                hdr_intent.mode == "always-on",
                None,
                None,
            )
        )
        try:
            self.transaction_watch = self.reload_event_source.arm(journal)
        except MonitorError as error:
            journal = replace(journal, failure=f"reload observation failed: {error}")
            self.store.write(journal)
            return self.rollback(journal.transaction_id, reason=journal.failure)
        return self._commit(journal)

    def status(self) -> TransactionJournal | None:
        journal = self.store.read()
        if journal is not None and journal.state in TERMINAL_SAFE_STATES:
            self._close_transaction_watch()
        if journal is not None:
            try:
                self._require_no_unexpected_reload(journal)
            except MonitorError as error:
                return self.rollback(journal.transaction_id, reason=str(error))
        if (
            journal is not None
            and journal.state == "temporary-active"
            and journal.deadline_monotonic is not None
            and self.clock.monotonic() >= journal.deadline_monotonic
        ):
            return self.rollback(journal.transaction_id, reason="confirmation deadline expired")
        return journal

    def rollback(self, transaction_id: str, *, reason: str = "manual revert") -> TransactionJournal:
        journal = self.store.read()
        if journal is None or journal.transaction_id != transaction_id:
            raise ValidationError("transaction ID does not match active journal")
        self._close_transaction_watch()
        if journal.state == "reverted":
            return journal
        if journal.state == "instance-vanished":
            return journal
        if journal.state == "committed":
            raise ValidationError("committed transaction cannot be reverted by recovery")
        if journal.state != "reverting":
            journal = self._transition(
                journal,
                "reverting",
                deadline_monotonic=None,
                failure=reason,
                recovery_required=True,
            )
        if journal.planned_machine_sha256 is not None:
            watch: ReloadWatch | None = None
            try:
                machine_state = self.persister.machine_state(journal)
                if machine_state == "external":
                    raise PersistenceError("machine file has an unrelated external edit")
                if machine_state == "candidate":
                    journal = self._checkpoint(journal, persistence_phase="restore-pending")
                    watch = self.reload_coordinator.arm(journal)
                    restored = self.persister.recover_original(journal)
                    if not restored:
                        raise PersistenceError("candidate machine file was not restored")
                    journal = self._checkpoint(
                        journal,
                        persistence_phase="original-restored",
                        persistence_verified=False,
                    )
                    client = self._client(journal)
                    self.reload_coordinator.reconcile(journal, client, watch)
                    journal = self._checkpoint(
                        journal, persistence_phase="original-reloaded"
                    )
                else:
                    journal = self._checkpoint(
                        journal,
                        persistence_phase="original",
                        persistence_verified=False,
                    )
            except InstanceReplaced as error:
                try:
                    restored_state = self.persister.machine_state(journal)
                except MonitorError as state_error:
                    return self._transition(
                        journal,
                        "rollback-failed",
                        failure=(
                            "persistence recovery lost bound instance and "
                            f"cannot verify the durable file: {state_error}"
                        ),
                        persistence_verified=False,
                        recovery_required=True,
                    )
                if restored_state == "original":
                    return self._transition(
                        journal,
                        "instance-vanished",
                        failure=str(error),
                        recovery_required=False,
                    )
                return self._transition(
                    journal,
                    "rollback-failed",
                    failure=f"persistence recovery lost bound instance: {error}",
                    persistence_verified=False,
                    recovery_required=True,
                )
            except MonitorError as error:
                return self._transition(
                    journal,
                    "rollback-failed",
                    failure=f"persistence recovery failed: {error}",
                    persistence_verified=False,
                    recovery_required=True,
                )
            finally:
                if watch is not None:
                    watch.close()
        if not journal.mutation_attempted:
            if journal.candidate.policy == MATERIALIZE_POLICY:
                try:
                    self._client(journal).read_until(
                        lambda readback: verify_rollback_readback(
                            journal.snapshot, readback
                        )
                    )
                except InstanceReplaced as error:
                    return self._transition(
                        journal,
                        "instance-vanished",
                        failure=str(error),
                        recovery_required=False,
                    )
                except MonitorError as error:
                    return self._transition(
                        journal,
                        "rollback-failed",
                        failure=f"rollback verification failed: {error}",
                        recovery_required=True,
                    )
            return self._transition(
                journal, "reverted", runtime_verified=True, recovery_required=False
            )
        try:
            client = self._client(journal)
            current = client.read_topology()
            current_target = current.target(journal.candidate.connector)
            if current_target.identity != journal.target_identity:
                raise RollbackError("connector now belongs to a different physical display")
            rollback_candidate = self._rollback_candidate(journal)
            if self._candidate_has_monitor_mutation(journal.candidate):
                client.apply(
                    rollback_candidate,
                    cm_value=(
                        "hdr" if journal.forced_hdr else journal.cm_intent
                    ) if journal.candidate.hdr_mode is not None else None,
                )
            if journal.candidate.automatic_hdr is not None:
                if journal.automatic_hdr_intent is None:
                    raise RollbackError("previous Automatic HDR value is unavailable")
                client.apply_automatic_hdr(journal.automatic_hdr_intent)
                client.verify_automatic_hdr(journal.automatic_hdr_intent)
            client.read_until(lambda readback: verify_rollback_readback(journal.snapshot, readback))
        except InstanceReplaced as error:
            return self._transition(
                journal, "instance-vanished", failure=str(error), recovery_required=False
            )
        except MonitorError as error:
            return self._transition(
                journal,
                "rollback-failed",
                failure=f"rollback failed: {error}",
                recovery_required=True,
            )
        return self._transition(
            journal,
            "reverted",
            runtime_verified=True,
            recovery_required=False,
            deadline_monotonic=None,
        )

    def confirm(self, transaction_id: str) -> TransactionJournal:
        journal = self.status()
        if journal is None or journal.transaction_id != transaction_id:
            raise ValidationError("transaction ID does not match active journal")
        if journal.state != "temporary-active":
            raise ValidationError(f"transaction cannot confirm from {journal.state}")
        if not journal.candidate.requires_confirmation:
            raise ValidationError("immediate scale transactions do not accept confirmation")
        return self._commit(journal)

    def _commit(self, journal: TransactionJournal) -> TransactionJournal:
        client = self._client(journal)
        watch: ReloadWatch | None = None
        try:
            client.read_until(lambda current: self._verify_candidate(journal, current))
            self._verify_global(journal, client)
            self._require_no_unexpected_reload(journal)
            content, planned_hash = self.persister.prepare(journal)
            self._require_no_unexpected_reload(journal)
            journal = self._transition(
                journal,
                "committing",
                planned_machine_sha256=planned_hash,
                persistence_phase="candidate-planned",
                deadline_monotonic=None,
            )
            self.persister.persist(
                journal,
                content,
                guard=lambda: self._require_no_unexpected_reload(journal),
            )
            journal = self._checkpoint(
                journal, persistence_phase="candidate-installed"
            )
            if self.persister.machine_state(journal) != "candidate":
                raise PersistenceError(
                    "candidate machine file ownership was lost before reload reconciliation"
                )
            self._close_transaction_watch()
            watch = self.reload_coordinator.arm(journal)
            self.reload_coordinator.reconcile(journal, client, watch)
            journal = self._checkpoint(
                journal, persistence_phase="candidate-reloaded"
            )
            client.read_until(lambda current: self._verify_candidate(journal, current))
            self._verify_global(journal, client)
            journal = self._checkpoint(
                journal,
                persistence_phase="candidate-verified",
                persistence_verified=True,
                runtime_verified=True,
            )
        except MonitorError as error:
            if journal.state in {"preparing", "applying", "temporary-active"}:
                journal = replace(journal, failure=f"persistence failed: {error}")
                self.store.write(journal)
            return self.rollback(journal.transaction_id, reason=f"persistence failed: {error}")
        finally:
            if watch is not None:
                watch.close()
        return self._transition(
            journal,
            "committed",
            runtime_verified=True,
            recovery_required=False,
            failure=None,
        )

    def recover(self) -> TransactionJournal | None:
        journal = self.store.read()
        if journal is None or journal.state in TERMINAL_SAFE_STATES:
            return journal
        return self.rollback(journal.transaction_id, reason="crash recovery")


def runtime_root(environment: Mapping[str, str] = os.environ) -> Path:
    value = environment.get("XDG_RUNTIME_DIR", "")
    path = Path(value)
    if not value or not path.is_absolute():
        raise ValidationError("XDG_RUNTIME_DIR must be an absolute path")
    return path


def build_production_authority(*, require_environment_signature: bool = True) -> TransactionAuthority:
    root = runtime_root()
    store = RuntimeStore(root)
    store.acquire()
    signature = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")
    if require_environment_signature and SIGNATURE_RE.fullmatch(signature) is None:
        store.release()
        raise ValidationError("HYPRLAND_INSTANCE_SIGNATURE is missing or invalid")
    paths = default_config_paths()
    config_home = paths.machine.parents[2]
    return TransactionAuthority(
        store,
        ProcInstanceProvider(root),
        paths,
        persister=MachineConfigPersister(SandboxedHyprlandVerifier(config_home)),
        reload_coordinator=HyprlandReloadCoordinator(root),
        reload_event_source=SocketReloadEventSource(root),
        bound_signature=signature if require_environment_signature else None,
    )


def protocol_request(value: object) -> tuple[str, dict[str, object]]:
    if not isinstance(value, dict) or value.get("version") != PROTOCOL_VERSION:
        raise ValidationError("unknown control protocol version")
    command = value.get("command")
    if command == "status":
        expected = {"version", "command"}
    elif command in {"confirm", "revert"}:
        expected = {"version", "command", "transaction_id"}
    elif command in {"begin", "scale"}:
        expected = {"version", "command", "candidate", "signature"}
    else:
        raise ValidationError("unknown control command")
    if set(value) != expected:
        raise ValidationError("control request contains missing or unknown fields")
    return command, value


def _status_payload(journal: TransactionJournal | None, clock: Clock) -> object:
    if journal is None:
        return {"state": "idle"}
    remaining = None
    if journal.deadline_monotonic is not None:
        remaining = max(0.0, journal.deadline_monotonic - clock.monotonic())
    candidate = journal.candidate
    return {
        "transaction_id": journal.transaction_id,
        "policy": journal.candidate.policy,
        "candidate": {
            "connector": candidate.connector,
            "mode": None
            if candidate.mode is None
            else {
                "width": candidate.mode.width,
                "height": candidate.mode.height,
                "refresh_millihz": candidate.mode.refresh_millihz,
            },
            "bitdepth": candidate.bitdepth,
            "scale_millionths": candidate.scale_millionths,
            "scale_automatic": candidate.scale_automatic,
            "hdr_mode": candidate.hdr_mode,
            "automatic_hdr": candidate.automatic_hdr,
        },
        "state": journal.state,
        "sequence": journal.sequence,
        "deadline_monotonic": journal.deadline_monotonic,
        "remaining_seconds": remaining,
        "failure": journal.failure,
        "recovery_required": journal.recovery_required,
    }


def verified_temporary_automatic_hdr_intent(
    store: RuntimeStore,
    instance_provider: InstanceProvider,
    instance: InstanceIdentity,
    paths: ConfigPaths,
    machine: FileSnapshot,
    override: FileSnapshot,
    runtime: AutomaticHdrRuntime,
    clock: Clock,
) -> AutomaticHdrRuntime | None:
    """Recognize only a live, unchanged Safe Apply awaiting confirmation."""
    try:
        journal = store.read()
    except MonitorError:
        return None
    if (
        journal is None
        or journal.state != "temporary-active"
        or journal.candidate.policy != SAFE_CONFIRMED_POLICY
        or journal.candidate.automatic_hdr is None
        or journal.candidate.automatic_hdr != runtime.value
        or not runtime.explicitly_set
        or journal.automatic_hdr_intent is None
        or journal.automatic_hdr_explicit is None
        or journal.candidate.automatic_hdr == journal.automatic_hdr_intent
        or journal.instance != instance
        or journal.deadline_monotonic is None
        or clock.monotonic() >= journal.deadline_monotonic
        or journal.persistence_phase != "original"
        or journal.failure is not None
        or journal.machine_file.path != str(paths.machine)
        or journal.override_file.path != str(paths.override)
        or journal.machine_file != machine
        or journal.override_file != override
        or not store.has_active_owner()
    ):
        return None
    try:
        if (
            not snapshot_matches(journal.machine_file)
            or not snapshot_matches(journal.override_file)
            or store.read() != journal
            or not store.has_active_owner()
            or instance_provider.current(instance.signature) != instance
            or clock.monotonic() >= journal.deadline_monotonic
        ):
            return None
    except MonitorError:
        return None
    return AutomaticHdrRuntime(
        journal.automatic_hdr_intent, journal.automatic_hdr_explicit
    )


def inspect_command(
    environment: Mapping[str, str] = os.environ,
    runner: Runner = run_command,
    instance_provider: InstanceProvider | None = None,
    config_paths: ConfigPaths | None = None,
    edid_reader: Callable[[MonitorState], bytes] = read_connector_edid,
    clock: Clock | None = None,
) -> int:
    signature = environment.get("HYPRLAND_INSTANCE_SIGNATURE", "")
    if SIGNATURE_RE.fullmatch(signature) is None:
        raise ValidationError("HYPRLAND_INSTANCE_SIGNATURE is missing or invalid")
    root = runtime_root(environment)
    provider = instance_provider or ProcInstanceProvider(root)
    instance = provider.current(signature)
    client = HyprlandClient(signature, instance, provider, runner=runner)
    topology = client.read_topology()
    automatic_hdr = client.read_automatic_hdr()
    cm_enabled = client.read_cm_enabled()
    paths = config_paths or default_config_paths(environment)
    machine = snapshot_file(paths.machine)
    override = snapshot_file(paths.override)
    temporary_automatic_hdr_intent = verified_temporary_automatic_hdr_intent(
        RuntimeStore(root), provider, instance, paths, machine, override,
        automatic_hdr, clock or SystemClock(),
    )
    payload = inspection_payload(
        topology,
        machine.content,
        override.content,
        signature,
        automatic_hdr,
        cm_enabled,
        edid_reader,
        temporary_automatic_hdr_intent,
    )
    print(json.dumps(payload, sort_keys=True, separators=(",", ":")))
    return 0


def handle_control(authority: TransactionAuthority, request: object) -> dict[str, object]:
    command, raw = protocol_request(request)
    if command == "status":
        journal = authority.status()
    elif command == "begin":
        candidate_raw = _strict_object(
            raw["candidate"],
            {"connector", "mode", "bitdepth", "scale", "hdr_mode", "automatic_hdr"},
            "candidate",
        )
        mode_raw = candidate_raw["mode"]
        if mode_raw is None:
            mode_fields: dict[str, object | None] = {
                "width": None, "height": None, "refresh": None
            }
        else:
            mode_fields = _strict_object(
                mode_raw, {"width", "height", "refresh"}, "candidate.mode"
            )
        journal = authority.begin(
            Candidate.safe(
                candidate_raw["connector"],
                width=mode_fields["width"],
                height=mode_fields["height"],
                refresh=mode_fields["refresh"],
                bitdepth=candidate_raw["bitdepth"],
                scale=candidate_raw["scale"],
                hdr_mode=candidate_raw["hdr_mode"],
                automatic_hdr=candidate_raw["automatic_hdr"],
            ),
            raw["signature"],
        )
    elif command == "scale":
        candidate_raw = _strict_object(
            raw["candidate"], {"connector", "scale"}, "candidate"
        )
        journal = authority.begin(
            Candidate.scale(candidate_raw["connector"], candidate_raw["scale"]),
            raw["signature"],
        )
    elif command == "confirm":
        journal = authority.confirm(raw["transaction_id"])
    else:
        journal = authority.rollback(raw["transaction_id"])
    return {"version": PROTOCOL_VERSION, "ok": True, "status": _status_payload(journal, authority.clock)}


def serve() -> int:
    authority = build_production_authority()
    store = authority.store
    server: socket.socket | None = None
    selector: selectors.BaseSelector | None = None
    try:
        stale = store.read()
        if stale is not None and stale.state not in TERMINAL_SAFE_STATES:
            recovered = authority.recover()
            if recovered is not None and recovered.recovery_required:
                raise RollbackError(recovered.failure or "stale transaction recovery failed")
        try:
            store.socket_path.unlink()
        except FileNotFoundError:
            pass
        server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        server.bind(os.fspath(store.socket_path))
        os.chmod(store.socket_path, 0o600)
        server.listen(4)
        server.setblocking(False)
        selector = selectors.DefaultSelector()
        selector.register(server, selectors.EVENT_READ)
        idle_deadline = authority.clock.monotonic() + 15.0
        served_transaction_id: str | None = None
        while True:
            journal = authority.status()
            if (
                journal is not None
                and served_transaction_id == journal.transaction_id
                and journal.state in TERMINAL_SAFE_STATES
            ):
                return 0
            if served_transaction_id is None and authority.clock.monotonic() >= idle_deadline:
                return 0
            timeout = 0.25
            if journal is not None and journal.deadline_monotonic is not None:
                timeout = max(0.0, min(timeout, journal.deadline_monotonic - authority.clock.monotonic()))
            for key, _ in selector.select(timeout):
                connection, _ = key.fileobj.accept()
                with connection:
                    connection.settimeout(2.0)
                    data = b""
                    while b"\n" not in data and len(data) <= 65536:
                        chunk = connection.recv(4096)
                        if not chunk:
                            break
                        data += chunk
                    request: object = None
                    try:
                        if len(data) > 65536 or b"\n" not in data:
                            raise ValidationError("invalid control request framing")
                        request = json.loads(data.split(b"\n", 1)[0])
                        response = handle_control(authority, request)
                        if (
                            isinstance(request, dict)
                            and request.get("command") in {"begin", "scale"}
                            and response.get("ok") is True
                        ):
                            status = response.get("status")
                            if isinstance(status, dict):
                                transaction_id = status.get("transaction_id")
                                if isinstance(transaction_id, str):
                                    served_transaction_id = transaction_id
                    except (MonitorError, json.JSONDecodeError) as error:
                        response = {"version": PROTOCOL_VERSION, "ok": False, "error": str(error)}
                    connection.sendall((json.dumps(response, separators=(",", ":")) + "\n").encode("utf-8"))
                    if (
                        isinstance(request, dict)
                        and request.get("command") in {"begin", "scale"}
                        and response.get("ok") is False
                    ):
                        return 1
    finally:
        if selector is not None:
            selector.close()
        if server is not None:
            server.close()
        try:
            store.socket_path.unlink()
        except FileNotFoundError:
            pass
        store.release()


def recover_command() -> int:
    authority = build_production_authority(require_environment_signature=False)
    try:
        journal = authority.recover()
        if journal is not None and journal.recovery_required:
            print(journal.failure or "monitor recovery failed", file=sys.stderr)
            return 1
        return 0
    finally:
        try:
            authority.store.socket_path.unlink()
        except FileNotFoundError:
            pass
        authority.store.release()


def send_control(request: dict[str, object]) -> dict[str, object]:
    path = RuntimeStore(runtime_root()).socket_path
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
        client.settimeout(3.0)
        client.connect(os.fspath(path))
        client.sendall((json.dumps(request, separators=(",", ":")) + "\n").encode("utf-8"))
        response = b""
        while b"\n" not in response and len(response) <= 65536:
            chunk = client.recv(4096)
            if not chunk:
                break
            response += chunk
    if b"\n" not in response:
        raise MonitorError("monitor authority returned an incomplete response")
    value = json.loads(response.split(b"\n", 1)[0])
    if not isinstance(value, dict) or value.get("version") != PROTOCOL_VERSION:
        raise MonitorError("monitor authority returned an invalid response")
    return value


def local_status_response(*, require_safe_terminal: bool = False) -> dict[str, object]:
    journal = RuntimeStore(runtime_root()).read()
    if require_safe_terminal and (
        journal is None
        or journal.state not in TERMINAL_SAFE_STATES
        or journal.recovery_required
    ):
        raise MonitorError(
            "monitor authority reset the status connection before publishing "
            "a recovery-disarmed terminal state"
        )
    return {
        "version": PROTOCOL_VERSION,
        "ok": True,
        "status": _status_payload(journal, SystemClock()),
    }


def client_command(arguments: argparse.Namespace) -> int:
    if arguments.action in {"apply", "scale"}:
        result = run_command([SYSTEMCTL, "--user", "start", SERVICE_NAME])
        if result.returncode != 0:
            raise MonitorError(result.stderr.strip() or "could not start monitor authority")
        if arguments.action == "apply":
            mode = None
            if any(value is not None for value in (arguments.width, arguments.height, arguments.refresh)):
                mode = {
                    "width": arguments.width,
                    "height": arguments.height,
                    "refresh": arguments.refresh,
                }
            request = {
                "version": PROTOCOL_VERSION,
                "command": "begin",
                "signature": os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", ""),
                "candidate": {
                    "connector": arguments.connector,
                    "mode": mode,
                    "bitdepth": arguments.bitdepth,
                    "scale": arguments.scale,
                    "hdr_mode": arguments.hdr,
                    "automatic_hdr": arguments.automatic_hdr,
                },
            }
        elif arguments.action == "scale":
            request = {
                "version": PROTOCOL_VERSION,
                "command": "scale",
                "signature": os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", ""),
                "candidate": {
                    "connector": arguments.connector,
                    "scale": arguments.scale,
                },
            }
        deadline = time.monotonic() + 3.0
        while True:
            try:
                response = send_control(request)
                break
            except (FileNotFoundError, ConnectionRefusedError):
                if time.monotonic() >= deadline:
                    raise MonitorError("monitor authority socket did not become ready")
                time.sleep(0.05)
    else:
        request = {"version": PROTOCOL_VERSION, "command": arguments.action}
        if arguments.action in {"confirm", "revert"}:
            request["transaction_id"] = arguments.transaction_id
        try:
            response = send_control(request)
        except ConnectionResetError:
            if arguments.action != "status":
                raise
            response = local_status_response(require_safe_terminal=True)
        except (FileNotFoundError, ConnectionRefusedError):
            if arguments.action != "status":
                raise
            response = local_status_response()
    print(json.dumps(response, sort_keys=True))
    return 0 if response.get("ok") is True else 1


def argument_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    subparsers = parser.add_subparsers(dest="action", required=True)
    subparsers.add_parser("serve", help="run the systemd-supervised authority")
    subparsers.add_parser("recover", help="run one idempotent recovery pass")
    subparsers.add_parser("status", help="read authoritative transaction status")
    subparsers.add_parser(
        "inspect", help="read normalized monitor capabilities without mutation"
    )
    apply_parser = subparsers.add_parser(
        "apply", help="request one confirmed Mode/Scale/bitdepth/HDR candidate"
    )
    apply_parser.add_argument("--connector", required=True)
    apply_parser.add_argument("--width", type=int)
    apply_parser.add_argument("--height", type=int)
    apply_parser.add_argument("--refresh")
    apply_parser.add_argument("--bitdepth", type=int, choices=(8, 10))
    apply_parser.add_argument("--scale")
    apply_parser.add_argument("--hdr", choices=tuple(sorted(HDR_MODES)))
    apply_parser.add_argument("--automatic-hdr", type=int, choices=(0, 1, 2))
    scale_parser = subparsers.add_parser("scale", help="apply and persist validated scale immediately")
    scale_parser.add_argument("--connector", required=True)
    scale_parser.add_argument("--scale", required=True)
    for action in ("confirm", "revert"):
        action_parser = subparsers.add_parser(action)
        action_parser.add_argument("transaction_id")
    return parser


def main() -> int:
    arguments = argument_parser().parse_args()
    try:
        if arguments.action == "serve":
            return serve()
        if arguments.action == "recover":
            return recover_command()
        if arguments.action == "inspect":
            return inspect_command()
        return client_command(arguments)
    except (MonitorError, OSError, json.JSONDecodeError) as error:
        print(f"vanhyprarch-monitor: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
