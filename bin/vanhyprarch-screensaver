#!/bin/sh

set -fu

program_name=${0##*/}
runtime_subdir=vanhyprarch
state_name=screensaver.state
cursor_state_name=screensaver.cursor
lock_name=screensaver.lock
log_name=screensaver.log
start_attempts=40
stop_attempts=30
poll_delay=0.05
manual_test_seconds=5

usage()
{
    printf 'Usage: %s {start --idle|resume-lock|test|stop|status|component-status --json|component-capability|install|adopt|reinstall|repair|uninstall --plan-token TOKEN|uninstall-plan --json|clean-up}\n' "$program_name" >&2
}

fail()
{
    printf '%s: %s\n' "$program_name" "$*" >&2
    exit 1
}

is_unsigned_integer()
{
    case ${1-} in
        ''|*[!0-9]*) return 1 ;;
        *) return 0 ;;
    esac
}

valid_effect()
{
    case ${1-} in
        colormix|matrix|doom|gameoflife) return 0 ;;
        *) return 1 ;;
    esac
}

prepare_runtime()
{
    [ -n "${XDG_RUNTIME_DIR:-}" ] ||
        fail 'XDG_RUNTIME_DIR is not set'
    case $XDG_RUNTIME_DIR in
        /*) ;;
        *) fail 'XDG_RUNTIME_DIR must be an absolute path' ;;
    esac
    [ -d "$XDG_RUNTIME_DIR" ] ||
        fail 'XDG_RUNTIME_DIR is not a directory'

    runtime_dir=$XDG_RUNTIME_DIR/$runtime_subdir
    umask 077
    [ ! -L "$runtime_dir" ] ||
        fail "$runtime_dir must not be a symbolic link"
    if [ ! -d "$runtime_dir" ]; then
        mkdir -m 700 -- "$runtime_dir" ||
            fail "could not create $runtime_dir"
    fi

    current_uid=$(id -u) || fail 'could not determine the current user ID'
    runtime_owner=$(stat -c '%u' -- "$runtime_dir") ||
        fail "could not inspect $runtime_dir"
    [ "$runtime_owner" = "$current_uid" ] ||
        fail "$runtime_dir is not owned by the current user"
    chmod 700 -- "$runtime_dir" || fail "could not secure $runtime_dir"

    state_file=$runtime_dir/$state_name
    cursor_state_file=$runtime_dir/$cursor_state_name
    lock_file=$runtime_dir/$lock_name
    log_file=$runtime_dir/$log_name

    validate_runtime_regular "$lock_file" 'screensaver lock'
    exec 9>>"$lock_file" || fail "could not open $lock_file"
    [ "$(stat -c '%u' -- "$lock_file" 2>/dev/null)" = "$current_uid" ] &&
        [ -f "$lock_file" ] && [ ! -L "$lock_file" ] ||
        fail "$lock_file is unsafe"
    chmod 600 -- "$lock_file" || fail "could not secure $lock_file"
    flock -x 9 || fail "could not lock $lock_file"
}

validate_runtime_regular()
{
    inspected_path=$1
    inspected_label=$2
    [ ! -L "$inspected_path" ] || fail "$inspected_label must not be a symbolic link"
    if [ -e "$inspected_path" ]; then
        [ -f "$inspected_path" ] || fail "$inspected_label must be a regular file"
        [ "$(stat -c '%u' -- "$inspected_path" 2>/dev/null)" = "$current_uid" ] ||
            fail "$inspected_label is not owned by the current user"
    fi
}

state_path_exists()
{
    [ -e "$state_file" ] || [ -L "$state_file" ]
}

cursor_state_path_exists()
{
    [ -e "$cursor_state_file" ] || [ -L "$cursor_state_file" ]
}

remove_state()
{
    [ ! -d "$state_file" ] || [ -L "$state_file" ] ||
        fail "$state_file is unexpectedly a directory"
    rm -f -- "$state_file" || fail "could not remove $state_file"
}

remove_cursor_state()
{
    [ ! -d "$cursor_state_file" ] || [ -L "$cursor_state_file" ] ||
        fail "$cursor_state_file is unexpectedly a directory"
    rm -f -- "$cursor_state_file" ||
        fail "could not remove $cursor_state_file"
}

load_state()
{
    [ -f "$state_file" ] || return 1
    [ ! -L "$state_file" ] || return 1
    [ "$(stat -c '%u' -- "$state_file" 2>/dev/null)" = "$current_uid" ] ||
        return 1

    state_version=
    state_pid=
    state_start_time=
    state_executable=
    state_effect=
    state_protected=off
    seen_version=false
    seen_pid=false
    seen_start_time=false
    seen_executable=false
    seen_effect=false
    seen_protected=false

    while IFS= read -r state_line || [ -n "$state_line" ]; do
        state_key=${state_line%%=*}
        state_value=${state_line#*=}
        [ "$state_key" != "$state_line" ] || return 1
        case $state_key in
            version)
                [ "$seen_version" = false ] || return 1
                seen_version=true
                state_version=$state_value
                ;;
            pid)
                [ "$seen_pid" = false ] || return 1
                seen_pid=true
                state_pid=$state_value
                ;;
            start_time)
                [ "$seen_start_time" = false ] || return 1
                seen_start_time=true
                state_start_time=$state_value
                ;;
            executable)
                [ "$seen_executable" = false ] || return 1
                seen_executable=true
                state_executable=$state_value
                ;;
            effect)
                [ "$seen_effect" = false ] || return 1
                seen_effect=true
                state_effect=$state_value
                ;;
            protected)
                [ "$seen_protected" = false ] || return 1
                seen_protected=true
                state_protected=$state_value
                ;;
            *) return 1 ;;
        esac
    done < "$state_file"

    [ "$seen_version" = true ] && [ "$state_version" = 1 ] &&
        [ "$seen_pid" = true ] && [ "$seen_start_time" = true ] &&
        [ "$seen_executable" = true ] && [ "$seen_effect" = true ] ||
        return 1
    is_unsigned_integer "$state_pid" && [ "$state_pid" -gt 1 ] || return 1
    is_unsigned_integer "$state_start_time" || return 1
    case $state_executable in /*) ;; *) return 1 ;; esac
    case $state_protected in on|off) ;; *) return 1 ;; esac
    valid_effect "$state_effect"
}

load_cursor_state()
{
    [ -f "$cursor_state_file" ] || return 1
    [ ! -L "$cursor_state_file" ] || return 1
    [ "$(stat -c '%u' -- "$cursor_state_file" 2>/dev/null)" = "$current_uid" ] ||
        return 1

    saved_cursor_invisible=
    cursor_state_extra=
    {
        IFS= read -r saved_cursor_invisible || return 1
        if IFS= read -r cursor_state_extra || [ -n "$cursor_state_extra" ]; then
            return 1
        fi
    } < "$cursor_state_file"
    case $saved_cursor_invisible in true|false) ;; *) return 1 ;; esac
}

read_process_snapshot()
{
    snapshot_pid=$1
    [ -r "/proc/$snapshot_pid/stat" ] || return 1
    IFS= read -r process_stat < "/proc/$snapshot_pid/stat" || return 1
    process_tail=${process_stat##*) }
    [ "$process_tail" != "$process_stat" ] || return 1
    set -- $process_tail
    [ "$#" -ge 20 ] || return 1
    snapshot_state=$1
    snapshot_start_time=${20}
    case $snapshot_state in Z|X|x) return 1 ;; esac
    is_unsigned_integer "$snapshot_start_time"
}

process_arguments_match()
{
    argument_pid=$1
    argument_executable=$2
    argument_effect=$3
    [ -r "/proc/$argument_pid/cmdline" ] || return 1
    argument_count=$(tr '\000' '\n' < "/proc/$argument_pid/cmdline" |
        wc -l) || return 1
    [ "$argument_count" -eq 2 ] || return 1
    argument_zero=$(tr '\000' '\n' < "/proc/$argument_pid/cmdline" |
        sed -n '1p') || return 1
    argument_one=$(tr '\000' '\n' < "/proc/$argument_pid/cmdline" |
        sed -n '2p') || return 1
    [ "$argument_zero" = "$argument_executable" ] &&
        [ "$argument_one" = "$argument_effect" ]
}

process_matches()
{
    inspected_pid=$1
    expected_start_time=$2
    expected_executable=$3
    expected_effect=$4
    [ "$(stat -c '%u' -- "/proc/$inspected_pid" 2>/dev/null)" = "$current_uid" ] ||
        return 1
    read_process_snapshot "$inspected_pid" || return 1
    [ "$snapshot_start_time" = "$expected_start_time" ] || return 1
    observed_executable=$(readlink "/proc/$inspected_pid/exe" 2>/dev/null) ||
        return 1
    [ "$observed_executable" = "$expected_executable" ] || return 1
    process_arguments_match "$inspected_pid" "$expected_executable" \
        "$expected_effect"
}

owned_process_is_running()
{
    load_state || return 1
    process_matches "$state_pid" "$state_start_time" "$state_executable" \
        "$state_effect"
}

resolve_hyprctl()
{
    hyprctl_executable=$(command -v hyprctl 2>/dev/null) || return 1
}

read_cursor_invisible()
{
    cursor_invisible=$(
        "$hyprctl_executable" getoption cursor:invisible 2>/dev/null |
            sed -n 's/^bool: //p'
    ) || return 1
    case $cursor_invisible in true|false) ;; *) return 1 ;; esac
}

set_cursor_invisible()
{
    requested_cursor_invisible=$1
    case $requested_cursor_invisible in true|false) ;; *) return 1 ;; esac
    "$hyprctl_executable" eval \
        "hl.config({ cursor = { invisible = $requested_cursor_invisible } })" \
        >/dev/null 2>&1 || return 1
    read_cursor_invisible || return 1
    [ "$cursor_invisible" = "$requested_cursor_invisible" ]
}

write_cursor_state()
{
    cursor_state_temporary=$runtime_dir/$cursor_state_name.$$
    rm -f -- "$cursor_state_temporary" || return 1
    printf '%s\n' "$cursor_invisible" > "$cursor_state_temporary" &&
        chmod 600 -- "$cursor_state_temporary" &&
        mv -f -- "$cursor_state_temporary" "$cursor_state_file"
}

restore_cursor_state()
{
    cursor_state_path_exists || return 0
    load_cursor_state ||
        fail "invalid cursor ownership state in $cursor_state_file"
    resolve_hyprctl || fail 'hyprctl is not installed or not on PATH'
    set_cursor_invisible "$saved_cursor_invisible" ||
        fail "could not restore cursor:invisible=$saved_cursor_invisible"
    remove_cursor_state
}

try_restore_cursor_state()
{
    cursor_state_path_exists || return 0
    load_cursor_state || return 1
    resolve_hyprctl || return 1
    set_cursor_invisible "$saved_cursor_invisible" || return 1
    remove_cursor_state
}

resolve_component_manager()
{
    if [ "${VANHYPRARCH_ALLOW_TEST_OVERRIDES:-}" = 1 ] &&
        [ -n "${VANHYPRARCH_ZIG_SCREENSAVER_MANAGER:-}" ]; then
        component_manager=$VANHYPRARCH_ZIG_SCREENSAVER_MANAGER
    else
        data_home=${XDG_DATA_HOME:-${HOME:?HOME is not set}/.local/share}
        case $data_home in /*) ;; *) fail 'XDG_DATA_HOME must be absolute' ;; esac
        component_manager=$data_home/vanhyprarch/zig-screensaver/manager.py
        if [ ! -f "$component_manager" ]; then
            controller_source=$(readlink -f -- "$0" 2>/dev/null || printf '%s' "$0")
            source_root=$(dirname -- "$(dirname -- "$controller_source")")
            source_manager=$source_root/install/zig-screensaver/manager.py
            if [ -e "$source_root/.git" ] && [ -f "$source_manager" ]; then
                component_manager=$source_manager
            fi
        fi
    fi
    [ -f "$component_manager" ] && [ ! -L "$component_manager" ] ||
        fail 'Zig Screensaver manager resources are unavailable'
}

component_command()
{
    resolve_component_manager
    [ -x "$component_manager" ] || fail 'Zig Screensaver manager is not executable'
    exec "$component_manager" "$@"
}

require_component_capability()
{
    resolve_component_manager
    [ -x "$component_manager" ] || fail 'Zig Screensaver manager is not executable'
    component_capability=$(
        "$component_manager" component-capability 2>/dev/null
    ) || fail 'could not validate the Zig Screensaver component'
    [ "$component_capability" = installed ] ||
        fail "Zig Screensaver capability is $component_capability"
}

resolve_effect()
{
    idle_executable=$(command -v vanhyprarch-idle 2>/dev/null) ||
        fail 'vanhyprarch-idle is not installed or not on PATH'
    selected_effect=$("$idle_executable" screensaver-effect 2>/dev/null) ||
        fail 'could not read the configured screensaver effect'
    valid_effect "$selected_effect" ||
        fail "invalid configured screensaver effect: $selected_effect"
}

resolve_player()
{
    player_command=$(command -v vanhyprarch-zig-player 2>/dev/null) ||
        fail 'vanhyprarch-zig-player is not installed or not on PATH'
    if [ "${VANHYPRARCH_ALLOW_TEST_OVERRIDES:-}" != 1 ]; then
        expected_player=${HOME:?HOME is not set}/.local/bin/vanhyprarch-zig-player
        [ "$player_command" = "$expected_player" ] && [ ! -L "$player_command" ] ||
            fail 'vanhyprarch-zig-player did not resolve to the managed user-local payload'
    fi
    player_executable=$(readlink -f -- "$player_command" 2>/dev/null) ||
        fail 'could not resolve vanhyprarch-zig-player'
    [ -f "$player_executable" ] && [ -x "$player_executable" ] ||
        fail "$player_executable is not an executable regular file"
    [ "$(stat -c '%u' -- "$player_executable" 2>/dev/null)" = "$(id -u)" ] ||
        fail "$player_executable is not owned by the current user"
}

write_state()
{
    state_temporary=$runtime_dir/$state_name.$$
    rm -f -- "$state_temporary" || return 1
    {
        printf 'version=1\n'
        printf 'pid=%s\n' "$launch_pid"
        printf 'start_time=%s\n' "$launch_start_time"
        printf 'executable=%s\n' "$player_executable"
        printf 'effect=%s\n' "$selected_effect"
        printf 'protected=%s\n' "$launch_protected"
    } > "$state_temporary" &&
        chmod 600 -- "$state_temporary" &&
        mv -f -- "$state_temporary" "$state_file"
}

write_loaded_state_protection()
{
    requested_protection=$1
    case $requested_protection in on|off) ;; *) return 1 ;; esac
    state_temporary=$runtime_dir/$state_name.$$
    rm -f -- "$state_temporary" || return 1
    {
        printf 'version=1\n'
        printf 'pid=%s\n' "$state_pid"
        printf 'start_time=%s\n' "$state_start_time"
        printf 'executable=%s\n' "$state_executable"
        printf 'effect=%s\n' "$state_effect"
        printf 'protected=%s\n' "$requested_protection"
    } > "$state_temporary" &&
        chmod 600 -- "$state_temporary" &&
        mv -f -- "$state_temporary" "$state_file" || return 1
    state_protected=$requested_protection
}

request_session_lock()
{
    loginctl_executable=$(command -v loginctl 2>/dev/null) ||
        fail 'loginctl is unavailable for protected Screensaver exit'
    "$loginctl_executable" lock-session >/dev/null 2>&1 ||
        fail 'could not protect Screensaver exit with session lock'
}

authenticate_protected_exit()
{
    [ "$state_protected" = on ] || return 0
    request_session_lock
    write_loaded_state_protection off ||
        fail 'session lock was requested, but runtime protection state could not be updated'
}

terminate_failed_launch()
{
    [ -n "${launch_pid:-}" ] && [ -n "${launch_start_time:-}" ] || return 0
    process_matches "$launch_pid" "$launch_start_time" \
        "$player_executable" "$selected_effect" || return 0
    kill -TERM "$launch_pid" 2>/dev/null || true

    cleanup_attempt=0
    while [ "$cleanup_attempt" -lt "$stop_attempts" ]; do
        process_matches "$launch_pid" "$launch_start_time" \
            "$player_executable" "$selected_effect" || return 0
        sleep 0.10
        cleanup_attempt=$((cleanup_attempt + 1))
    done
    if process_matches "$launch_pid" "$launch_start_time" \
        "$player_executable" "$selected_effect"; then
        kill -KILL "$launch_pid" 2>/dev/null || true
    fi
}

cleanup_failed_start()
{
    cleanup_status=$1
    trap - 0 HUP INT TERM
    terminate_failed_launch
    rm -f -- "$runtime_dir/$state_name.$$" \
        "$runtime_dir/$cursor_state_name.$$" "${log_temporary:-}" \
        "$state_file" 2>/dev/null || true
    if [ "${cursor_cleanup_required:-false}" = true ]; then
        if load_cursor_state && resolve_hyprctl &&
            set_cursor_invisible "$saved_cursor_invisible"; then
            rm -f -- "$cursor_state_file" 2>/dev/null || true
        else
            printf '%s: could not restore cursor state after failed start\n' \
                "$program_name" >&2
        fi
    fi
    exit "$cleanup_status"
}

start_screensaver()
{
    launch_mode=$1
    prepare_runtime

    if state_path_exists; then
        if owned_process_is_running; then
            [ "$launch_mode" != test ] ||
                fail 'bounded test cannot reuse an active idle screensaver'
            printf 'running (pid %s, effect %s); start is idempotent\n' \
                "$state_pid" "$state_effect"
            return 0
        fi
        restore_cursor_state
        remove_state
    fi
    restore_cursor_state

    require_component_capability
    resolve_effect
    launch_protected=off
    if [ "$launch_mode" = idle ]; then
        idle_executable=$(command -v vanhyprarch-idle 2>/dev/null) ||
            fail 'vanhyprarch-idle is not installed or not on PATH'
        launch_protected=$("$idle_executable" screensaver-resume-lock 2>/dev/null) ||
            fail 'could not determine Screensaver authentication policy'
        case $launch_protected in on|off) ;; *)
            fail 'invalid Screensaver authentication policy' ;;
        esac
    fi
    resolve_player
    setsid_executable=$(command -v setsid 2>/dev/null) ||
        fail 'setsid is not installed or not on PATH'
    resolve_hyprctl || fail 'hyprctl is not installed or not on PATH'
    read_cursor_invisible || fail 'could not read cursor:invisible'

    cursor_cleanup_required=false
    launch_pid=
    launch_start_time=
    trap 'cleanup_failed_start $?' 0
    trap 'cleanup_failed_start 129' HUP
    trap 'cleanup_failed_start 130' INT
    trap 'cleanup_failed_start 143' TERM

    write_cursor_state || fail 'could not record cursor ownership state'
    cursor_cleanup_required=true
    set_cursor_invisible true || fail 'could not hide the cursor'

    validate_runtime_regular "$log_file" 'screensaver log'
    log_temporary=$(mktemp "$runtime_dir/.${log_name}.XXXXXX") ||
        fail "could not stage $log_file"
    chmod 600 -- "$log_temporary" || fail "could not secure $log_temporary"
    mv -f -- "$log_temporary" "$log_file" || fail "could not publish $log_file"
    (
        exec 9>&-
        cd "$runtime_dir" || exit 1
        exec "$setsid_executable" "$player_executable" "$selected_effect"
    ) </dev/null >> "$log_file" 2>&1 &
    launch_pid=$!

    launch_attempt=0
    launch_ready=false
    while [ "$launch_attempt" -lt "$start_attempts" ]; do
        if read_process_snapshot "$launch_pid"; then
            launch_start_time=$snapshot_start_time
            if process_matches "$launch_pid" "$launch_start_time" \
                "$player_executable" "$selected_effect"; then
                launch_ready=true
                break
            fi
        fi
        kill -0 "$launch_pid" 2>/dev/null || break
        sleep "$poll_delay"
        launch_attempt=$((launch_attempt + 1))
    done
    [ "$launch_ready" = true ] ||
        fail "Zig Player did not start; inspect $log_file"
    write_state || fail 'could not record runtime ownership'

    trap - 0 HUP INT TERM
    controller_executable=$(readlink -f -- "$0" 2>/dev/null) ||
        fail 'could not resolve the screensaver controller'
    (
        exec 9>&-
        while process_matches "$launch_pid" "$launch_start_time" \
            "$player_executable" "$selected_effect"; do
            sleep 0.20
        done
        "$controller_executable" recover-exit "$launch_pid" \
            "$launch_start_time" "$player_executable" "$selected_effect" \
            "$launch_protected" || true
    ) </dev/null >/dev/null 2>&1 &
    printf 'started (pid %s, effect %s)\n' "$launch_pid" "$selected_effect"
}

recover_unexpected_exit()
{
    [ "$#" -eq 5 ] || return 2
    recovered_pid=$1
    recovered_start=$2
    recovered_executable=$3
    recovered_effect=$4
    recovered_protected=$5
    prepare_runtime
    load_state || return 0
    [ "$state_pid" = "$recovered_pid" ] &&
        [ "$state_start_time" = "$recovered_start" ] &&
        [ "$state_executable" = "$recovered_executable" ] &&
        [ "$state_effect" = "$recovered_effect" ] &&
        [ "$state_protected" = "$recovered_protected" ] || return 0
    process_matches "$state_pid" "$state_start_time" "$state_executable" \
        "$state_effect" && return 0
    if [ "$state_protected" = on ]; then
        loginctl_executable=$(command -v loginctl 2>/dev/null) || return 1
        "$loginctl_executable" lock-session >/dev/null 2>&1 || return 1
    fi
    remove_state
    rm -f -- "$log_file"
    try_restore_cursor_state
}

resume_lock_screensaver()
{
    prepare_runtime
    if ! state_path_exists; then
        request_session_lock
        return 0
    fi
    if ! load_state; then
        request_session_lock
        fail 'session lock was requested for invalid Screensaver ownership state'
    fi
    authenticate_protected_exit
    if ! process_matches "$state_pid" "$state_start_time" "$state_executable" \
        "$state_effect"; then
        remove_state
        rm -f -- "$log_file"
        try_restore_cursor_state ||
            fail 'session lock was requested, but cursor restoration remains pending'
    fi
}

wait_for_owned_process_to_stop()
{
    wait_attempt=0
    while [ "$wait_attempt" -lt "$stop_attempts" ]; do
        process_matches "$state_pid" "$state_start_time" "$state_executable" \
            "$state_effect" || return 0
        sleep 0.10
        wait_attempt=$((wait_attempt + 1))
    done
    return 1
}

stop_screensaver()
{
    prepare_runtime
    if ! state_path_exists; then
        if cursor_state_path_exists; then
            if ! try_restore_cursor_state; then
                printf '%s: player is stopped but cursor restoration remains pending\n' \
                    "$program_name" >&2
                return 1
            fi
            rm -f -- "$log_file"
            printf 'stopped; restored cursor state\n'
            return 0
        fi
        printf 'stopped; stop is idempotent\n'
        return 0
    fi
    if ! load_state; then
        remove_state
        rm -f -- "$log_file"
        if try_restore_cursor_state; then
            printf 'stopped; removed invalid ownership state\n'
            return 0
        fi
        printf '%s: removed invalid process state; cursor restoration remains pending\n' \
            "$program_name" >&2
        return 1
    fi
    authenticate_protected_exit
    if ! process_matches "$state_pid" "$state_start_time" \
        "$state_executable" "$state_effect"; then
        remove_state
        rm -f -- "$log_file"
        if try_restore_cursor_state; then
            printf 'stopped; removed stale ownership state\n'
            return 0
        fi
        printf '%s: removed stale process state; cursor restoration remains pending\n' \
            "$program_name" >&2
        return 1
    fi

    owned_pid=$state_pid
    kill -TERM "$owned_pid" 2>/dev/null || true
    stopped_message=
    if wait_for_owned_process_to_stop; then
        stopped_message="stopped (pid $owned_pid)"
    else
        if process_matches "$state_pid" "$state_start_time" "$state_executable" \
            "$state_effect"; then
            kill -KILL "$state_pid" 2>/dev/null || true
        fi
        wait_for_owned_process_to_stop ||
            fail "owned screensaver process $owned_pid did not stop"
        stopped_message="stopped forcibly after graceful timeout (pid $owned_pid)"
    fi
    remove_state
    rm -f -- "$log_file"
    if ! try_restore_cursor_state; then
        printf '%s: %s; cursor restoration remains pending\n' \
            "$program_name" "$stopped_message" >&2
        return 1
    fi
    printf '%s\n' "$stopped_message"
}

test_screensaver()
{
    if [ "${VANHYPRARCH_ALLOW_TEST_OVERRIDES:-}" = 1 ] &&
        is_unsigned_integer "${VANHYPRARCH_SCREENSAVER_TEST_SECONDS:-}"; then
        manual_test_seconds=$VANHYPRARCH_SCREENSAVER_TEST_SECONDS
    fi
    start_screensaver test
    trap 'stop_screensaver >/dev/null 2>&1 || true; exit 129' HUP
    trap 'stop_screensaver >/dev/null 2>&1 || true; exit 130' INT
    trap 'stop_screensaver >/dev/null 2>&1 || true; exit 143' TERM
    printf 'bounded manual test: stopping automatically after %s seconds\n' \
        "$manual_test_seconds"
    sleep "$manual_test_seconds"
    trap - HUP INT TERM
    stop_screensaver
}

status_screensaver()
{
    prepare_runtime
    if ! state_path_exists; then
        if cursor_state_path_exists; then
            printf 'stopped; cursor recovery is pending (run stop)\n'
            return 1
        fi
        printf 'stopped\n'
        return 1
    fi
    if ! load_state; then
        printf 'stopped; invalid ownership state (run stop)\n'
        return 1
    fi
    if ! process_matches "$state_pid" "$state_start_time" \
        "$state_executable" "$state_effect"; then
        printf 'stopped; stale ownership state (run stop)\n'
        return 1
    fi
    printf 'running (pid %s, effect %s)\n' "$state_pid" "$state_effect"
}

case ${1-} in
    component-status|component-capability|install|adopt|reinstall|repair|uninstall|uninstall-plan|clean-up)
        component_command "$@"
        ;;
esac

case "$#:$*" in
    '2:start --idle') start_screensaver idle ;;
    '1:resume-lock') resume_lock_screensaver ;;
    '1:test') test_screensaver ;;
    '1:stop') stop_screensaver ;;
    '1:status') status_screensaver ;;
    '1:start') fail 'plain start is intentionally disabled; use start --idle or bounded test' ;;
    *)
        if [ "$#" -eq 6 ] && [ "$1" = recover-exit ]; then
            shift
            recover_unexpected_exit "$@"
            exit $?
        fi
        usage
        exit 2
        ;;
esac
