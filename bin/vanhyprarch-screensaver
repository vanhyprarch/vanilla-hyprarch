#!/bin/sh

set -fu

program_name=${0##*/}
runtime_subdir=vanhyprarch
state_name=screensaver.state
cursor_state_name=screensaver.cursor
lock_name=screensaver.lock
log_name=screensaver.log
start_attempts=40
stop_attempts=30
poll_delay=0.05

usage()
{
    printf 'Usage: %s {start|stop|status}\n' "$program_name" >&2
}

fail()
{
    printf '%s: %s\n' "$program_name" "$*" >&2
    exit 1
}

is_unsigned_integer()
{
    case ${1-} in
        ''|*[!0-9]*) return 1 ;;
        *) return 0 ;;
    esac
}

valid_effect()
{
    case ${1-} in
        colormix|matrix|doom|gameoflife) return 0 ;;
        *) return 1 ;;
    esac
}

prepare_runtime()
{
    [ -n "${XDG_RUNTIME_DIR:-}" ] ||
        fail 'XDG_RUNTIME_DIR is not set'
    case $XDG_RUNTIME_DIR in
        /*) ;;
        *) fail 'XDG_RUNTIME_DIR must be an absolute path' ;;
    esac
    [ -d "$XDG_RUNTIME_DIR" ] ||
        fail 'XDG_RUNTIME_DIR is not a directory'

    runtime_dir=$XDG_RUNTIME_DIR/$runtime_subdir
    umask 077
    [ ! -L "$runtime_dir" ] ||
        fail "$runtime_dir must not be a symbolic link"
    if [ ! -d "$runtime_dir" ]; then
        mkdir -m 700 -- "$runtime_dir" ||
            fail "could not create $runtime_dir"
    fi

    current_uid=$(id -u) || fail 'could not determine the current user ID'
    runtime_owner=$(stat -c '%u' -- "$runtime_dir") ||
        fail "could not inspect $runtime_dir"
    [ "$runtime_owner" = "$current_uid" ] ||
        fail "$runtime_dir is not owned by the current user"
    chmod 700 -- "$runtime_dir" || fail "could not secure $runtime_dir"

    state_file=$runtime_dir/$state_name
    cursor_state_file=$runtime_dir/$cursor_state_name
    lock_file=$runtime_dir/$lock_name
    log_file=$runtime_dir/$log_name

    exec 9>"$lock_file" || fail "could not open $lock_file"
    flock -x 9 || fail "could not lock $lock_file"
}

state_path_exists()
{
    [ -e "$state_file" ] || [ -L "$state_file" ]
}

cursor_state_path_exists()
{
    [ -e "$cursor_state_file" ] || [ -L "$cursor_state_file" ]
}

remove_state()
{
    [ ! -d "$state_file" ] || [ -L "$state_file" ] ||
        fail "$state_file is unexpectedly a directory"
    rm -f -- "$state_file" || fail "could not remove $state_file"
}

remove_cursor_state()
{
    [ ! -d "$cursor_state_file" ] || [ -L "$cursor_state_file" ] ||
        fail "$cursor_state_file is unexpectedly a directory"
    rm -f -- "$cursor_state_file" ||
        fail "could not remove $cursor_state_file"
}

load_state()
{
    [ -f "$state_file" ] || return 1
    [ ! -L "$state_file" ] || return 1
    [ "$(stat -c '%u' -- "$state_file" 2>/dev/null)" = "$current_uid" ] ||
        return 1

    state_version=
    state_pid=
    state_start_time=
    state_executable=
    state_effect=
    seen_version=false
    seen_pid=false
    seen_start_time=false
    seen_executable=false
    seen_effect=false

    while IFS= read -r state_line || [ -n "$state_line" ]; do
        state_key=${state_line%%=*}
        state_value=${state_line#*=}
        [ "$state_key" != "$state_line" ] || return 1
        case $state_key in
            version)
                [ "$seen_version" = false ] || return 1
                seen_version=true
                state_version=$state_value
                ;;
            pid)
                [ "$seen_pid" = false ] || return 1
                seen_pid=true
                state_pid=$state_value
                ;;
            start_time)
                [ "$seen_start_time" = false ] || return 1
                seen_start_time=true
                state_start_time=$state_value
                ;;
            executable)
                [ "$seen_executable" = false ] || return 1
                seen_executable=true
                state_executable=$state_value
                ;;
            effect)
                [ "$seen_effect" = false ] || return 1
                seen_effect=true
                state_effect=$state_value
                ;;
            *) return 1 ;;
        esac
    done < "$state_file"

    [ "$seen_version" = true ] && [ "$state_version" = 1 ] &&
        [ "$seen_pid" = true ] && [ "$seen_start_time" = true ] &&
        [ "$seen_executable" = true ] && [ "$seen_effect" = true ] ||
        return 1
    is_unsigned_integer "$state_pid" && [ "$state_pid" -gt 1 ] || return 1
    is_unsigned_integer "$state_start_time" || return 1
    case $state_executable in /*) ;; *) return 1 ;; esac
    valid_effect "$state_effect"
}

load_cursor_state()
{
    [ -f "$cursor_state_file" ] || return 1
    [ ! -L "$cursor_state_file" ] || return 1
    [ "$(stat -c '%u' -- "$cursor_state_file" 2>/dev/null)" = "$current_uid" ] ||
        return 1

    saved_cursor_invisible=
    cursor_state_extra=
    {
        IFS= read -r saved_cursor_invisible || return 1
        if IFS= read -r cursor_state_extra || [ -n "$cursor_state_extra" ]; then
            return 1
        fi
    } < "$cursor_state_file"
    case $saved_cursor_invisible in true|false) ;; *) return 1 ;; esac
}

read_process_snapshot()
{
    snapshot_pid=$1
    [ -r "/proc/$snapshot_pid/stat" ] || return 1
    IFS= read -r process_stat < "/proc/$snapshot_pid/stat" || return 1
    process_tail=${process_stat##*) }
    [ "$process_tail" != "$process_stat" ] || return 1
    set -- $process_tail
    [ "$#" -ge 20 ] || return 1
    snapshot_state=$1
    snapshot_start_time=${20}
    case $snapshot_state in Z|X|x) return 1 ;; esac
    is_unsigned_integer "$snapshot_start_time"
}

process_arguments_match()
{
    argument_pid=$1
    argument_executable=$2
    argument_effect=$3
    [ -r "/proc/$argument_pid/cmdline" ] || return 1
    argument_count=$(tr '\000' '\n' < "/proc/$argument_pid/cmdline" |
        wc -l) || return 1
    [ "$argument_count" -eq 2 ] || return 1
    argument_zero=$(tr '\000' '\n' < "/proc/$argument_pid/cmdline" |
        sed -n '1p') || return 1
    argument_one=$(tr '\000' '\n' < "/proc/$argument_pid/cmdline" |
        sed -n '2p') || return 1
    [ "$argument_zero" = "$argument_executable" ] &&
        [ "$argument_one" = "$argument_effect" ]
}

process_matches()
{
    inspected_pid=$1
    expected_start_time=$2
    expected_executable=$3
    expected_effect=$4
    [ "$(stat -c '%u' -- "/proc/$inspected_pid" 2>/dev/null)" = "$current_uid" ] ||
        return 1
    read_process_snapshot "$inspected_pid" || return 1
    [ "$snapshot_start_time" = "$expected_start_time" ] || return 1
    observed_executable=$(readlink "/proc/$inspected_pid/exe" 2>/dev/null) ||
        return 1
    [ "$observed_executable" = "$expected_executable" ] || return 1
    process_arguments_match "$inspected_pid" "$expected_executable" \
        "$expected_effect"
}

owned_process_is_running()
{
    load_state || return 1
    process_matches "$state_pid" "$state_start_time" "$state_executable" \
        "$state_effect"
}

resolve_hyprctl()
{
    hyprctl_executable=$(command -v hyprctl 2>/dev/null) || return 1
}

read_cursor_invisible()
{
    cursor_invisible=$(
        "$hyprctl_executable" getoption cursor:invisible 2>/dev/null |
            sed -n 's/^bool: //p'
    ) || return 1
    case $cursor_invisible in true|false) ;; *) return 1 ;; esac
}

set_cursor_invisible()
{
    requested_cursor_invisible=$1
    case $requested_cursor_invisible in true|false) ;; *) return 1 ;; esac
    "$hyprctl_executable" eval \
        "hl.config({ cursor = { invisible = $requested_cursor_invisible } })" \
        >/dev/null 2>&1 || return 1
    read_cursor_invisible || return 1
    [ "$cursor_invisible" = "$requested_cursor_invisible" ]
}

write_cursor_state()
{
    cursor_state_temporary=$runtime_dir/$cursor_state_name.$$
    rm -f -- "$cursor_state_temporary" || return 1
    printf '%s\n' "$cursor_invisible" > "$cursor_state_temporary" &&
        chmod 600 -- "$cursor_state_temporary" &&
        mv -f -- "$cursor_state_temporary" "$cursor_state_file"
}

restore_cursor_state()
{
    cursor_state_path_exists || return 0
    load_cursor_state ||
        fail "invalid cursor ownership state in $cursor_state_file"
    resolve_hyprctl || fail 'hyprctl is not installed or not on PATH'
    set_cursor_invisible "$saved_cursor_invisible" ||
        fail "could not restore cursor:invisible=$saved_cursor_invisible"
    remove_cursor_state
}

resolve_effect()
{
    idle_executable=$(command -v vanhyprarch-idle 2>/dev/null) ||
        fail 'vanhyprarch-idle is not installed or not on PATH'
    selected_effect=$("$idle_executable" screensaver-effect 2>/dev/null) ||
        fail 'could not read the configured screensaver effect'
    valid_effect "$selected_effect" ||
        fail "invalid configured screensaver effect: $selected_effect"
}

resolve_player()
{
    player_command=$(command -v vanhyprarch-zig-player 2>/dev/null) ||
        fail 'vanhyprarch-zig-player is not installed or not on PATH'
    player_executable=$(readlink -f -- "$player_command" 2>/dev/null) ||
        fail 'could not resolve vanhyprarch-zig-player'
    [ -f "$player_executable" ] && [ -x "$player_executable" ] ||
        fail "$player_executable is not an executable regular file"
}

write_state()
{
    state_temporary=$runtime_dir/$state_name.$$
    rm -f -- "$state_temporary" || return 1
    {
        printf 'version=1\n'
        printf 'pid=%s\n' "$launch_pid"
        printf 'start_time=%s\n' "$launch_start_time"
        printf 'executable=%s\n' "$player_executable"
        printf 'effect=%s\n' "$selected_effect"
    } > "$state_temporary" &&
        chmod 600 -- "$state_temporary" &&
        mv -f -- "$state_temporary" "$state_file"
}

terminate_failed_launch()
{
    [ -n "${launch_pid:-}" ] && [ -n "${launch_start_time:-}" ] || return 0
    process_matches "$launch_pid" "$launch_start_time" \
        "$player_executable" "$selected_effect" || return 0
    kill -TERM "$launch_pid" 2>/dev/null || true

    cleanup_attempt=0
    while [ "$cleanup_attempt" -lt "$stop_attempts" ]; do
        process_matches "$launch_pid" "$launch_start_time" \
            "$player_executable" "$selected_effect" || return 0
        sleep 0.10
        cleanup_attempt=$((cleanup_attempt + 1))
    done
    if process_matches "$launch_pid" "$launch_start_time" \
        "$player_executable" "$selected_effect"; then
        kill -KILL "$launch_pid" 2>/dev/null || true
    fi
}

cleanup_failed_start()
{
    cleanup_status=$1
    trap - 0 HUP INT TERM
    terminate_failed_launch
    rm -f -- "$runtime_dir/$state_name.$$" \
        "$runtime_dir/$cursor_state_name.$$" "$state_file" 2>/dev/null || true
    if [ "${cursor_cleanup_required:-false}" = true ]; then
        if load_cursor_state && resolve_hyprctl &&
            set_cursor_invisible "$saved_cursor_invisible"; then
            rm -f -- "$cursor_state_file" 2>/dev/null || true
        else
            printf '%s: could not restore cursor state after failed start\n' \
                "$program_name" >&2
        fi
    fi
    exit "$cleanup_status"
}

start_screensaver()
{
    prepare_runtime

    if state_path_exists; then
        if owned_process_is_running; then
            printf 'running (pid %s, effect %s); start is idempotent\n' \
                "$state_pid" "$state_effect"
            return 0
        fi
        restore_cursor_state
        remove_state
    fi
    restore_cursor_state

    resolve_effect
    resolve_player
    setsid_executable=$(command -v setsid 2>/dev/null) ||
        fail 'setsid is not installed or not on PATH'
    resolve_hyprctl || fail 'hyprctl is not installed or not on PATH'
    read_cursor_invisible || fail 'could not read cursor:invisible'

    cursor_cleanup_required=false
    launch_pid=
    launch_start_time=
    trap 'cleanup_failed_start $?' 0
    trap 'cleanup_failed_start 129' HUP
    trap 'cleanup_failed_start 130' INT
    trap 'cleanup_failed_start 143' TERM

    write_cursor_state || fail 'could not record cursor ownership state'
    cursor_cleanup_required=true
    set_cursor_invisible true || fail 'could not hide the cursor'

    : > "$log_file" || fail "could not create $log_file"
    chmod 600 -- "$log_file" || fail "could not secure $log_file"
    (
        exec 9>&-
        cd "$runtime_dir" || exit 1
        exec "$setsid_executable" "$player_executable" "$selected_effect"
    ) </dev/null >> "$log_file" 2>&1 &
    launch_pid=$!

    launch_attempt=0
    launch_ready=false
    while [ "$launch_attempt" -lt "$start_attempts" ]; do
        if read_process_snapshot "$launch_pid"; then
            launch_start_time=$snapshot_start_time
            if process_matches "$launch_pid" "$launch_start_time" \
                "$player_executable" "$selected_effect"; then
                launch_ready=true
                break
            fi
        fi
        kill -0 "$launch_pid" 2>/dev/null || break
        sleep "$poll_delay"
        launch_attempt=$((launch_attempt + 1))
    done
    [ "$launch_ready" = true ] ||
        fail "Zig Player did not start; inspect $log_file"
    write_state || fail 'could not record runtime ownership'

    trap - 0 HUP INT TERM
    printf 'started (pid %s, effect %s)\n' "$launch_pid" "$selected_effect"
}

wait_for_owned_process_to_stop()
{
    wait_attempt=0
    while [ "$wait_attempt" -lt "$stop_attempts" ]; do
        process_matches "$state_pid" "$state_start_time" "$state_executable" \
            "$state_effect" || return 0
        sleep 0.10
        wait_attempt=$((wait_attempt + 1))
    done
    return 1
}

stop_screensaver()
{
    prepare_runtime
    if ! state_path_exists; then
        if cursor_state_path_exists; then
            restore_cursor_state
            rm -f -- "$log_file"
            printf 'stopped; restored cursor state\n'
            return 0
        fi
        printf 'stopped; stop is idempotent\n'
        return 0
    fi
    if ! load_state; then
        restore_cursor_state
        remove_state
        rm -f -- "$log_file"
        printf 'stopped; removed invalid ownership state\n'
        return 0
    fi
    if ! process_matches "$state_pid" "$state_start_time" \
        "$state_executable" "$state_effect"; then
        restore_cursor_state
        remove_state
        rm -f -- "$log_file"
        printf 'stopped; removed stale ownership state\n'
        return 0
    fi

    owned_pid=$state_pid
    kill -TERM "$owned_pid" 2>/dev/null || true
    restore_cursor_state
    if wait_for_owned_process_to_stop; then
        remove_state
        rm -f -- "$log_file"
        printf 'stopped (pid %s)\n' "$owned_pid"
        return 0
    fi

    if process_matches "$state_pid" "$state_start_time" "$state_executable" \
        "$state_effect"; then
        kill -KILL "$state_pid" 2>/dev/null || true
    fi
    if wait_for_owned_process_to_stop; then
        remove_state
        rm -f -- "$log_file"
        printf 'stopped forcibly after graceful timeout (pid %s)\n' \
            "$owned_pid"
        return 0
    fi
    fail "owned screensaver process $owned_pid did not stop"
}

status_screensaver()
{
    prepare_runtime
    if ! state_path_exists; then
        if cursor_state_path_exists; then
            printf 'stopped; cursor recovery is pending (run stop)\n'
            return 1
        fi
        printf 'stopped\n'
        return 1
    fi
    if ! load_state; then
        printf 'stopped; invalid ownership state (run stop)\n'
        return 1
    fi
    if ! process_matches "$state_pid" "$state_start_time" \
        "$state_executable" "$state_effect"; then
        printf 'stopped; stale ownership state (run stop)\n'
        return 1
    fi
    printf 'running (pid %s, effect %s)\n' "$state_pid" "$state_effect"
}

[ "$#" -eq 1 ] || {
    usage
    exit 2
}

case $1 in
    start) start_screensaver ;;
    stop) stop_screensaver ;;
    status) status_screensaver ;;
    *)
        usage
        exit 2
        ;;
esac
